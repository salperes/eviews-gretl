# ===================================================================
# EViewsCompat: EViews-style estimation, tests and functions for gretl
# ===================================================================
# Note: the at-sign is a string-substitution operator in hansl, so this
# file never writes it literally; it is built as string AT where needed.

# -------------------------------------------------------------------
# Private helpers
# -------------------------------------------------------------------

function string ev__expand_diff (string s)
    # d(Y), d(Y(-k)), dlog(Y), dlog(Y(-k)), d(log(Y)), d(log(Y(-k))) written with
    # explicit lags, so that the first observation of the sample uses pre-sample
    # data, as EViews does (gretl's diff/ldiff of a lagged series would give NA)
    string e = s
    string N = "([A-Za-z_][A-Za-z0-9_]*)"
    loop k = 0..24
        string lk = k ? sprintf("\(\s*-\s*%d\s*\)", k) : ""
        string a = k ? sprintf("(-%d)", k) : ""
        string b2 = sprintf("(-%d)", k + 1)
        e = regsub(e, "(?i)(?<![A-Za-z0-9_.])dlog\(\s*" ~ N ~ "\s*" ~ lk ~ "\s*\)", "(log(\1" ~ a ~ ")-log(\1" ~ b2 ~ "))")
        e = regsub(e, "(?i)(?<![A-Za-z0-9_.])d\(\s*log\(\s*" ~ N ~ "\s*" ~ lk ~ "\s*\)\s*\)", "(log(\1" ~ a ~ ")-log(\1" ~ b2 ~ "))")
        e = regsub(e, "(?i)(?<![A-Za-z0-9_.])d\(\s*" ~ N ~ "\s*" ~ lk ~ "\s*\)", "(\1" ~ a ~ "-\1" ~ b2 ~ ")")
    endloop
    return e
end function

function string ev__translate (string s)
    # Rewrite an EViews expression into hansl syntax.
    string AT = "@"
    string e = ev__expand_diff(s)
    # EViews function names -> hansl / package equivalents
    e = regsub(e, "(?i)\bdlog\(", "ldiff(")
    e = regsub(e, "(?i)\bd\(", "diff(")
    e = regsub(e, "(?i)\blog\(", "log(")
    e = regsub(e, "(?i)\bexp\(", "exp(")
    e = regsub(e, "(?i)\babs\(", "abs(")
    e = regsub(e, "(?i)\bsqr\(", "sqrt(")
    # EViews at-functions
    e = regsub(e, "(?i)" ~ AT ~ "trend(\(\))?", "(obs-1)")
    e = regsub(e, "(?i)" ~ AT ~ "seas\(", "ev_seas(")
    e = regsub(e, "(?i)" ~ AT ~ "pchy\(", "ev_pchy(")
    e = regsub(e, "(?i)" ~ AT ~ "pcy\(", "ev_pcy(")
    e = regsub(e, "(?i)" ~ AT ~ "pch\(", "ev_pch(")
    e = regsub(e, "(?i)" ~ AT ~ "pc\(", "ev_pc(")
    e = regsub(e, "(?i)" ~ AT ~ "movav\(", "ev_movav(")
    e = regsub(e, "(?i)" ~ AT ~ "movsum\(", "ev_movsum(")
    e = regsub(e, "(?i)" ~ AT ~ "cumsum\(", "cum(")
    e = regsub(e, "(?i)" ~ AT ~ "mean\(", "ev_mean(")
    e = regsub(e, "(?i)" ~ AT ~ "stdev\(", "ev_stdev(")
    e = regsub(e, "(?i)" ~ AT ~ "abs\(", "abs(")
    e = regsub(e, "(?i)" ~ AT ~ "log\(", "log(")
    errorif(instring(e, AT), sprintf("Unsupported EViews function in '%s'", s))
    return e
end function

function scalar ev__fit (const matrix y, const matrix Z, scalar *ssr,
                         scalar *df)
    # Least squares via generalized inverse (safe if Z is rank-deficient).
    # Returns centered R-squared; fills SSR and rank(Z).
    matrix e = y - Z * (ginv(Z'Z) * (Z'y))
    ssr = e'e
    df = rank(Z)
    matrix d = y - meanc(y)
    return 1 - ssr / (d'd)
end function

function void ev__line (int n[1::78])
    string s = ""
    loop n
        s ~= "="
    endloop
    printf "%s\n", s
end function

# -------------------------------------------------------------------
# Expression evaluation (EViews syntax -> series)
# -------------------------------------------------------------------

function string ev__prep (string expr, list vars)
    # EViews expression -> hansl expression in which dataset series are vars.NAME
    string evx_e = ev__translate(expr)
    strings evx_nms = varnames(vars)
    strings evx_ids = strsplit(regsub(evx_e, "[^A-Za-z0-9_]+", " "))
    # Refer to each series as vars.NAME rather than copying it: a copy made
    # inside a function holds only in-sample values, while vars.NAME(-k)
    # can reach pre-sample observations, as gretl and EViews do for lags.
    strings evx_done = array(0)
    loop evx_j = 1..nelem(evx_ids)
        string evx_id = evx_ids[evx_j]
        if rows(instrings(evx_nms, evx_id)) > 0 && rows(instrings(evx_done, evx_id)) == 0
            evx_e = regsub(evx_e, "(?<![A-Za-z0-9_.])" ~ evx_id ~ "(?![A-Za-z0-9_])", "vars." ~ evx_id)
            evx_done += evx_id
        endif
    endloop
    return evx_e
end function

function series ev__gen2 (string expr, list vars, string base, series dlt)
    # like ev_gen, but the dataset series called base is shifted by dlt
    # (forecast minus actual; zero before the sample), lags included
    string evx_e = ev__prep(expr, vars)
    evx_e = regsub(evx_e, "vars\." ~ base ~ "(\(-?[0-9]+\))?(?![A-Za-z0-9_])", "(vars." ~ base ~ "\1 + misszero(dlt\1))")
    series evx_out = @evx_e
    return evx_out
end function

function series ev_gen (string expr "EViews expression, e.g. dlog(y)",
                        list vars "Series referenced in the expression")
    # Evaluate an EViews-syntax expression and return the series.
    string evx_e = ev__prep(expr, vars)
    if instring(evx_e, "ev_")
        # expression calls package functions: catch is not allowed here
        series evx_out = @evx_e
    else
        catch series evx_out = @evx_e
    endif
    errorif($error, sprintf("Cannot evaluate '%s' (hansl: %s). Check the series names and that they are in the list you passed.", expr, evx_e))
    return evx_out
end function

# -------------------------------------------------------------------
# Least squares, EViews style
# -------------------------------------------------------------------

function bundle ev_ls (string spec "Equation, e.g. y c x x(-1)",
                       list vars[null] "Series used (e.g. dataset)",
                       string cov[null] "ordinary, white or hac",
                       bool quiet[0] "Suppress printed output")
    errorif(!exists(vars), "Pass the series to use as second argument, e.g. ev_ls(\"y c x\", dataset)")
    string evx_cov = exists(cov) ? tolower(cov) : "ordinary"
    # explicit form y = c(1) + c(2)*x  -> nonlinear least squares
    if instring(spec, "=")
        return ev_nls(spec, vars, evx_cov, quiet)
    endif
    # ARMA error terms ar(k) / ma(k) -> regression with ARMA errors (exact ML)
    if regsub(tolower(" " ~ spec ~ " "), ".*\s(ar|ma)\([0-9]+\)\s.*", "ARMA") == "ARMA"
        return ev_arma(spec, vars, quiet)
    endif
    errorif(!instring(" ordinary white hac ", " " ~ evx_cov ~ " "), "cov must be ordinary, white or hac")
    strings evx_tok = strsplit(spec)
    errorif(nelem(evx_tok) < 2, "The specification needs a dependent variable and at least one regressor")

    series evx_y = ev_gen(evx_tok[1], vars)
    list evx_X = null
    strings evx_lab = array(0)
    scalar evx_hascon = 0
    loop evx_i = 2..nelem(evx_tok)
        string evx_t = evx_tok[evx_i]
        if tolower(evx_t) == "c"
            list evx_X += const
            evx_lab += "C"
            evx_hascon = 1
        else
            string evx_v = sprintf("evx_r%d", evx_i)
            series @evx_v = ev_gen(evx_t, vars)
            list evx_X += @evx_v
            evx_lab += toupper(evx_t)
        endif
    endloop

    scalar evx_n0 = $nobs
    if evx_cov == "white"
        set force_hc on
        ols evx_y evx_X --robust --quiet
    elif evx_cov == "hac"
        errorif($datatype != 2, "HAC covariance needs time-series data")
        ols evx_y evx_X --robust --quiet
    else
        ols evx_y evx_X --quiet
    endif

    bundle b
    b.spec = spec
    b.depvar = toupper(evx_tok[1])
    b.labels = evx_lab
    b.covtype = evx_cov
    b.coeff = $coeff
    b.stderr = $stderr
    b.vcv = $vcv
    b.T = $T
    b.k = $ncoeff
    b.rsq = $rsq
    b.adjrsq = 1 - (1 - $rsq) * ($T - 1) / ($T - $ncoeff)
    b.sigma = $sigma
    b.ssr = $ess
    b.lnl = $lnl
    catch scalar dwv = $dw          # not defined for undated (cross-section) data
    if $error
        dwv = NA
    endif
    b.dw = dwv
    b.hascon = evx_hascon
    b.adjusted = $T < evx_n0
    b.estdate = strftime($now[1], "%m/%d/%y   Time: %H:%M")

    series evx_u = $uhat
    series evx_f = $yhat
    smpl ok(evx_u) --restrict
    b.y = {evx_y}
    b.X = {evx_X}
    b.uhat = {evx_u}
    b.yhat = {evx_f}
    series evx_o = obs
    b.tobs = {evx_o}
    b.sample =sprintf("%s %s", obslabel($t1), obslabel($t2))

    scalar n = b.T
    scalar k = b.k
    matrix d = b.y - meanc(b.y)
    b.meany = meanc(b.y)
    b.sdy = sqrt(d'd / (n - 1))
    b.aic = -2 * b.lnl / n + 2 * k / n
    b.sc = -2 * b.lnl / n + k * log(n) / n
    b.hq = -2 * b.lnl / n + 2 * k * log(log(n)) / n
    if evx_hascon && k > 1
        b.F = (b.rsq / (k - 1)) / ((1 - b.rsq) / (n - k))
        b.Fp = pvalue(F, k - 1, n - k, b.F)
    else
        b.F = NA
        b.Fp = NA
    endif
    b.tstat = b.coeff ./ b.stderr
    matrix p = zeros(k, 1)
    loop i = 1..k
        p[i] = 2 * pvalue(t, n - k, abs(b.tstat[i]))
    endloop
    b.pval = p

    if !quiet
        ev_print(&b)
    endif
    return b
end function

function void ev_print (bundle *b)
    errorif(!inbundle(b, "coeff"), "Not an ev_ls result")
    printf "\nDependent Variable: %s\n", b.depvar
    printf "Method: %s\n", inbundle(b, "method") ? b.method : "Least Squares"
    printf "Date: %s\n", b.estdate
    printf "Sample%s: %s\n", b.adjusted ? " (adjusted)" : "", b.sample
    printf "Included observations: %d%s\n", b.T, b.adjusted ? " after adjustments" : ""
    if b.covtype == "white"
        printf "White heteroskedasticity-consistent standard errors & covariance\n"
    elif b.covtype == "hac"
        printf "HAC standard errors & covariance (Bartlett kernel, Newey-West)\n"
    endif
    if inbundle(b, "eqline")
        printf "%s\n", b.eqline
    endif
    printf "\n"
    ev__line(78)
    printf "%-26s%13s%13s%14s%12s\n", "Variable", "Coefficient", "Std. Error", "t-Statistic", "Prob."
    ev__line(78)
    matrix ord = inbundle(b, "order") ? b.order : seq(1, b.k)
    loop r = 1..cols(ord)
        scalar i = ord[r]
        printf "%-26s%13.6f%13.6f%14.6f%12.4f\n", b.labels[i], b.coeff[i], b.stderr[i], b.tstat[i], b.pval[i]
    endloop
    if inbundle(b, "sigmasq")
        printf "%-26s%13.6f%13.6f%14.6f%12.4f\n", "SIGMASQ", b.sigmasq, b.sigmasq_se, b.sigmasq / b.sigmasq_se, 2 * pvalue(t, b.T - b.k, abs(b.sigmasq / b.sigmasq_se))
    endif
    ev__line(78)
    if inbundle(b, "iv")
        # instrumental variables: no likelihood-based statistics (as EViews)
        printf "%-22s%14.6f    %-24s%14.6f\n", "R-squared", b.rsq, "Mean dependent var", b.meany
        printf "%-22s%14.6f    %-24s%14.6f\n", "Adjusted R-squared", b.adjrsq, "S.D. dependent var", b.sdy
        printf "%-22s%14.6f    %-24s%14.6f\n", "S.E. of regression", b.sigma, "Sum squared resid", b.ssr
        printf "%-22s%14.6f    %-24s%14.6f\n", "Durbin-Watson stat", b.dw, "J-statistic", b.J
        printf "%-22s%14d    %-24s%14.6f\n", "Instrument rank", b.instrank, "Prob(J-statistic)", b.Jp
        ev__line(78)
        return
    endif
    printf "%-22s%14.6f    %-24s%14.6f\n", "R-squared", b.rsq, "Mean dependent var", b.meany
    printf "%-22s%14.6f    %-24s%14.6f\n", "Adjusted R-squared", b.adjrsq, "S.D. dependent var", b.sdy
    printf "%-22s%14.6f    %-24s%14.6f\n", "S.E. of regression", b.sigma, "Akaike info criterion", b.aic
    printf "%-22s%14.6f    %-24s%14.6f\n", "Sum squared resid", b.ssr, "Schwarz criterion", b.sc
    printf "%-22s%14.6f    %-24s%14.6f\n", "Log likelihood", b.lnl, "Hannan-Quinn criter.", b.hq
    if ok(b.F)
        printf "%-22s%14.6f    %-24s%14.6f\n", "F-statistic", b.F, "Durbin-Watson stat", b.dw
        printf "%-22s%14.6f\n", "Prob(F-statistic)", b.Fp
    else
        printf "%-22s%14s    %-24s%14.6f\n", "", "", "Durbin-Watson stat", b.dw
    endif
    ev__line(78)
    if inbundle(b, "ar_roots")
        printf "%-22s%s\n", "Inverted AR Roots", b.ar_roots
    endif
    if inbundle(b, "ma_roots")
        printf "%-22s%s\n", "Inverted MA Roots", b.ma_roots
    endif
    if inbundle(b, "ar_roots") || inbundle(b, "ma_roots")
        ev__line(78)
    endif
end function

function void ev_plot (bundle *b)
    # EViews View > Actual, Fitted, Residual
    errorif(!inbundle(b, "uhat"), "Not an ev_ls result")
    matrix M = b.y ~ b.yhat ~ b.uhat
    cnameset(M, defarray("Actual", "Fitted", "Residual"))
    gnuplot 1 2 3 --matrix=M --time-series --with-lines --y2axis=3 --output=display \
      {set title "Actual, Fitted, Residual"; set ylabel "Actual / Fitted"; set y2label "Residual";}
end function

# -------------------------------------------------------------------
# Wald coefficient restrictions:  "c(2)=0, c(3)=c(4)"
# -------------------------------------------------------------------

function bundle ev_wald (bundle b "ev_ls result",
                         string restr "Restrictions, e.g. c(2)=0, c(3)=0",
                         bool quiet[0])
    errorif(!inbundle(b, "coeff"), "First argument must be an ev_ls result")
    strings R = strsplit(restr, ",")
    scalar J = nelem(R)
    scalar k = b.k
    scalar n = b.T
    matrix Rm = zeros(J, k)
    matrix q = zeros(J, 1)
    # coefficient numbers: c(i) is the i-th coefficient, except in systems
    # where the numbers used may have gaps
    matrix cpos = inbundle(b, "cnums") ? b.cnums : seq(1, k)
    scalar K = maxr(cpos)
    matrix evw_c = zeros(K, 1)
    loop j = 1..J
        strings sides = strsplit(R[j], "=")
        errorif(nelem(sides) != 2, sprintf("Restriction '%s' must contain exactly one '='", R[j]))
        string ex = sprintf("(%s)-(%s)", sides[1], sides[2])
        ex = regsub(ex, "(?i)\bc\(([0-9]+)\)", "evw_c[\1]")
        matrix idx = {}
        evw_c = zeros(K, 1)
        catch scalar f0 = @ex
        errorif($error, sprintf("Cannot parse restriction '%s' (coefficients are c(1)..c(%d))", R[j], k))
        loop i = 1..k
            evw_c = zeros(K, 1)
            evw_c[cpos[i]] = 1
            Rm[j, i] = (@ex) - f0
        endloop
        # linearity check at a random point
        matrix rc = mnormal(k, 1)
        evw_c = zeros(K, 1)
        evw_c[cpos] = rc
        errorif(abs((@ex) - (Rm[j,] * rc + f0)) > 1e-8 * (1 + abs(f0)), sprintf("Restriction '%s' is not linear", R[j]))
        q[j] = -f0
    endloop
    matrix dev = Rm * b.coeff - q
    scalar W = qform(dev', inv(qform(Rm, b.vcv)))
    bundle w
    w.restr = restr
    w.chi2 = W
    w.chi2p = pvalue(X, J, W)
    w.F = W / J
    w.Fp = pvalue(F, J, n - k, w.F)
    w.df1 = J
    w.df2 = n - k
    w.R = Rm
    w.q = q
    if !quiet
        printf "\nWald Test:\nEquation: %s\n\n", b.spec
        printf "%-20s%14s%14s%14s\n", "Test Statistic", "Value", "df", "Probability"
        printf "%-20s%14.6f%14s%14.4f\n", "F-statistic", w.F, sprintf("(%d, %d)", J, n - k), w.Fp
        printf "%-20s%14.6f%14d%14.4f\n", "Chi-square", w.chi2, J, w.chi2p
        printf "\nNull Hypothesis: %s\n\n", toupper(restr)
    endif
    return w
end function

# -------------------------------------------------------------------
# Residual diagnostics (View > Residual Diagnostics)
# -------------------------------------------------------------------

function bundle ev_diag (bundle b "ev_ls result",
                         int nlags[1::2] "Serial correlation LM nlags",
                         bool quiet[0])
    errorif(!inbundle(b, "uhat"), "First argument must be an ev_ls result")
    matrix u = b.uhat
    matrix Xm = b.X
    scalar n = rows(u)
    scalar k = cols(Xm)
    bundle r

    # Jarque-Bera
    matrix uc = u - meanc(u)
    scalar m2 = meanc(uc.^2)
    r.skew = meanc(uc.^3) / m2^1.5
    r.kurt = meanc(uc.^4) / m2^2
    r.jb = n / 6 * (r.skew^2 + (r.kurt - 3)^2 / 4)
    r.jbp = pvalue(X, 2, r.jb)

    # Breusch-Godfrey (presample residuals set to zero, as EViews)
    matrix UL = zeros(n, nlags)
    loop j = 1..nlags
        UL[j+1:n, j] = u[1:n-j]
    endloop
    scalar ssr0 = 0
    scalar df0 = 0
    scalar ssr1 = 0
    scalar df1 = 0
    scalar r2 = ev__fit(u, Xm ~ UL, &ssr1, &df1)
    ev__fit(u, Xm, &ssr0, &df0)
    r.bg_lags = nlags
    r.bg_obsr2 = n * r2
    r.bg_chi2p = pvalue(X, nlags, r.bg_obsr2)
    r.bg_F = ((ssr0 - ssr1) / nlags) / (ssr1 / (n - df1))
    r.bg_Fp = pvalue(F, nlags, n - df1, r.bg_F)

    # White test with cross terms
    matrix nc = selifc(Xm, sdc(Xm) .> 1e-12)
    matrix Z = ones(n, 1) ~ nc
    loop i = 1..cols(nc)
        loop j = i..cols(nc)
            Z ~= nc[,i] .* nc[,j]
        endloop
    endloop
    scalar ssrw = 0
    scalar dfw = 0
    scalar r2w = ev__fit(u.^2, Z, &ssrw, &dfw)
    scalar m = dfw - 1
    r.white_obsr2 = n * r2w
    r.white_df = m
    r.white_chi2p = pvalue(X, m, r.white_obsr2)
    r.white_F = (r2w / m) / ((1 - r2w) / (n - dfw))
    r.white_Fp = pvalue(F, m, n - dfw, r.white_F)

    if !quiet
        printf "\nResidual Diagnostics\nEquation: %s\n", b.spec
        ev__line(70)
        printf "Normality: Jarque-Bera\n"
        printf "  %-26s%12.6f    Prob.%21.4f\n", "Jarque-Bera", r.jb, r.jbp
        printf "  %-26s%12.6f    %-14s%12.6f\n", "Skewness", r.skew, "Kurtosis", r.kurt
        ev__line(70)
        printf "Breusch-Godfrey Serial Correlation LM Test (%d lags)\n", nlags
        printf "  %-26s%12.6f    %-18s%8.4f\n", "F-statistic", r.bg_F, sprintf("Prob. F(%d,%d)", nlags, n - df1), r.bg_Fp
        printf "  %-26s%12.6f    %-18s%8.4f\n", "Obs*R-squared", r.bg_obsr2, sprintf("Prob. Chi-Square(%d)", nlags), r.bg_chi2p
        ev__line(70)
        printf "Heteroskedasticity Test: White (with cross terms)\n"
        printf "  %-26s%12.6f    %-18s%8.4f\n", "F-statistic", r.white_F, sprintf("Prob. F(%d,%d)", m, n - dfw), r.white_Fp
        printf "  %-26s%12.6f    %-18s%8.4f\n", "Obs*R-squared", r.white_obsr2, sprintf("Prob. Chi-Square(%d)", m), r.white_chi2p
        ev__line(70)
    endif
    return r
end function

# -------------------------------------------------------------------
# Freeze: save the estimation table to a file
# -------------------------------------------------------------------

function void ev_freeze (bundle b "ev_ls result",
                         string fname "Output file: .txt, .csv, .tex or .html")
    errorif(!inbundle(b, "coeff"), "First argument must be an ev_ls result")
    string ext = tolower(regsub(fname, ".*\.", ""))
    if ext == "txt"
        outfile @fname --quiet
            ev_print(&b)
        end outfile
    elif ext == "csv"
        outfile @fname --quiet
            printf "Variable,Coefficient,Std. Error,t-Statistic,Prob.\n"
            loop i = 1..b.k
                printf "\"%s\",%.10g,%.10g,%.10g,%.10g\n", b.labels[i], b.coeff[i], b.stderr[i], b.tstat[i], b.pval[i]
            endloop
            printf "\nR-squared,%.10g\nAdjusted R-squared,%.10g\nS.E. of regression,%.10g\n", b.rsq, b.adjrsq, b.sigma
            printf "Sum squared resid,%.10g\nLog likelihood,%.10g\nDurbin-Watson stat,%.10g\n", b.ssr, b.lnl, b.dw
            printf "Akaike info criterion,%.10g\nSchwarz criterion,%.10g\nIncluded observations,%d\n", b.aic, b.sc, b.T
        end outfile
    elif ext == "tex"
        outfile @fname --quiet
            printf "\\begin{tabular}{lrrrr}\n\\hline\n"
            printf "Variable & Coefficient & Std. Error & t-Statistic & Prob. \\\\\n\\hline\n"
            loop i = 1..b.k
                printf "%s & %.6f & %.6f & %.4f & %.4f \\\\\n", b.labels[i], b.coeff[i], b.stderr[i], b.tstat[i], b.pval[i]
            endloop
            printf "\\hline\nR-squared & %.6f & & Durbin-Watson & %.4f \\\\\n", b.rsq, b.dw
            printf "Observations & %d & & S.E. of regression & %.6f \\\\\n\\hline\n\\end{tabular}\n", b.T, b.sigma
        end outfile
    elif ext == "html"
        outfile @fname --quiet
            printf "<table border=\"1\" cellpadding=\"4\">\n<caption>Dependent Variable: %s (%s)</caption>\n", b.depvar, b.sample
            printf "<tr><th>Variable</th><th>Coefficient</th><th>Std. Error</th><th>t-Statistic</th><th>Prob.</th></tr>\n"
            loop i = 1..b.k
                printf "<tr><td>%s</td><td>%.6f</td><td>%.6f</td><td>%.4f</td><td>%.4f</td></tr>\n", b.labels[i], b.coeff[i], b.stderr[i], b.tstat[i], b.pval[i]
            endloop
            printf "<tr><td>R-squared</td><td>%.6f</td><td colspan=\"2\">Durbin-Watson stat</td><td>%.4f</td></tr>\n", b.rsq, b.dw
            printf "<tr><td>Observations</td><td>%d</td><td colspan=\"2\">S.E. of regression</td><td>%.6f</td></tr>\n</table>\n", b.T, b.sigma
        end outfile
    else
        funcerr "Unsupported extension: use .txt, .csv, .tex or .html"
    endif
    printf "Frozen table written to %s\n", fname
end function

# -------------------------------------------------------------------
# EViews at-function equivalents
# -------------------------------------------------------------------

function series ev_trend (void)
    series t = obs - 1
    return t
end function

function series ev_seas (int k[1::])
    errorif(k > $pd, sprintf("Season %d exceeds data frequency %d", k, $pd))
    series s = $obsminor == k
    return s
end function

function series ev_pch (series x)
    return x / x(-1) - 1
end function

function series ev_pc (series x)
    return 100 * (x / x(-1) - 1)
end function

function series ev_pchy (series x)
    return x / x(-$pd) - 1
end function

function series ev_pcy (series x)
    return 100 * (x / x(-$pd) - 1)
end function

function series ev_movav (series x, int n[1::])
    if n == 1
        return x
    endif
    return movavg(x, n)
end function

function series ev_movsum (series x, int n[1::])
    if n == 1
        return x
    endif
    return n * movavg(x, n)
end function

function scalar ev_mean (series x)
    return mean(x)
end function

function scalar ev_stdev (series x)
    # sample standard deviation (n-1), as EViews
    return sd(x)
end function

function scalar ev_var (series x)
    # population variance (divisor n), as EViews
    return sd(x)^2 * (nobs(x) - 1) / nobs(x)
end function

function scalar ev_obs (series x)
    return nobs(x)
end function

function scalar ev_elem (series x, string ob "Observation, e.g. 1990:1")
    return x[obsnum(ob)]
end function

# -------------------------------------------------------------------
# Fitted values and residuals as series (eq.fit / eq.makeresid)
# -------------------------------------------------------------------

function series ev__toseries (const matrix v, const matrix tobs)
    series s = NA
    loop i = 1..rows(v)
        scalar t = tobs[i]
        s[t] = v[i]
    endloop
    return s
end function

function series ev_resid (bundle b "ev_ls result")
    errorif(!inbundle(b, "tobs"), "Not an ev_ls result (or estimated with an older EViewsCompat)")
    return ev__toseries(b.uhat, b.tobs)
end function

function series ev_fit (bundle b "ev_ls result")
    errorif(!inbundle(b, "tobs"), "Not an ev_ls result (or estimated with an older EViewsCompat)")
    return ev__toseries(b.yhat, b.tobs)
end function

# -------------------------------------------------------------------
# Forecast (eq.forecast), over the current sample as in EViews
# -------------------------------------------------------------------

function void ev__stats (bundle *b)
    # common EViews statistics from b.y, b.uhat, b.k, b.lnl (and b.T)
    scalar n = rows(b.uhat)
    scalar k = b.k
    matrix u = b.uhat
    matrix d = b.y - meanc(b.y)
    b.T = n
    b.ssr = u'u
    b.rsq = 1 - b.ssr / (d'd)
    b.adjrsq = 1 - (1 - b.rsq) * (n - 1) / (n - k)
    b.meany = meanc(b.y)
    b.sdy = sqrt(d'd / (n - 1))
    scalar kk = inbundle(b, "sigmasq") ? k + 1 : k
    b.aic = -2 * b.lnl / n + 2 * kk / n
    b.sc = -2 * b.lnl / n + kk * log(n) / n
    b.hq = -2 * b.lnl / n + 2 * kk * log(log(n)) / n
    matrix du = u[2:n] - u[1:n-1]
    b.dw = (du'du) / (u'u)
    b.tstat = b.coeff ./ b.stderr
    matrix p = zeros(k, 1)
    loop i = 1..k
        p[i] = 2 * pvalue(t, n - k, abs(b.tstat[i]))
    endloop
    b.pval = p
    if !inbundle(b, "F")
        b.F = NA
        b.Fp = NA
    endif
end function

function scalar ev__depform (string dep, string *base, list vars)
    # form of the dependent variable: 0 = Y, 1 = log(Y), 2 = d(Y), 3 = dlog(Y)
    # or d(log(Y)); -1 = other. base receives the series name Y.
    strings pats = defarray("^\s*([A-Za-z_][A-Za-z0-9_]*)\s*$", \
      "^\s*log\(\s*([A-Za-z_][A-Za-z0-9_]*)\s*\)\s*$", \
      "^\s*d\(\s*([A-Za-z_][A-Za-z0-9_]*)\s*\)\s*$", \
      "^\s*dlog\(\s*([A-Za-z_][A-Za-z0-9_]*)\s*\)\s*$", \
      "^\s*d\(\s*log\(\s*([A-Za-z_][A-Za-z0-9_]*)\s*\)\s*\)\s*$")
    matrix forms = {0, 1, 2, 3, 3}
    loop i = 1..nelem(pats)
        string m = regsub(dep, "(?i)" ~ pats[i], "\1")
        if m != dep || i == 1 && regsub(dep, "(?i)" ~ pats[1], "") == ""
            if rows(instrings(varnames(vars), m)) > 0
                base = m
                return forms[i]
            endif
        endif
    endloop
    base = ""
    return -1
end function

function string ev_depbase (bundle b "Equation (ev_ls result)", list vars "Series used (e.g. dataset)")
    # the series Y when the dependent variable is log(Y), d(Y) or dlog(Y); "" otherwise
    string dep = inbundle(b, "lhs") ? b.lhs : strsplit(b.spec)[1]
    string base = ""
    scalar f = ev__depform(dep, &base, vars)
    return f > 0 ? base : ""
end function

function series ev__toseries_s (const matrix v, const matrix tobs)
    return ev__toseries(v, tobs)
end function

function bundle ev_forecast (bundle b "ev_ls result",
                             list vars "Series used (e.g. dataset)",
                             bool dynamic[1] "Dynamic (1) or static (0)",
                             bool quiet[0],
                             bool level[0] "Report the level of the dependent variable, e.g. Y for dlog(Y)")
    errorif(!inbundle(b, "coeff"), "First argument must be an equation (ev_ls result)")
    string kind = inbundle(b, "kind") ? b.kind : "ls"
    string dep = kind == "nls" ? b.lhs : strsplit(b.spec)[1]
    string base = ""
    scalar form = ev__depform(dep, &base, vars)
    series evf_y = ev_gen(dep, vars)
    matrix y = {evf_y}
    series evf_o = obs
    matrix tobs = {evf_o}
    scalar T = rows(y)
    scalar k = b.k
    matrix beta = b.coeff
    scalar s2 = b.sigma^2

    # actual level and its previous value (pre-sample visible through the lag)
    matrix Ylev = mshape(NA, T, 1)
    matrix Yprev = mshape(NA, T, 1)
    if form >= 0
        string e1 = "vars." ~ base
        string e2 = "vars." ~ base ~ "(-1)"
        series evf_L = @e1
        series evf_Lp = @e2
        Ylev = {evf_L}
        Yprev = {evf_Lp}
    endif

    # how the right-hand side is evaluated
    strings tok = array(0)
    matrix X = {}
    matrix usesY = {}
    if kind == "arma"
        return ev__fc_arma(b, vars, dynamic, quiet, level, form, base)
    elif kind == "nls"
        loop j = 1..k
            string pn = sprintf("evn_c%d", b.cidx[j])
            scalar @pn = beta[j]
        endloop
        string rhx = ev__prep(b.rhs, vars)
        series evf_r0 = @rhx
        matrix r0 = {evf_r0}
        # gradient for the coefficient part of the S.E.
        matrix J = {}
        loop j = 1..k
            string pn = sprintf("evn_c%d", b.cidx[j])
            scalar h = 1e-6 * (1 + abs(beta[j]))
            scalar @pn = beta[j] + h
            series evf_rp = @rhx
            scalar @pn = beta[j]
            J ~= ({evf_rp} - r0) / h
        endloop
    else
        tok = strsplit(b.spec)
        loop i = 2..nelem(tok)
            if tolower(tok[i]) == "c"
                series evf_r = 1
            else
                series evf_r = ev_gen(tok[i], vars)
            endif
            X ~= {evf_r}
            scalar u_ = form >= 0 && regsub(tok[i], "(?i)(?<![A-Za-z0-9_])" ~ base ~ "(?![A-Za-z0-9_])", "#") != tok[i]
            usesY ~= u_
        endloop
        errorif(cols(X) != k, "Could not rebuild the regressors of the equation")
    endif

    # AR terms in the dependent variable -> psi weights for multi-step S.E.
    matrix phi = zeros(1, 24)
    scalar dyn_ok = dynamic && form >= 0
    if kind == "ls" && form >= 0
        string dl = tolower(regsub(dep, "\s", ""))
        loop L = 1..24
            string cand = regsub(dl, "(?<![a-z0-9_])" ~ tolower(base) ~ "(?![a-z0-9_])", tolower(base) ~ sprintf("(-%d)", L))
            if form == 0
                cand = tolower(base) ~ sprintf("(-%d)", L)
            endif
            loop i = 2..nelem(tok)
                if tolower(regsub(tok[i], "\s", "")) == cand
                    phi[L] = beta[i-1]
                endif
            endloop
        endloop
    endif
    matrix psi = zeros(T, 1)
    psi[1] = 1
    loop j = 2..T
        loop L = 1..min(24, j - 1)
            psi[j] += phi[L] * psi[j - L]
        endloop
    endloop
    matrix psiC = cum(psi)

    # step through the forecast sample
    matrix yf = mshape(NA, T, 1)
    matrix se = mshape(NA, T, 1)
    matrix yfl = mshape(NA, T, 1)
    matrix sel = mshape(NA, T, 1)
    series evf_dlt = 0          # forecast minus actual level (dynamic forecasts)
    loop t = 1..T
        scalar v = NA
        scalar st = tobs[t]
        matrix g = {}
        if kind == "nls"
            v = r0[t]
            if dyn_ok && t > 1
                series evf_rr = ev__gen2(b.rhs, vars, base, evf_dlt)
                v = evf_rr[st]
            endif
            g = J[t,]
        else
            matrix x = X[t,]
            if dyn_ok && t > 1
                loop i = 1..cols(x)
                    if usesY[i]
                        series evf_rc = ev__gen2(tok[i+1], vars, base, evf_dlt)
                        if ok(evf_rc[st])
                            x[i] = evf_rc[st]
                        endif
                    endif
                endloop
            endif
            if sum(!ok(x)) == 0
                v = x * beta
            endif
            g = x
        endif
        if !ok(v)
            continue
        endif
        yf[t] = v
        scalar h = dynamic ? t : 1
        # static: innovation and coefficient uncertainty; dynamic: innovation
        # uncertainty propagated through the lags of the dependent variable (as gretl)
        scalar cvar = (!dynamic && sum(!ok(g)) == 0) ? qform(g, b.vcv) : 0
        se[t] = sqrt(s2 * sumc(psi[1:h].^2) + cvar)
        if form >= 0
            scalar prev = (t > 1 && dynamic && ok(yfl[t-1])) ? yfl[t-1] : Yprev[t]
            if form == 0
                yfl[t] = v
                sel[t] = se[t]
            elif form == 1
                yfl[t] = exp(v)
                sel[t] = yfl[t] * se[t]
            elif form == 2
                yfl[t] = prev + v
                sel[t] = dynamic ? sqrt(s2 * sumc(psiC[1:h].^2)) : se[t]
            else
                yfl[t] = prev * exp(v)
                sel[t] = yfl[t] * (dynamic ? sqrt(s2 * sumc(psiC[1:h].^2)) : se[t])
            endif
            if dyn_ok
                evf_dlt[st] = yfl[t] - Ylev[t]
            endif
        endif
    endloop
    return ev__fc_finish(b, dep, base, form, dynamic, level, y, yf, se, Ylev, yfl, sel, tobs, quiet, kind == "nls" && dynamic)
end function

function bundle ev__fc_finish (bundle b, string dep, string base, scalar form, bool dynamic,
                               bool level, matrix y, matrix yf, matrix se, matrix Ylev,
                               matrix yfl, matrix sel, matrix tobs, bool quiet, bool approx_se)
    bundle f
    f.depvar = b.depvar
    f.base = toupper(base)
    f.form = form
    f.dynamic = dynamic
    f.level = level && form > 0
    f.yf = yf
    f.se = se
    f.actual = y
    f.yfl = yfl
    f.sel = sel
    f.actual_level = Ylev
    f.tobs = tobs
    f.sample = sprintf("%s %s", obslabel($t1), obslabel($t2))
    f.se_note = approx_se ? "S.E. of a dynamic forecast from an explicit equation uses the one-step formula" : ""
    # evaluation statistics for the series reported
    matrix a = f.level ? Ylev : y
    matrix p = f.level ? yfl : yf
    matrix m = ok(a) .* ok(p)
    f.nobs = sum(m)
    if f.nobs > 0
        a = selifr(a, m)
        p = selifr(p, m)
        matrix e = p - a
        scalar mse = meanc(e.^2)
        f.rmse = sqrt(mse)
        f.mae = meanc(abs(e))
        f.mape = 100 * meanc(abs(e ./ a))
        f.theil = f.rmse / (sqrt(meanc(a.^2)) + sqrt(meanc(p.^2)))
        scalar sa = sqrt(meanc((a - meanc(a)).^2))
        scalar sp = sqrt(meanc((p - meanc(p)).^2))
        scalar r = (sa > 0 && sp > 0) ? meanc((a - meanc(a)) .* (p - meanc(p))) / (sa * sp) : 0
        f.bias_prop = (meanc(p) - meanc(a))^2 / mse
        f.var_prop = (sp - sa)^2 / mse
        f.cov_prop = 2 * (1 - r) * sp * sa / mse
    endif
    if !quiet
        ev_fprint(&f)
    endif
    return f
end function

function bundle ev__fc_arma (bundle b, list vars, bool dynamic, bool quiet, bool level,
                             scalar form, string base)
    # regression with ARMA errors: y = X beta + u,  phi(L) u = theta(L) e
    string dep = strsplit(b.spec)[1]
    series eva_y = ev_gen(dep, vars)
    matrix y = {eva_y}
    series eva_o = obs
    matrix tobs = {eva_o}
    scalar T = rows(y)
    matrix Xf = b.hasc ? ones(T, 1) : {}
    loop i = 1..nelem(b.xtok)
        series eva_x = ev_gen(b.xtok[i], vars)
        Xf ~= {eva_x}
    endloop
    matrix xb = cols(Xf) > 0 ? Xf * b.beta : zeros(T, 1)
    scalar s0 = tobs[1]
    scalar N = max(tobs[T], maxc(b.tobs))
    matrix U = mshape(NA, N, 1)        # u = y - X beta, by observation number
    matrix E = mshape(NA, N, 1)        # innovations
    U[b.tobs] = b.ureg
    E[b.tobs] = b.uhat
    scalar pmax = cols(b.pl) ? maxr(b.pl) : 0
    scalar qmax = cols(b.ql) ? maxr(b.ql) : 0
    errorif(s0 - max(pmax, qmax) < minc(b.tobs) || s0 > maxc(b.tobs) + 1, \
      "ARMA forecasts must start inside the estimation sample or right after it")
    # for static forecasts actual u and e inside the forecast sample are needed
    matrix uact = y - xb
    matrix yf = mshape(NA, T, 1)
    loop t = 1..T
        scalar s = tobs[t]
        scalar uh = 0
        loop i = 1..cols(b.pl)
            scalar L = b.pl[i]
            scalar uu = (s - L < s0 || !dynamic) ? U[s - L] : yf[t - L] - xb[t - L]
            if s - L >= s0 && !dynamic
                uu = uact[t - L]
            endif
            uh += b.phi[i] * uu
        endloop
        loop i = 1..cols(b.ql)
            scalar L = b.ql[i]
            scalar ee = s - L < s0 ? E[s - L] : (dynamic ? 0 : E[s - L])
            uh += b.theta[i] * ee
        endloop
        yf[t] = xb[t] + uh
        if !dynamic
            # one-step innovation at s, used by later static steps
            E[s] = uact[t] - uh
            U[s] = uact[t]
        endif
    endloop
    # psi weights of the ARMA error process
    matrix psi = zeros(T, 1)
    psi[1] = 1
    loop j = 2..T
        scalar v = 0
        loop i = 1..cols(b.ql)
            if b.ql[i] == j - 1
                v += b.theta[i]
            endif
        endloop
        loop i = 1..cols(b.pl)
            if j - b.pl[i] >= 1
                v += b.phi[i] * psi[j - b.pl[i]]
            endif
        endloop
        psi[j] = v
    endloop
    matrix psiC = cum(psi)
    scalar s2 = b.sigmasq
    matrix se = mshape(NA, T, 1)
    matrix Ylev = mshape(NA, T, 1)
    matrix Yprev = mshape(NA, T, 1)
    matrix yfl = mshape(NA, T, 1)
    matrix sel = mshape(NA, T, 1)
    if form >= 0
        string e1 = "vars." ~ base
        string e2 = "vars." ~ base ~ "(-1)"
        series evf_L = @e1
        series evf_Lp = @e2
        Ylev = {evf_L}
        Yprev = {evf_Lp}
    endif
    loop t = 1..T
        scalar h = dynamic ? t : 1
        se[t] = sqrt(s2 * sumc(psi[1:h].^2))
        if form >= 0 && ok(yf[t])
            scalar prev = (t > 1 && dynamic && ok(yfl[t-1])) ? yfl[t-1] : Yprev[t]
            if form == 0
                yfl[t] = yf[t]
                sel[t] = se[t]
            elif form == 1
                yfl[t] = exp(yf[t])
                sel[t] = yfl[t] * se[t]
            elif form == 2
                yfl[t] = prev + yf[t]
                sel[t] = dynamic ? sqrt(s2 * sumc(psiC[1:h].^2)) : se[t]
            else
                yfl[t] = prev * exp(yf[t])
                sel[t] = yfl[t] * (dynamic ? sqrt(s2 * sumc(psiC[1:h].^2)) : se[t])
            endif
        endif
    endloop
    return ev__fc_finish(b, dep, base, form, dynamic, level, y, yf, se, Ylev, yfl, sel, tobs, quiet, 0)
end function

function void ev_fprint (bundle *f)
    string nm = f.level ? f.base : f.depvar
    printf "\nForecast: %sF\nActual: %s\n", f.level ? f.base : f.depvar, nm
    printf "Forecast sample: %s\n", f.sample
    printf "Method: %s\n", f.dynamic ? "Dynamic forecast" : "Static forecast"
    printf "Included observations: %d\n", f.nobs
    if f.nobs > 0
        printf "%-34s%14.6f\n", "Root Mean Squared Error", f.rmse
        printf "%-34s%14.6f\n", "Mean Absolute Error", f.mae
        printf "%-34s%14.6f\n", "Mean Abs. Percent Error", f.mape
        printf "%-34s%14.6f\n", "Theil Inequality Coef.", f.theil
        printf "%-34s%14.6f\n", "     Bias Proportion", f.bias_prop
        printf "%-34s%14.6f\n", "     Variance Proportion", f.var_prop
        printf "%-34s%14.6f\n", "     Covariance Proportion", f.cov_prop
    endif
    if f.se_note != ""
        printf "Note: %s\n", f.se_note
    endif
end function

function series ev_fcast_series (bundle f "ev_forecast result", bool level[0] "Level of the dependent variable")
    return ev__toseries(level ? f.yfl : f.yf, f.tobs)
end function

function series ev_fcast_se (bundle f "ev_forecast result", bool level[0] "Level of the dependent variable")
    return ev__toseries(level ? f.sel : f.se, f.tobs)
end function

function void ev_fplot (bundle *f, string fname[null])
    # forecast with +/- 2 S.E. bands, and the actual series
    matrix p = f.level ? f.yfl : f.yf
    matrix s = f.level ? f.sel : f.se
    matrix a = f.level ? f.actual_level : f.actual
    matrix M = p ~ (p + 2 * s) ~ (p - 2 * s) ~ a
    cnameset(M, defarray("Forecast", "+2 S.E.", "-2 S.E.", "Actual"))
    string out = exists(fname) ? fname : "display"
    gnuplot 1 2 3 4 --matrix=M --time-series --with-lines --single-yaxis --output="@out" \
      {set title "Forecast with +/- 2 S.E.";}
end function

# -------------------------------------------------------------------
# Explicit equations:  y = c(1) + c(2)*x   (nonlinear least squares)
# -------------------------------------------------------------------

function bundle ev_nls (string spec "Explicit equation, e.g. y = c(1) + c(2)*x^c(3)",
                        list vars "Series used (e.g. dataset)",
                        string cov[null] "ordinary, white or hac",
                        bool quiet[0])
    string covt = exists(cov) ? tolower(cov) : "ordinary"
    strings sides = strsplit(spec, "=")
    errorif(nelem(sides) != 2, "Use exactly one '=' in an explicit equation")
    string lhs = strstrip(sides[1])
    string rhs0 = strstrip(sides[2])
    string low = tolower(rhs0)
    matrix cidx = {}
    loop i = 1..99
        if instring(low, sprintf("c(%d)", i))
            cidx ~= i
        endif
    endloop
    errorif(cols(cidx) == 0, "No coefficients c(1), c(2), ... in the equation")
    string rhs = regsub(rhs0, "(?i)(?<![A-Za-z0-9_])c\(([0-9]+)\)", "evn_c\1")
    string rhx = ev__prep(rhs, vars)
    series evn_y = ev_gen(lhs, vars)
    string plist = ""
    loop j = 1..cols(cidx)
        string pn = sprintf("evn_c%d", cidx[j])
        scalar @pn = 0
        plist ~= " " ~ pn
    endloop
    scalar n0 = $nobs
    if covt == "ordinary"
        nls evn_y = @rhx
          params @plist
        end nls --quiet
    else
        nls evn_y = @rhx
          params @plist
        end nls --quiet --robust
    endif
    bundle b
    b.kind = "nls"
    b.spec = spec
    b.lhs = lhs
    b.rhs = rhs
    b.cidx = cidx
    b.depvar = toupper(lhs)
    b.method = "Least Squares (Gauss-Newton / Marquardt steps)"
    b.eqline = regsub(toupper(lhs ~ "=" ~ rhs0), "\s", "")
    strings lab = array(0)
    loop j = 1..cols(cidx)
        lab += sprintf("C(%d)", cidx[j])
    endloop
    b.labels = lab
    b.covtype = covt
    b.coeff = $coeff
    b.stderr = $stderr
    b.vcv = $vcv
    b.k = $ncoeff
    b.lnl = $lnl
    b.sigma = $sigma
    b.adjusted = $T < n0
    b.estdate = strftime($now[1], "%m/%d/%y   Time: %H:%M")
    series evn_u = $uhat
    series evn_f = $yhat
    smpl ok(evn_u) --restrict
    b.y = {evn_y}
    b.uhat = {evn_u}
    b.yhat = {evn_f}
    series evn_o = obs
    b.tobs = {evn_o}
    b.sample = sprintf("%s %s", obslabel($t1), obslabel($t2))
    # numerical gradient: used as regressors by the residual diagnostics
    matrix J = {}
    loop j = 1..b.k
        string pn = sprintf("evn_c%d", cidx[j])
        scalar h = 1e-6 * (1 + abs(b.coeff[j]))
        scalar @pn = b.coeff[j] + h
        series evn_fp = @rhx
        scalar @pn = b.coeff[j]
        J ~= ({evn_fp} - b.yhat) / h
    endloop
    b.X = J
    ev__stats(&b)
    if !quiet
        ev_print(&b)
    endif
    return b
end function

# -------------------------------------------------------------------
# ARMA terms:  y c x ar(1) ma(1)   (regression with ARMA errors, exact ML)
# -------------------------------------------------------------------

function string ev__roots (matrix coefs, matrix lagv, scalar sgn)
    # inverted roots of 1 - sgn*sum(coef_i L^lag_i), formatted like EViews
    if cols(lagv) == 0
        return ""
    endif
    scalar p = maxr(lagv)
    matrix a = zeros(1, p + 1)
    a[1] = 1
    loop i = 1..cols(lagv)
        a[lagv[i] + 1] = -sgn * coefs[i]
    endloop
    matrix r = polroots(a)
    matrix rr = iscomplex(r) ? Re(r) : r[,1]
    matrix ri = iscomplex(r) ? Im(r) : (cols(r) > 1 ? r[,2] : zeros(rows(r), 1))
    string out = ""
    loop i = 1..rows(rr)
        scalar xr = rr[i]
        scalar xi = ri[i]
        scalar m2 = xr^2 + xi^2
        scalar ire = xr / m2
        scalar iim = -xi / m2
        if abs(iim) < 1e-8
            out ~= sprintf("%10.2f", ire)
        else
            out ~= sprintf("%10s", sprintf("%.2f%s%.2fi", ire, iim >= 0 ? "+" : "-", abs(iim)))
        endif
    endloop
    return out
end function

function bundle ev_arma (string spec "Equation with ar(k) / ma(k) terms, e.g. y c x ar(1) ma(1)",
                         list vars "Series used (e.g. dataset)",
                         bool quiet[0])
    strings tok = strsplit(spec)
    series eva_y = ev_gen(tok[1], vars)
    list evaX = null
    strings xlab = array(0)
    strings xtok = array(0)
    scalar hasc = 0
    matrix pl = {}
    matrix ql = {}
    loop i = 2..nelem(tok)
        string t = tolower(tok[i])
        if t == "c"
            hasc = 1
        elif regsub(t, "^ar\([0-9]+\)$", "") == ""
            pl ~= atof(regsub(t, "[^0-9]", ""))
        elif regsub(t, "^ma\([0-9]+\)$", "") == ""
            ql ~= atof(regsub(t, "[^0-9]", ""))
        else
            string v = sprintf("eva_x%d", i)
            series @v = ev_gen(tok[i], vars)
            list evaX += @v
            xlab += toupper(tok[i])
            xtok += tok[i]
        endif
    endloop
    if cols(pl)
        pl = values(pl')'
    endif
    if cols(ql)
        ql = values(ql')'
    endif
    matrix eva_pl = pl
    matrix eva_ql = ql
    string pa = cols(pl) ? "eva_pl" : "0"
    string qa = cols(ql) ? "eva_ql" : "0"
    scalar n0 = $nobs
    # with regressors gretl needs the constant listed explicitly
    if hasc && nelem(evaX) > 0
        arima @pa 0 @qa ; eva_y const evaX --quiet
    elif hasc
        arima @pa 0 @qa ; eva_y --quiet
    elif nelem(evaX) > 0
        arima @pa 0 @qa ; eva_y evaX --quiet --nc
    else
        arima @pa 0 @qa ; eva_y --quiet --nc
    endif
    matrix cf = $coeff
    matrix sd = $stderr
    bundle b
    b.kind = "arma"
    b.spec = spec
    b.depvar = toupper(tok[1])
    b.method = "ARMA Maximum Likelihood (BFGS)"
    b.covtype = "ordinary"
    b.hasc = hasc
    b.pl = pl
    b.ql = ql
    b.xtok = xtok
    # gretl order: const, AR, MA, regressors;  EViews order: C, regressors, AR, MA
    scalar np = cols(pl)
    scalar nq = cols(ql)
    scalar nx = nelem(xtok)
    strings lab = array(0)
    if hasc
        lab += "C"
    endif
    loop i = 1..np
        lab += sprintf("AR(%d)", pl[i])
    endloop
    loop i = 1..nq
        lab += sprintf("MA(%d)", ql[i])
    endloop
    loop i = 1..nx
        lab += xlab[i]
    endloop
    b.labels = lab
    matrix ord = {}
    if hasc
        ord ~= 1
    endif
    scalar o1 = hasc + np + nq + 1
    scalar o2 = hasc + np + nq + nx
    scalar o3 = hasc + 1
    scalar o4 = hasc + np + nq
    if nx
        ord ~= seq(o1, o2)
    endif
    if np + nq
        ord ~= seq(o3, o4)
    endif
    b.order = ord
    b.coeff = cf
    b.stderr = sd
    b.vcv = $vcv
    b.k = rows(cf)
    b.lnl = $lnl
    scalar i1 = hasc + 1
    scalar i2 = hasc + np
    scalar i3 = hasc + np + 1
    scalar i4 = hasc + np + nq
    scalar i5 = hasc + np + nq + 1
    scalar i6 = hasc + np + nq + nx
    b.phi = np ? cf[i1:i2]' : {}
    b.theta = nq ? cf[i3:i4]' : {}
    matrix bb = {}
    if hasc
        bb |= cf[1]
    endif
    if nx
        bb |= cf[i5:i6]
    endif
    b.beta = bb
    b.adjusted = $T < n0
    b.estdate = strftime($now[1], "%m/%d/%y   Time: %H:%M")
    series eva_u = $uhat
    series eva_f = $yhat
    smpl ok(eva_u) --restrict
    b.y = {eva_y}
    b.uhat = {eva_u}
    b.yhat = {eva_f}
    series eva_o = obs
    b.tobs = {eva_o}
    b.sample = sprintf("%s %s", obslabel($t1), obslabel($t2))
    matrix Xm = hasc ? ones(rows(b.y), 1) : {}
    if nx
        Xm ~= {evaX}
    endif
    b.X = cols(Xm) ? Xm : ones(rows(b.y), 1)
    b.ureg = cols(Xm) ? b.y - Xm * bb : b.y
    scalar T = rows(b.y)
    b.sigmasq = (b.uhat'b.uhat) / T
    b.sigmasq_se = b.sigmasq * sqrt(2 / T)
    b.sigma = sqrt((b.uhat'b.uhat) / (T - b.k))
    if np
        b.ar_roots = ev__roots(b.phi, pl, 1)
    endif
    if nq
        b.ma_roots = ev__roots(b.theta, ql, -1)
    endif
    ev__stats(&b)
    if !quiet
        ev_print(&b)
    endif
    return b
end function

# -------------------------------------------------------------------
# VAR objects:  ev_varest("1 2 y1 y2 @ c x", dataset)
# -------------------------------------------------------------------

function bundle ev_varest (string spec "Lag pairs, endogenous, then exogenous after the at-sign",
                           list vars "Series used (e.g. dataset)",
                           bool quiet[0],
                           string names[null] "Display names for the variables, space separated")
    # Plain series names are used directly, so lags reach before the sample start
    # as in gretl's var. Expressions are evaluated inside this function, where
    # pre-sample values are not available: create them as series first if that matters.
    string AT = "@"
    strings LB = exists(names) ? strsplit(names) : array(0)
    scalar nexpr = 0
    strings parts = strsplit(spec, AT)
    errorif(nelem(parts) > 2, "Use the at-sign once, before the exogenous variables")
    strings L = strsplit(parts[1])
    # leading integers are lag pairs
    matrix lagv = {}
    scalar i0 = 1
    loop while i0 + 1 <= nelem(L) && regsub(L[i0], "^[0-9]+$", "") == "" && regsub(L[i0+1], "^[0-9]+$", "") == ""
        scalar a = atof(L[i0])
        scalar z = atof(L[i0+1])
        errorif(a < 1 || z < a, "Lag pairs must be like 1 2 (from 1 to 2)")
        lagv ~= seq(a, z)
        i0 += 2
    endloop
    errorif(cols(lagv) == 0, "Start the specification with lag pairs, e.g. 1 2")
    lagv = values(lagv')'
    errorif(nelem(L) - i0 + 1 < 1, "No endogenous variables")
    list Y = null
    strings ylab = array(0)
    strings ytok = array(0)
    strings xtok = array(0)
    loop i = i0..nelem(L)
        matrix pp = instrings(varnames(vars), L[i])
        if rows(pp) > 0
            list Y += vars[pp[1]]
        else
            string v = sprintf("evv_y%d", i)
            series @v = ev_gen(L[i], vars)
            list Y += @v
            nexpr++
        endif
        scalar li = nelem(ytok) + 1
        ylab += nelem(LB) >= li ? toupper(LB[li]) : toupper(L[i])
        ytok += L[i]
    endloop
    list X = null
    strings xlab = array(0)
    scalar hasc = nelem(parts) == 1   # no exogenous part: constant by default
    if nelem(parts) == 2
        strings R = strsplit(parts[2])
        loop i = 1..nelem(R)
            if tolower(R[i]) == "c"
                hasc = 1
            else
                matrix pp = instrings(varnames(vars), R[i])
                if rows(pp) > 0
                    list X += vars[pp[1]]
                else
                    string v = sprintf("evv_x%d", i)
                    series @v = ev_gen(R[i], vars)
                    list X += @v
                    nexpr++
                endif
                scalar li = nelem(ytok) + nelem(xtok) + 1
                xlab += nelem(LB) >= li ? toupper(LB[li]) : toupper(R[i])
                xtok += R[i]
            endif
        endloop
    endif
    scalar n0 = $nobs
    if nelem(X) > 0
        if hasc
            var lagv Y ; X --silent
        else
            var lagv Y ; X --silent --nc
        endif
    else
        if hasc
            var lagv Y --silent
        else
            var lagv Y --silent --nc
        endif
    endif
    bundle sys = $system
    if nexpr > 0 && !quiet
        printf "Note: %d variable(s) given as expressions lose their pre-sample lags;\n", nexpr
        printf "      create them as series first to use the full sample.\n"
    endif

    bundle b
    b.spec = spec
    b.sys = sys
    b.ylab = ylab
    b.xlab = xlab
    b.ytok = ytok
    b.xtok = xtok
    b.lags = lagv
    b.hasc = hasc
    b.n = nelem(Y)
    b.T = sys.T
    b.k = sys.ncoeff
    b.coeff = sys.coeff
    b.adjusted = sys.T < n0
    b.sample = sprintf("%s %s", obslabel(sys.t1), obslabel(sys.t2))
    b.estdate = strftime($now[1], "%m/%d/%y   Time: %H:%M")
    # coefficient labels in gretl's order: const, lagv of each endogenous, exogenous
    strings clab = array(0)
    if hasc
        clab += "C"
    endif
    loop j = 1..b.n
        loop l = 1..cols(lagv)
            clab += sprintf("%s(-%d)", ylab[j], lagv[l])
        endloop
    endloop
    loop j = 1..nelem(xlab)
        clab += xlab[j]
    endloop
    errorif(nelem(clab) != b.k, "Internal error: coefficient labels do not match")
    b.clab = clab

    # per-equation statistics
    scalar T = b.T
    scalar k = b.k
    matrix E = sys.uhat
    matrix Ym = sys.Y
    matrix ssr = sumc(E.^2)
    matrix dev = Ym .- meanc(Ym)
    matrix sst = sumc(dev.^2)
    b.ssr = ssr
    b.rsq = 1 - ssr ./ sst
    b.adjrsq = 1 - (1 - b.rsq) * (T - 1) / (T - k)
    b.seeq = sqrt(ssr / (T - k))
    b.se = sqrt(diag(sys.xtxinv)) * b.seeq       # k x n
    b.tstat = b.coeff ./ b.se
    b.Fstat = hasc ? (b.rsq / (k - 1)) ./ ((1 - b.rsq) / (T - k)) : mshape(NA, 1, b.n)
    b.lnl_eq = -T / 2 * (1 + log(2 * $pi) + log(ssr / T))
    b.aic_eq = -2 * b.lnl_eq / T + 2 * k / T
    b.sc_eq = -2 * b.lnl_eq / T + k * log(T) / T
    b.meany = meanc(Ym)
    b.sdy = sqrt(sst / (T - 1))
    matrix S = E'E / T
    b.det_adj = det(E'E / (T - k))
    b.det = det(S)
    b.lnl = sys.lnl
    b.aic = -2 * b.lnl / T + 2 * b.n * k / T
    b.sc = -2 * b.lnl / T + b.n * k * log(T) / T
    if !quiet
        ev_varprint(&b)
    endif
    return b
end function

function void ev_varprint (bundle *b)
    errorif(!inbundle(b, "sys"), "Not an ev_varest result")
    scalar n = b.n
    printf "\nVector Autoregression Estimates\nDate: %s\n", b.estdate
    printf "Sample%s: %s\n", b.adjusted ? " (adjusted)" : "", b.sample
    printf "Included observations: %d%s\n", b.T, b.adjusted ? " after adjustments" : ""
    printf "Standard errors in ( ) & t-statistics in [ ]\n\n"
    scalar w = 22 + 16 * n
    ev__line(w)
    printf "%-22s", ""
    loop j = 1..n
        printf "%16s", b.ylab[j]
    endloop
    printf "\n"
    ev__line(w)
    # EViews order: lags first, then C, then exogenous
    matrix ord = {}
    scalar c0 = b.hasc ? 2 : 1
    scalar nl = b.n * cols(b.lags)
    ord ~= seq(c0, c0 + nl - 1)
    if b.hasc
        ord ~= 1
    endif
    if b.k > nl + b.hasc
        ord ~= seq(c0 + nl, b.k)
    endif
    loop r = 1..cols(ord)
        scalar i = ord[r]
        printf "%-22s", b.clab[i]
        loop j = 1..n
            printf "%16.6f", b.coeff[i,j]
        endloop
        printf "\n%-22s", ""
        loop j = 1..n
            printf "%16s", sprintf("(%.5f)", b.se[i,j])
        endloop
        printf "\n%-22s", ""
        loop j = 1..n
            printf "%16s", sprintf("[%.5f]", b.tstat[i,j])
        endloop
        printf "\n\n"
    endloop
    ev__line(w)
    strings nm = defarray("R-squared", "Adj. R-squared", "Sum sq. resids", "S.E. equation", \
      "F-statistic", "Log likelihood", "Akaike AIC", "Schwarz SC", "Mean dependent", "S.D. dependent")
    matrices st = defarray(b.rsq, b.adjrsq, b.ssr, b.seeq, b.Fstat, b.lnl_eq, b.aic_eq, b.sc_eq, b.meany, b.sdy)
    loop r = 1..nelem(nm)
        printf "%-22s", nm[r]
        matrix v = st[r]
        loop j = 1..n
            printf "%16.6f", v[j]
        endloop
        printf "\n"
    endloop
    ev__line(w)
    printf "%-44s%16.6g\n", "Determinant resid covariance (dof adj.)", b.det_adj
    printf "%-44s%16.6g\n", "Determinant resid covariance", b.det
    printf "%-44s%16.6f\n", "Log likelihood", b.lnl
    printf "%-44s%16.6f\n", "Akaike information criterion", b.aic
    printf "%-44s%16.6f\n", "Schwarz criterion", b.sc
    ev__line(w)
end function

function matrix ev_vargranger (bundle b "ev_varest result", bool quiet[0])
    # VAR Granger causality / block exogeneity Wald tests (chi-square), EViews style.
    # Returns rows: dependent j, excluded i (0 = all), chi2, df, p
    scalar n = b.n
    scalar p = cols(b.lags)
    scalar c0 = b.hasc ? 2 : 1
    matrix V0 = b.sys.xtxinv
    matrix out = {}
    if !quiet
        printf "\nVAR Granger Causality/Block Exogeneity Wald Tests\nSample: %s\nIncluded observations: %d\n", b.sample, b.T
    endif
    loop j = 1..n
        if !quiet
            printf "\nDependent variable: %s\n\n%-22s%14s%8s%10s\n", b.ylab[j], "Excluded", "Chi-sq", "df", "Prob."
        endif
        scalar s2 = b.seeq[j]^2
        matrix allidx = {}
        loop i = 1..n
            if i != j
                matrix idx = seq(c0 + (i - 1) * p, c0 + i * p - 1)
                allidx ~= idx
                matrix bb = b.coeff[idx, j]
                scalar W = qform(bb', inv(s2 * V0[idx, idx]))
                out |= {j, i, W, p, pvalue(X, p, W)}
                if !quiet
                    printf "%-22s%14.6f%8d%10.4f\n", b.ylab[i], W, p, pvalue(X, p, W)
                endif
            endif
        endloop
        if n > 1
            matrix bb = b.coeff[allidx, j]
            scalar W = qform(bb', inv(s2 * V0[allidx, allidx]))
            out |= {j, 0, W, cols(allidx), pvalue(X, cols(allidx), W)}
            if !quiet
                printf "%-22s%14.6f%8d%10.4f\n", "All", W, cols(allidx), pvalue(X, cols(allidx), W)
            endif
        endif
    endloop
    return out
end function

function matrix ev_varirf (bundle b "ev_varest result", int h[1::10] "Horizon", bool quiet[0])
    # Impulse responses (Cholesky, one S.D. innovations). Column (s-1)*n+t holds
    # the response of variable t to a shock in variable s.
    scalar n = b.n
    set horizon h
    matrix R = {}
    if inbundle(b, "svarS")
        # structural shocks: responses Psi_j * inverse(A) * B
        matrix Psi = ev__psi(b.sys, n, h)
        matrix Rs = zeros(h, n * n)
        loop i = 1..h
            matrix Ri = Psi[, (i - 1) * n + 1:i * n] * b.svarS
            loop s = 1..n
                loop t = 1..n
                    Rs[i, (s - 1) * n + t] = Ri[t, s]
                endloop
            endloop
        endloop
        R = Rs
    else
        loop s = 1..n
            loop t = 1..n
                matrix r = irf(t, s, 0, b.sys)
                R ~= r[1:h, 1]
            endloop
        endloop
    endif
    if !quiet
        loop t = 1..n
            printf "\nResponse of %s:\n%-8s", b.ylab[t], "Period"
            loop s = 1..n
                printf "%16s", b.ylab[s]
            endloop
            printf "\n"
            loop i = 1..h
                printf "%-8d", i
                loop s = 1..n
                    printf "%16.6f", R[i, (s - 1) * n + t]
                endloop
                printf "\n"
            endloop
        endloop
        if inbundle(b, "svarS")
            printf "\nStructural decomposition (%s)\n", b.svar_type
        else
            printf "\nCholesky ordering: "
            loop s = 1..n
                printf "%s ", b.ylab[s]
            endloop
            printf "\n"
        endif
    endif
    return R
end function

function void ev_varirfplot (bundle b "ev_varest result", int h[1::10], string fname[null])
    # grid of impulse-response graphs: row = responding variable, column = shock
    matrix R = ev_varirf(b, h, 1)
    scalar n = b.n
    strings plots = array(0)
    loop t = 1..n
        loop s = 1..n
            matrix M = R[, (s - 1) * n + t]
            string ttl = sprintf("Response of %s to %s", b.ylab[t], b.ylab[s])
            string buf = ""
            gnuplot 1 --matrix=M --time-series --with-lines --outbuf=buf \
              {set title "@ttl" font ",9"; unset key; set xlabel ""; set ylabel ""; set xzeroaxis lt 1 lc rgb "#c0392b";}
            plots += buf
        endloop
    endloop
    string out = exists(fname) ? fname : "display"
    gridplot plots --rows=n --width=900 --height=700 --fontsize=9 --output="@out"
end function

function matrix ev_vardecomp (bundle b "ev_varest result", int h[1::10], bool quiet[0])
    # Variance decomposition in percent; block t holds rows 1..h for variable t
    scalar n = b.n
    set horizon h
    matrix D = {}
    if inbundle(b, "svarS")
        matrix Rr = ev_varirf(b, h, 1)
        loop t = 1..n
            matrix c = {}
            loop s = 1..n
                c ~= cum(Rr[, (s - 1) * n + t].^2)
            endloop
            D |= 100 * c ./ sumr(c)
        endloop
    else
        loop t = 1..n
            matrix d = fevd(t, 0, b.sys)
            D |= 100 * d[1:h, 1:n]
        endloop
    endif
    if !quiet
        matrix R = ev_varirf(b, h, 1)
        loop t = 1..n
            printf "\nVariance Decomposition of %s:\n%-8s%14s", b.ylab[t], "Period", "S.E."
            loop s = 1..n
                printf "%14s", b.ylab[s]
            endloop
            printf "\n"
            loop i = 1..h
                scalar v = 0
                loop s = 1..n
                    v += sumc(R[1:i, (s - 1) * n + t].^2)
                endloop
                printf "%-8d%14.6f", i, sqrt(v)
                loop s = 1..n
                    printf "%14.4f", D[(t - 1) * h + i, s]
                endloop
                printf "\n"
            endloop
        endloop
        if inbundle(b, "svarS")
            printf "\nStructural decomposition (%s)\n", b.svar_type
        else
            printf "\nCholesky ordering: "
            loop s = 1..n
                printf "%s ", b.ylab[s]
            endloop
            printf "\n"
        endif
    endif
    return D
end function

function void ev_varlaglen (bundle b "ev_varest result", list vars "Series used (e.g. dataset)",
                            int maxlag[1::8])
    # lag length criteria (gretl's var --lagselect)
    list Y = null
    loop i = 1..b.n
        string v = sprintf("evl_y%d", i)
        series @v = ev_gen(b.ytok[i], vars)
        list Y += @v
    endloop
    list X = null
    loop i = 1..nelem(b.xtok)
        string v = sprintf("evl_x%d", i)
        series @v = ev_gen(b.xtok[i], vars)
        list X += @v
    endloop
    printf "\nVAR Lag Order Selection Criteria\nEndogenous variables: "
    loop i = 1..b.n
        printf "%s ", b.ylab[i]
    endloop
    printf "\n"
    if nelem(X) > 0
        if b.hasc
            var maxlag Y ; X --lagselect
        else
            var maxlag Y ; X --lagselect --nc
        endif
    elif b.hasc
        var maxlag Y --lagselect
    else
        var maxlag Y --lagselect --nc
    endif
end function

function series ev_varresid (bundle b "ev_varest result", int i[1::1] "Equation number")
    matrix t = seq(b.sys.t1, b.sys.t2)'
    return ev__toseries(b.sys.uhat[, i], t)
end function

# -------------------------------------------------------------------
# System objects: several equations sharing coefficients c(i)
#   estimators ls, sur, tsls, 3sls (computed here in matrix form)
# -------------------------------------------------------------------

function scalar ev__nwlag (scalar T, int lag)
    return lag > 0 ? lag : floor(4 * (T / 100)^(2 / 9))
end function

function matrix ev__gmmS (const matrix U, int lag)
    # long-run covariance of moment contributions U (T x q): White (lag < 0)
    # or Bartlett / Newey-West HAC (lag 0 = automatic)
    matrix S = U'U
    if lag >= 0
        scalar T = rows(U)
        scalar L = ev__nwlag(T, lag)
        loop j = 1..L
            matrix G = U[j+1:T, ]' * U[1:T-j, ]
            S += (1 - j / (L + 1)) * (G + G')
        endloop
    endif
    return S
end function

function bundle ev_system (strings deps "Dependent variable of each equation",
                           strings xspecs "Regressors of each equation, e.g. c x1 x2",
                           strings cnums "Coefficient numbers of each equation, e.g. 1 2 3",
                           list vars "Series used (e.g. dataset)",
                           string method[null] "ls, sur, tsls or 3sls",
                           string inst[null] "Instruments (a constant is added)",
                           bool quiet[0],
                           strings eqtext[null] "Equations as written, for the output",
                           int haclag[-1::-1] "GMM weighting: -1 White, 0 Newey-West automatic lag, k lag k")
    string meth = exists(method) ? tolower(method) : "ls"
    errorif(!instring(" ls ols wls sur tsls 2sls wtsls 3sls gmm ", " " ~ meth ~ " "), \
      "method must be ls, wls, sur, tsls, wtsls, 3sls or gmm (fiml: see ev_sysfrom)")
    meth = meth == "ols" ? "ls" : (meth == "2sls" ? "tsls" : meth)
    scalar n = nelem(deps)
    errorif(nelem(xspecs) != n || nelem(cnums) != n, "deps, xspecs and cnums must have one entry per equation")
    set skip_missing off          # rows with missing values are dropped below, jointly
    # series of every equation, over the current sample
    matrix Yall = {}
    matrices XX = array(n)
    matrices CC = array(n)
    loop i = 1..n
        series evs_y = ev_gen(deps[i], vars)
        Yall ~= {evs_y}
        strings tk = strsplit(xspecs[i])
        strings cn = strsplit(cnums[i])
        errorif(nelem(tk) != nelem(cn), sprintf("equation %d: regressors and coefficient numbers differ", i))
        matrix Xi = {}
        matrix ci = {}
        loop j = 1..nelem(tk)
            if tolower(tk[j]) == "c"
                series evs_x = 1
            else
                series evs_x = ev_gen(tk[j], vars)
            endif
            Xi ~= {evs_x}
            ci ~= atof(cn[j])
        endloop
        XX[i] = Xi
        CC[i] = ci
    endloop
    matrix Z = {}
    if exists(inst) && strstrip(inst) != ""
        series evs_one = 1
        Z = {evs_one}
        strings zt = strsplit(inst)
        loop j = 1..nelem(zt)
            if tolower(zt[j]) != "c"
                series evs_z = ev_gen(zt[j], vars)
                Z ~= {evs_z}
            endif
        endloop
    endif
    scalar ivm = meth == "tsls" || meth == "wtsls" || meth == "3sls" || meth == "gmm"
    errorif(ivm && cols(Z) == 0, meth ~ " needs instruments")
    # balanced sample: rows complete in every equation
    matrix okr = sumr(!ok(Yall)) .= 0
    loop i = 1..n
        okr = okr .* (sumr(!ok(XX[i])) .= 0)
    endloop
    if cols(Z)
        okr = okr .* (sumr(!ok(Z)) .= 0)
        Z = selifr(Z, okr)
    endif
    series evs_o = obs
    matrix tobs = selifr({evs_o}, okr)
    Yall = selifr(Yall, okr)
    scalar T = rows(Yall)
    # unique coefficient numbers -> columns of the stacked design
    matrix allc = {}
    loop i = 1..n
        XX[i] = selifr(XX[i], okr)
        allc ~= CC[i]
    endloop
    matrix cu = values(allc')'
    scalar p = cols(cu)
    matrix Xs = zeros(n * T, p)
    matrix kk = zeros(1, n)
    loop i = 1..n
        matrix ci = CC[i]
        kk[i] = cols(ci)
        loop j = 1..cols(ci)
            scalar col = imaxr(cu .= ci[j])
            scalar r1 = (i - 1) * T + 1
            scalar r2 = i * T
            matrix xij = XX[i]
            Xs[r1:r2, col] += xij[, j]
        endloop
    endloop
    matrix ys = vec(Yall)
    # instruments: project each equation's block
    matrix Xh = Xs
    if ivm
        matrix P = Z * inv(Z'Z) * Z'
        loop i = 1..n
            scalar r1 = (i - 1) * T + 1
            scalar r2 = i * T
            Xh[r1:r2, ] = P * Xs[r1:r2, ]
        endloop
    endif
    # first stage: equation by equation (OLS or 2SLS), with sandwich covariance
    matrix A = inv(Xh'Xs)
    matrix b = A * (Xh'ys)
    matrix E = mshape(ys - Xs * b, T, n)
    matrix S = E'E / T
    matrix V = {}
    if meth == "ls" || meth == "tsls"
        matrix dfa = sqrt((T - kk)' * (T - kk))
        matrix Sd = (E'E) ./ dfa
        V = A * Xh' * (Sd ** I(T)) * Xh * A'
    elif meth == "gmm"
        # two-step GMM, White weighting across equations and periods (EViews default):
        # moments (I_n ** Z)'(y - X b); S = sum_t (e_t ** z_t)'(e_t ** z_t)
        matrix Zb = I(n) ** Z
        matrix G = Zb' * Xs
        matrix gy = Zb' * ys
        scalar m = cols(Z)
        matrix Um = {}
        loop t = 1..T
            Um |= E[t,] ** Z[t,]
        endloop
        matrix Sg = ev__gmmS(Um, haclag)
        matrix Wg = inv(Sg)
        V = inv(G' * Wg * G)
        b = V * (G' * Wg * gy)
        E = mshape(ys - Xs * b, T, n)
        matrix gb = Zb' * vec(E)
        scalar Jst = qform(gb', Wg)
    else
        # SUR / 3SLS: Sigma from the first stage; WLS / weighted TSLS: variances only
        matrix Sw = (meth == "wls" || meth == "wtsls") ? I(n) .* S : S
        matrix Wi = inv(Sw) ** I(T)
        V = inv(Xh' * Wi * Xh)
        b = V * (Xh' * Wi * ys)
        E = mshape(ys - Xs * b, T, n)
    endif
    bundle bs
    bs.kind = "system"
    bs.method = meth
    if meth == "gmm"
        bs.weighting = haclag < 0 ? "White" : sprintf("HAC (Bartlett kernel, Newey-West lag %d)", ev__nwlag(T, haclag))
        bs.J = Jst
        bs.Jdf = n * cols(Z) - cols(b')
        bs.Jp = bs.Jdf > 0 ? pvalue(X, bs.Jdf, Jst) : NA
    endif
    bs.spec = "system"
    bs.coeff = b
    bs.vcv = V
    bs.stderr = sqrt(diag(V))
    bs.cnums = cu
    strings lab = array(0)
    loop j = 1..p
        lab += sprintf("C(%d)", cu[j])
    endloop
    bs.labels = lab
    bs.k = p
    bs.n = n
    bs.Tobs = T
    bs.T = n * T                 # total system observations (for Wald F df)
    bs.uhat = E
    bs.sigma_mat = E'E / T
    bs.detS = det(E'E / T)
    bs.tobs = tobs
    bs.sample = sprintf("%s %s", obslabel(minc(tobs)), obslabel(maxc(tobs)))
    bs.estdate = strftime($now[1], "%m/%d/%y   Time: %H:%M")
    bs.tstat = b ./ bs.stderr
    matrix pv = zeros(p, 1)
    loop j = 1..p
        pv[j] = 2 * pvalue(t, n * T - p, abs(bs.tstat[j]))
    endloop
    bs.pval = pv
    strings dl = array(0)
    loop i = 1..n
        dl += toupper(deps[i])
    endloop
    bs.deps = dl
    if exists(eqtext)
        bs.eqtext = eqtext
    else
        bs.eqtext = dl
    endif
    # per-equation statistics
    matrix st = {}
    loop i = 1..n
        matrix u = E[, i]
        matrix y = Yall[, i]
        matrix d = y - meanc(y)
        scalar ssr = u'u
        scalar r2 = 1 - ssr / (d'd)
        matrix du = u[2:T] - u[1:T-1]
        st |= {r2, 1 - (1 - r2) * (T - 1) / (T - kk[i]), sqrt(ssr / (T - kk[i])), (du'du) / ssr, meanc(y), sqrt(d'd / (T - 1)), ssr}
    endloop
    bs.eqstats = st
    if !quiet
        ev_sysprint(&bs)
    endif
    return bs
end function

function matrix ev__nlres (strings rhx, const matrix Y, const matrix mask, list vars, const matrix cu, const matrix c)
    # stacked residuals y_i - f_i(c) over the rows in mask
    set skip_missing off       # keep rows with missing values when making matrices
    loop j = 1..cols(cu)
        string pn = sprintf("evq_c%d", cu[j])
        scalar @pn = c[j]
    endloop
    matrix r = {}
    loop i = 1..nelem(rhx)
        string e = rhx[i]
        series evq_f = @e
        r |= selifr(Y[, i] - {evq_f}, mask)
    endloop
    return r
end function

function bundle ev_nlsystem (strings eqs "Explicit equations, e.g. y = c(1) + c(2)*x^c(3)",
                             list vars "Series used (e.g. dataset)",
                             string method[null] "ls, wls, sur, tsls, 3sls or gmm",
                             string inst[null] "Instruments (a constant is added)",
                             bool quiet[0],
                             int haclag[-1::-1] "GMM weighting: -1 White, 0 Newey-West automatic, k lag")
    # systems of equations that are nonlinear in the coefficients c(i):
    # Gauss-Newton on the (weighted) stacked residuals, numerical derivatives
    string meth = exists(method) ? tolower(method) : "ls"
    errorif(!instring(" ls wls sur tsls 3sls gmm ", " " ~ meth ~ " "), "method must be ls, wls, sur, tsls, 3sls or gmm")
    set skip_missing off
    scalar n = nelem(eqs)
    strings deps = array(0)
    strings rhx = array(0)
    strings rhs0 = array(0)
    matrix allc = {}
    matrix Y = {}
    loop i = 1..n
        strings sd = strsplit(eqs[i], "=")
        errorif(nelem(sd) != 2, sprintf("Equation %d needs one '='", i))
        string lhs = strstrip(sd[1])
        string rr = strstrip(sd[2])
        deps += toupper(lhs)
        rhs0 += rr
        series evq_y = ev_gen(lhs, vars)
        Y ~= {evq_y}
        string low = tolower(rr)
        loop k = 1..99
            if instring(low, sprintf("c(%d)", k))
                allc ~= k
            endif
        endloop
        rhx += ev__prep(regsub(rr, "(?i)(?<![A-Za-z0-9_])c\(([0-9]+)\)", "evq_c\1"), vars)
    endloop
    matrix cu = values(allc')'
    scalar p = cols(cu)
    errorif(p == 0, "No coefficients c(i) in the equations")
    # start: zeros (as EViews' C vector), rows complete at a small perturbation
    matrix c = 0.001 * ones(p, 1)
    loop j = 1..p
        string pn = sprintf("evq_c%d", cu[j])
        scalar @pn = c[j]
    endloop
    matrix F0 = {}
    loop i = 1..n
        string e = rhx[i]
        series evq_f = @e
        F0 ~= {evq_f}
    endloop
    matrix mask = (sumr(!ok(Y)) .= 0) .* (sumr(!ok(F0)) .= 0)
    matrix Z = {}
    if exists(inst) && strstrip(inst) != ""
        series evq_one = 1
        Z = {evq_one}
        strings zt = strsplit(inst)
        loop j = 1..nelem(zt)
            if tolower(zt[j]) != "c"
                series evq_z = ev_gen(zt[j], vars)
                Z ~= {evq_z}
            endif
        endloop
        mask = mask .* (sumr(!ok(Z)) .= 0)
        Z = selifr(Z, mask)
    endif
    scalar ivm = meth == "tsls" || meth == "3sls" || meth == "gmm"
    errorif(ivm && cols(Z) == 0, meth ~ " needs instruments")
    series evq_o = obs
    matrix tobs = selifr({evq_o}, mask)
    scalar T = rows(tobs)
    matrix P = ivm ? Z * inv(Z'Z) * Z' : I(T)
    # weighting of the stacked residuals
    matrix M = I(n) ** P
    scalar iters = 0
    scalar mu = 1e-3
    loop stage = 1..2
        loop it = 1..200
            matrix r = ev__nlres(rhx, Y, mask, vars, cu, c)
            matrix J = zeros(n * T, p)
            loop j = 1..p
                matrix ch = c
                scalar h = 1e-6 * (1 + abs(c[j]))
                ch[j] += h
                J[, j] = -(ev__nlres(rhx, Y, mask, vars, cu, ch) - r) / h
            endloop
            # Levenberg-Marquardt step: rejected steps are not applied
            matrix H = J' * M * J
            matrix gr = J' * M * r
            scalar obj = qform(r', M)
            scalar accepted = 0
            matrix step = zeros(p, 1)
            loop 40
                matrix stp = inv(H + mu * (I(p) .* H)) * gr
                matrix rn = ev__nlres(rhx, Y, mask, vars, cu, c + stp)
                rn = ok(rn) ? rn : 1e300     # undefined values make the step unacceptable
                if maxc(abs(rn)) < 1e150
                    if qform(rn', M) <= obj
                        accepted = 1
                        step = stp
                        mu = max(mu / 10, 1e-12)
                        break
                    endif
                endif
                mu = mu * 10
            endloop
            if !accepted
                break
            endif
            c = c + step
            iters++
            if maxc(abs(step) ./ (1 + abs(c))) < 1e-9
                break
            endif
        endloop
        matrix E = mshape(ev__nlres(rhx, Y, mask, vars, cu, c), T, n)
        if stage == 1
            # second stage weights for the system estimators
            if meth == "sur" || meth == "wls"
                matrix S = E'E / T
                S = meth == "wls" ? I(n) .* S : S
                M = inv(S) ** I(T)
            elif meth == "3sls"
                M = inv(E'E / T) ** P
            elif meth == "gmm"
                matrix Zb = I(n) ** Z
                matrix Um = {}
                loop t = 1..T
                    Um |= E[t,] ** Z[t,]
                endloop
                M = Zb * inv(ev__gmmS(Um, haclag)) * Zb'
            else
                break
            endif
        endif
    endloop
    # covariance
    matrix r = vec(E)
    matrix J = zeros(n * T, p)
    loop j = 1..p
        matrix ch = c
        scalar h = 1e-6 * (1 + abs(c[j]))
        ch[j] += h
        J[, j] = -(ev__nlres(rhx, Y, mask, vars, cu, ch) - r) / h
    endloop
    matrix kk = zeros(1, n)
    loop i = 1..n
        scalar ki = 0
        loop j = 1..p
            ki += instring(tolower(rhs0[i]), sprintf("c(%d)", cu[j])) > 0
        endloop
        kk[i] = ki
    endloop
    matrix A = inv(J' * M * J)
    matrix V = {}
    if meth == "ls" || meth == "tsls"
        matrix Sd = (E'E) ./ sqrt((T - kk)' * (T - kk))
        V = A * J' * M * (Sd ** I(T)) * M * J * A
    else
        V = A
    endif
    bundle bs
    bs.kind = "system"
    bs.nonlinear = 1
    bs.iters = iters
    bs.method = meth
    bs.spec = "system"
    if meth == "gmm"
        bs.weighting = haclag < 0 ? "White" : sprintf("HAC (Bartlett kernel, Newey-West lag %d)", ev__nwlag(T, haclag))
        matrix gb = (I(n) ** Z)' * r
        bs.J = qform(gb', inv(ev__gmmS(Um, haclag)))
        bs.Jdf = n * cols(Z) - p
        bs.Jp = bs.Jdf > 0 ? pvalue(X, bs.Jdf, bs.J) : NA
    endif
    bs.coeff = c
    bs.vcv = V
    bs.stderr = sqrt(diag(V))
    bs.cnums = cu
    strings lab = array(0)
    loop j = 1..p
        lab += sprintf("C(%d)", cu[j])
    endloop
    bs.labels = lab
    bs.k = p
    bs.n = n
    bs.Tobs = T
    bs.T = n * T
    bs.uhat = E
    bs.sigma_mat = E'E / T
    bs.detS = det(E'E / T)
    bs.tobs = tobs
    bs.sample = sprintf("%s %s", obslabel(minc(tobs)), obslabel(maxc(tobs)))
    bs.estdate = strftime($now[1], "%m/%d/%y   Time: %H:%M")
    bs.tstat = c ./ bs.stderr
    matrix pv = zeros(p, 1)
    loop j = 1..p
        pv[j] = 2 * pvalue(t, n * T - p, abs(bs.tstat[j]))
    endloop
    bs.pval = pv
    bs.deps = deps
    strings et = array(0)
    loop i = 1..n
        et += regsub(toupper(eqs[i]), "\s", "")
    endloop
    bs.eqtext = et
    matrix st = {}
    matrix Ys = selifr(Y, mask)
    loop i = 1..n
        matrix u = E[, i]
        matrix d = Ys[, i] - meanc(Ys[, i])
        scalar ssr = u'u
        scalar r2 = 1 - ssr / (d'd)
        matrix du = u[2:T] - u[1:T-1]
        st |= {r2, 1 - (1 - r2) * (T - 1) / (T - kk[i]), sqrt(ssr / (T - kk[i])), (du'du) / ssr, meanc(Ys[, i]), sqrt(d'd / (T - 1)), ssr}
    endloop
    bs.eqstats = st
    if !quiet
        ev_sysprint(&bs)
    endif
    return bs
end function

function void ev_sysprint (bundle *b)
    strings mkey = defarray("ls", "wls", "sur", "tsls", "wtsls", "3sls", "gmm", "fiml")
    strings mname = defarray("Least Squares", "Weighted Least Squares", "Seemingly Unrelated Regression", \
      "Two-Stage Least Squares", "Weighted Two-Stage Least Squares", "Three-Stage Least Squares", \
      "Generalized Method of Moments (two-step)", "Full Information Maximum Likelihood")
    scalar mi = instrings(mkey, b.method)[1]
    printf "\nSystem: %s\nEstimation Method: %s\nDate: %s\n", inbundle(b, "name") ? b.name : "UNTITLED", mname[mi], b.estdate
    if inbundle(b, "weighting")
        printf "Weighting matrix: %s\n", b.weighting
    endif
    if inbundle(b, "nonlinear")
        printf "Convergence achieved after %d iterations\n", b.iters
    endif
    printf "Sample: %s\nIncluded observations: %d\n", b.sample, b.Tobs
    printf "Total system (balanced) observations %d\n\n", b.T
    ev__line(78)
    printf "%-26s%13s%13s%14s%12s\n", "", "Coefficient", "Std. Error", "t-Statistic", "Prob."
    ev__line(78)
    loop j = 1..b.k
        printf "%-26s%13.6f%13.6f%14.6f%12.4f\n", b.labels[j], b.coeff[j], b.stderr[j], b.tstat[j], b.pval[j]
    endloop
    ev__line(78)
    printf "%-40s%16.6g\n", "Determinant residual covariance", b.detS
    if inbundle(b, "J")
        printf "%-40s%16.6f\n", "J-statistic", b.J
        if ok(b.Jp)
            printf "%-40s%16.4f  (df %d)\n", "Prob(J-statistic)", b.Jp, b.Jdf
        endif
    endif
    if inbundle(b, "lnl")
        printf "%-40s%16.6f\n", "Log likelihood", b.lnl
    endif
    ev__line(78)
    loop i = 1..b.n
        printf "\nEquation: %s\nObservations: %d\n", b.eqtext[i], b.Tobs
        matrix s = b.eqstats[i,]
        printf "%-22s%14.6f    %-24s%14.6f\n", "R-squared", s[1], "Mean dependent var", s[5]
        printf "%-22s%14.6f    %-24s%14.6f\n", "Adjusted R-squared", s[2], "S.D. dependent var", s[6]
        printf "%-22s%14.6f    %-24s%14.6f\n", "S.E. of regression", s[3], "Sum squared resid", s[7]
        printf "%-22s%14.6f\n", "Durbin-Watson stat", s[4]
        ev__line(78)
    endloop
end function

function bundle ev_sysfrom (string method "Estimator used, e.g. fiml",
                            matrix coef "$coeff of the estimated system",
                            matrix vcv "$vcv",
                            matrix U "$uhat",
                            matrix Yh "$yhat",
                            matrix pos "Position in coef of each coefficient number",
                            matrix cu "Coefficient numbers",
                            matrix kk "Regressors per equation",
                            strings deps, strings eqtext,
                            scalar t1, scalar lnl[NA], bool quiet[0])
    # EViews-style system result from an estimate made with gretl's system command
    scalar T = rows(U)
    scalar n = cols(U)
    bundle bs
    bs.kind = "system"
    bs.method = method
    bs.spec = "system"
    bs.coeff = coef[pos]
    bs.vcv = vcv[pos, pos]
    bs.stderr = sqrt(diag(bs.vcv))
    bs.cnums = cu
    strings lab = array(0)
    loop j = 1..cols(cu)
        lab += sprintf("C(%d)", cu[j])
    endloop
    bs.labels = lab
    scalar p = cols(cu)
    bs.k = p
    bs.n = n
    bs.Tobs = T
    bs.T = n * T
    bs.uhat = U
    bs.detS = det(U'U / T)
    bs.tobs = seq(t1, t1 + T - 1)'
    bs.sample = sprintf("%s %s", obslabel(t1), obslabel(t1 + T - 1))
    bs.estdate = strftime($now[1], "%m/%d/%y   Time: %H:%M")
    bs.tstat = bs.coeff ./ bs.stderr
    matrix pv = zeros(p, 1)
    loop j = 1..p
        pv[j] = 2 * pvalue(t, n * T - p, abs(bs.tstat[j]))
    endloop
    bs.pval = pv
    bs.deps = deps
    bs.eqtext = eqtext
    if ok(lnl)
        bs.lnl = lnl
    endif
    matrix st = {}
    matrix Y = Yh + U
    loop i = 1..n
        matrix u = U[, i]
        matrix d = Y[, i] - meanc(Y[, i])
        scalar ssr = u'u
        scalar r2 = 1 - ssr / (d'd)
        matrix du = u[2:T] - u[1:T-1]
        st |= {r2, 1 - (1 - r2) * (T - 1) / (T - kk[i]), sqrt(ssr / (T - kk[i])), (du'du) / ssr, meanc(Y[, i]), sqrt(d'd / (T - 1)), ssr}
    endloop
    bs.eqstats = st
    if !quiet
        ev_sysprint(&bs)
    endif
    return bs
end function

function series ev_sysresid (bundle b "ev_system result", int i[1::1] "Equation number")
    return ev__toseries(b.uhat[, i], b.tobs)
end function

# -------------------------------------------------------------------
# Vector error correction:  var v.ec(c, 1) 1 2 y1 y2
# -------------------------------------------------------------------

function bundle ev_vecm (string spec "Lag pairs of the differences, endogenous, then exogenous after the at-sign",
                         list vars "Series used (e.g. dataset)",
                         string tcase[null] "Trend case a, b, c (default), d or e",
                         int crank[1::1] "Number of cointegrating equations",
                         bool quiet[0],
                         string names[null] "Display names, space separated",
                         matrix Rr[null] "Restrictions on vec(beta): R",
                         matrix qr[null] "Restrictions on vec(beta): q")
    string AT = "@"
    string cs = exists(tcase) ? tolower(tcase) : "c"
    errorif(!instring(" a b c d e ", " " ~ cs ~ " "), "trend case must be a, b, c, d or e")
    strings LB = exists(names) ? strsplit(names) : array(0)
    strings parts = strsplit(spec, AT)
    strings L = strsplit(parts[1])
    matrix lagv = {}
    scalar i0 = 1
    loop while i0 + 1 <= nelem(L) && regsub(L[i0], "^[0-9]+$", "") == "" && regsub(L[i0+1], "^[0-9]+$", "") == ""
        lagv ~= seq(atof(L[i0]), atof(L[i0+1]))
        i0 += 2
    endloop
    errorif(cols(lagv) == 0, "Start with lag pairs for the differences, e.g. 1 2")
    lagv = values(lagv')'
    errorif(lagv[1] != 1 || maxr(lagv) != cols(lagv), "VEC lags must run from 1 without gaps, e.g. 1 2")
    scalar order = maxr(lagv) + 1          # gretl's order counts lags in levels
    list Y = null
    strings ylab = array(0)
    strings ytok = array(0)
    loop i = i0..nelem(L)
        matrix pp = instrings(varnames(vars), L[i])
        if rows(pp) > 0
            list Y += vars[pp[1]]
        else
            string v = sprintf("evc_y%d", i)
            series @v = ev_gen(L[i], vars)
            list Y += @v
        endif
        scalar li = nelem(ytok) + 1
        ylab += nelem(LB) >= li ? toupper(LB[li]) : toupper(L[i])
        ytok += L[i]
    endloop
    errorif(crank < 1 || crank >= nelem(Y), "rank must be between 1 and the number of variables minus 1")
    list X = null
    strings xlab = array(0)
    if nelem(parts) == 2
        strings R = strsplit(parts[2])
        loop i = 1..nelem(R)
            if tolower(R[i]) != "c"
                matrix pp = instrings(varnames(vars), R[i])
                if rows(pp) > 0
                    list X += vars[pp[1]]
                else
                    string v = sprintf("evc_x%d", i)
                    series @v = ev_gen(R[i], vars)
                    list X += @v
                endif
                xlab += toupper(R[i])
            endif
        endloop
    endif
    string opt = cs == "a" ? "--nc" : (cs == "b" ? "--rc" : (cs == "c" ? "--uc" : (cs == "d" ? "--crt" : "--ct")))
    scalar n0 = $nobs
    if nelem(X) > 0
        vecm order crank Y ; X --silent @opt
    else
        vecm order crank Y --silent @opt
    endif
    scalar lr_r = NA
    scalar lr_p = NA
    if exists(Rr)
        restrict --full --silent
            R = Rr
            q = qr
        end restrict
        catch lr_r = $test
        catch lr_p = $pvalue
    endif
    bundle sys = $system
    bundle b
    b.kind = "vecm"
    if exists(Rr)
        b.lr_restr = lr_r
        b.lr_restr_p = lr_p
    endif
    b.spec = spec
    b.case = cs
    b.rank = crank
    b.sys = sys
    b.ylab = ylab
    b.xlab = xlab
    b.ytok = ytok
    strings noxt = array(0)
    b.xtok = noxt
    b.lags = lagv
    b.hasc = cs == "c" || cs == "d" || cs == "e"
    b.n = nelem(Y)
    b.T = sys.T
    b.coeff = $coeff
    b.se = $stderr
    b.tstat = b.coeff ./ b.se
    b.beta = $jbeta
    b.alpha = $jalpha
    b.beta_se = sqrt(abs(diag($jvbeta)))
    b.k = rows(b.coeff)
    b.adjusted = sys.T < n0
    b.sample = sprintf("%s %s", obslabel(sys.t1), obslabel(sys.t2))
    b.estdate = strftime($now[1], "%m/%d/%y   Time: %H:%M")
    b.lnl = $lnl
    b.aic = -2 * b.lnl / b.T + 2 * (b.n * b.k) / b.T
    b.sc = -2 * b.lnl / b.T + (b.n * b.k) * log(b.T) / b.T
    matrix E = sys.uhat
    b.det = det(E'E / b.T)
    # gretl order: const, lagged differences, exogenous, trend, EC terms
    strings clab = array(0)
    if b.hasc
        clab += "C"
    endif
    loop j = 1..b.n
        loop l = 1..cols(lagv)
            clab += sprintf("D(%s(-%d))", ylab[j], lagv[l])
        endloop
    endloop
    loop j = 1..nelem(xlab)
        clab += xlab[j]
    endloop
    if cs == "e"
        clab += "@TREND"
    endif
    loop r = 1..crank
        clab += sprintf("CointEq%d", r)
    endloop
    errorif(nelem(clab) != b.k, sprintf("Internal error: %d labels for %d coefficients", nelem(clab), b.k))
    b.clab = clab
    if !quiet
        ev_vecprint(&b)
    endif
    return b
end function

function void ev_vecprint (bundle *b)
    scalar n = b.n
    printf "\nVector Error Correction Estimates\nDate: %s\n", b.estdate
    printf "Sample%s: %s\n", b.adjusted ? " (adjusted)" : "", b.sample
    printf "Included observations: %d%s\n", b.T, b.adjusted ? " after adjustments" : ""
    printf "Standard errors in ( ) & t-statistics in [ ]\n\n"
    scalar w = 22 + 16 * max(n, b.rank)
    ev__line(w)
    printf "%-22s", "Cointegrating Eq:"
    loop r = 1..b.rank
        printf "%16s", sprintf("CointEq%d", r)
    endloop
    printf "\n"
    ev__line(w)
    scalar nb = rows(b.beta)
    loop i = 1..nb
        string nm = i <= n ? sprintf("%s(-1)", b.ylab[i]) : (b.case == "b" ? "C" : "@TREND(-1)")
        printf "%-22s", nm
        loop r = 1..b.rank
            printf "%16.6f", b.beta[i, r]
        endloop
        printf "\n"
        # gretl gives the variance of the freely estimated elements only
        scalar fi = (i - b.rank - 1) * b.rank + 1
        if i > b.rank && rows(b.beta_se) >= fi + b.rank - 1
            printf "%-22s", ""
            loop r = 1..b.rank
                printf "%16s", sprintf("(%.5f)", b.beta_se[fi + r - 1])
            endloop
            printf "\n%-22s", ""
            loop r = 1..b.rank
                printf "%16s", sprintf("[%.5f]", b.beta[i, r] / b.beta_se[fi + r - 1])
            endloop
            printf "\n"
        endif
    endloop
    printf "\n"
    ev__line(w)
    printf "%-22s", "Error Correction:"
    loop j = 1..n
        printf "%16s", sprintf("D(%s)", b.ylab[j])
    endloop
    printf "\n"
    ev__line(w)
    # EViews order: CointEq, lagged differences, C, exogenous
    scalar k = b.k
    matrix ord = seq(k - b.rank + 1, k)
    scalar c0 = b.hasc ? 2 : 1
    scalar nl = n * cols(b.lags)
    ord ~= seq(c0, c0 + nl - 1)
    if b.hasc
        ord ~= 1
    endif
    if k - b.rank >= c0 + nl
        ord ~= seq(c0 + nl, k - b.rank)
    endif
    loop r = 1..cols(ord)
        scalar i = ord[r]
        printf "%-22s", b.clab[i]
        loop j = 1..n
            printf "%16.6f", b.coeff[i, j]
        endloop
        printf "\n%-22s", ""
        loop j = 1..n
            printf "%16s", sprintf("(%.5f)", b.se[i, j])
        endloop
        printf "\n%-22s", ""
        loop j = 1..n
            printf "%16s", sprintf("[%.5f]", b.tstat[i, j])
        endloop
        printf "\n\n"
    endloop
    ev__line(w)
    printf "%-44s%16.6g\n", "Determinant resid covariance", b.det
    printf "%-44s%16.6f\n", "Log likelihood", b.lnl
    printf "%-44s%16.6f\n", "Akaike information criterion", b.aic
    printf "%-44s%16.6f\n", "Schwarz criterion", b.sc
    ev__line(w)
end function

function void ev_coint (string names "Endogenous series, e.g. y1 y2",
                        list vars "Series used (e.g. dataset)",
                        string tcase[null] "Trend case a, b, c (default), d or e",
                        int nlag[1::4] "Lags of the differences")
    # Johansen cointegration test (gretl's coint2)
    string cs = exists(tcase) ? tolower(tcase) : "c"
    string opt = cs == "a" ? "--nc" : (cs == "b" ? "--rc" : (cs == "c" ? "" : (cs == "d" ? "--crt" : "--ct")))
    list Y = null
    strings L = strsplit(names)
    loop i = 1..nelem(L)
        matrix pp = instrings(varnames(vars), L[i])
        errorif(rows(pp) == 0, sprintf("%s: use series names for the Johansen test", L[i]))
        list Y += vars[pp[1]]
    endloop
    scalar order = nlag + 1
    printf "\nJohansen Cointegration Test\nSeries: %s\nLags interval (in first differences): 1 to %d\n", toupper(names), nlag
    coint2 order Y @opt
end function

# -------------------------------------------------------------------
# Structural VAR: A e = B u, E[uu'] = I   (v.svar)
# -------------------------------------------------------------------

function matrix ev__psi (bundle sys, int n, int h)
    # MA matrices Psi_0 .. Psi_{h-1} side by side (n x n*h), from the companion form
    matrix A = sys.A
    matrix P = I(rows(A))
    matrix out = {}
    loop j = 1..h
        out ~= P[1:n, 1:n]
        P = A * P
    endloop
    return out
end function

function matrix ev__fill (matrix P, const matrix idx, const matrix vals)
    # P with the elements at positions idx (column-major) set to vals
    scalar nr = rows(P)
    loop i = 1..rows(idx)
        scalar r = (idx[i] - 1) % nr + 1
        scalar c = int((idx[i] - 1) / nr) + 1
        P[r, c] = vals[i]
    endloop
    return P
end function

function matrix ev__pick (const matrix P, const matrix idx)
    matrix out = zeros(rows(idx), 1)
    scalar nr = rows(P)
    loop i = 1..rows(idx)
        scalar r = (idx[i] - 1) % nr + 1
        scalar c = int((idx[i] - 1) / nr) + 1
        out[i] = P[r, c]
    endloop
    return out
end function

function scalar ev__svar_ll (matrix th, const matrix Ap, const matrix Bp, const matrix S, scalar T)
    matrix A = Ap
    matrix B = Bp
    scalar na = sum(!ok(vec(Ap)))
    matrix ia = selifr(seq(1, rows(vec(Ap)))', !ok(vec(Ap)))
    matrix ib = selifr(seq(1, rows(vec(Bp)))', !ok(vec(Bp)))
    if na
        A = ev__fill(A, ia, th[1:na])
    endif
    if rows(ib)
        B = ev__fill(B, ib, th[na+1:na+rows(ib)])
    endif
    scalar n = rows(A)
    scalar dA = det(A)
    scalar dB = det(B)
    if abs(dA) < 1e-12 || abs(dB) < 1e-12
        return -1e10
    endif
    return -T * n / 2 * log(2 * $pi) + T * log(abs(dA)) - T * log(abs(dB)) \
      - T / 2 * tr(A' * inv(B * B') * A * S)
end function

function void ev_svar (bundle *v "VAR result (ev_varest)",
                       matrix Apat "Pattern of A: numbers are fixed, NA are estimated",
                       matrix Bpat "Pattern of B: numbers are fixed, NA are estimated",
                       bool quiet[0])
    errorif(!inbundle(v, "sys"), "First argument must be a VAR")
    scalar n = v.n
    errorif(rows(Apat) != n || cols(Apat) != n || rows(Bpat) != n || cols(Bpat) != n, \
      sprintf("A and B must be %d x %d", n, n))
    matrix E = v.sys.uhat
    scalar T = rows(E)
    matrix S = E'E / T
    scalar na = sum(!ok(vec(Apat)))
    scalar nb = sum(!ok(vec(Bpat)))
    scalar nf = na + nb
    errorif(nf > n * (n + 1) / 2, sprintf("Too many free parameters (%d) for %d equations: at most %d", nf, n, n * (n + 1) / 2))
    # starting values: A free -> 0 off the diagonal, 1 on it; B free -> sqrt of variances
    matrix th = zeros(nf, 1)
    matrix ia = selifr(seq(1, n * n)', !ok(vec(Apat)))
    matrix ib = selifr(seq(1, n * n)', !ok(vec(Bpat)))
    loop i = 1..na
        th[i] = (ia[i] - 1) % (n + 1) == 0 ? 1 : 0
    endloop
    loop i = 1..nb
        scalar d = (ib[i] - 1) % (n + 1) == 0
        th[na + i] = d ? sqrt(S[(ib[i] - 1) / (n + 1) + 1, (ib[i] - 1) / (n + 1) + 1]) : 0.1
    endloop
    set max_verbose off
    scalar ll = BFGSmax(&th, ev__svar_ll(th, Apat, Bpat, S, T))
    matrix H = fdjac(th, ev__svar_grad(th, Apat, Bpat, S, T))
    matrix V = inv(-0.5 * (H + H'))
    matrix A = Apat
    matrix B = Bpat
    if na
        A = ev__fill(A, ia, th[1:na])
    endif
    if nb
        B = ev__fill(B, ib, th[na+1:nf])
    endif
    # normalise signs: positive impact of each shock on its own variable
    matrix Sim = inv(A) * B
    matrix sg = sgn(diag(Sim))'
    sg = sg + (sg .= 0)
    B = B .* sg
    Sim = inv(A) * B
    if nb
        th[na+1:nf] = ev__pick(B, ib)
    endif
    v.svarA = A
    v.svarB = B
    v.svarS = Sim
    v.svar_type = "short-run pattern (A e = B u)"
    v.svar_coef = th
    v.svar_se = sqrt(abs(diag(V)))
    v.svar_lnl = ll
    scalar llu = -T * n / 2 * (log(2 * $pi) + 1) - T / 2 * log(det(S))
    v.svar_df = n * (n + 1) / 2 - nf
    v.svar_lr = 2 * (llu - ll)
    v.svar_lrp = v.svar_df > 0 ? pvalue(X, v.svar_df, v.svar_lr) : NA
    if !quiet
        ev_svarprint(&v)
    endif
end function

function matrix ev__svar_grad (matrix th, const matrix Ap, const matrix Bp, const matrix S, scalar T)
    # numerical gradient of the log likelihood (used for the Hessian)
    matrix g = zeros(rows(th), 1)
    loop i = 1..rows(th)
        scalar h = 1e-5 * (1 + abs(th[i]))
        matrix t1 = th
        matrix t2 = th
        t1[i] += h
        t2[i] -= h
        g[i] = (ev__svar_ll(t1, Ap, Bp, S, T) - ev__svar_ll(t2, Ap, Bp, S, T)) / (2 * h)
    endloop
    return g
end function

function void ev_svar_lr (bundle *v "VAR result (ev_varest)", bool quiet[0],
                          matrix order[null] "Recursive ordering of the variables for the long-run zeros")
    # long-run (Blanchard-Quah) identification: the accumulated response of
    # variable i to shock j is zero for j > i
    errorif(!inbundle(v, "sys") || (inbundle(v, "kind") && v.kind == "vecm"), "Long-run restrictions need a VAR in stationary variables")
    scalar n = v.n
    matrix E = v.sys.uhat
    scalar T = rows(E)
    matrix S = E'E / T
    matrix A = v.sys.A
    scalar p = cols(A) / n
    matrix sumA = zeros(n, n)
    loop l = 1..p
        sumA += A[1:n, (l - 1) * n + 1:l * n]
    endloop
    matrix C1 = inv(I(n) - sumA)
    matrix perm = seq(1, n)
    if exists(order)
        perm = vec(order)'
    endif
    errorif(cols(perm) != n, "order must list every variable once")
    # Cholesky of the long-run covariance in the given ordering, mapped back
    matrix C1p = C1[perm, perm]
    matrix Lp = cholesky(C1p * S[perm, perm] * C1p')
    matrix Sp = inv(C1p) * Lp
    matrix Sim = zeros(n, n)
    matrix L = zeros(n, n)
    loop i = 1..n
        scalar pi = perm[i]
        loop j = 1..n
            scalar pj = perm[j]
            Sim[pi, pj] = Sp[i, j]
            L[pi, pj] = Lp[i, j]
        endloop
    endloop
    v.svarS = Sim
    v.svarA = I(n)
    v.svarB = v.svarS
    v.svar_lrmat = L
    v.svar_type = "long-run (Blanchard-Quah)"
    if !quiet
        ev_svarprint(&v)
    endif
end function

function void ev_svarprint (bundle *v)
    printf "\nStructural VAR Estimates\nSample: %s\nIncluded observations: %d\n", v.sample, v.T
    printf "Restriction type: %s\nModel: Ae = Bu where E[uu']=I\n", v.svar_type
    scalar n = v.n
    if inbundle(v, "svar_coef")
        ev__line(70)
        printf "%-14s%14s%14s%14s%12s\n", "", "Coefficient", "Std. Error", "z-Statistic", "Prob."
        ev__line(70)
        loop i = 1..rows(v.svar_coef)
            scalar z = v.svar_coef[i] / v.svar_se[i]
            printf "%-14s%14.6f%14.6f%14.6f%12.4f\n", sprintf("C(%d)", i), v.svar_coef[i], v.svar_se[i], z, 2 * pvalue(z, abs(z))
        endloop
        ev__line(70)
        printf "%-30s%16.6f\n", "Log likelihood", v.svar_lnl
        if v.svar_df > 0
            printf "LR test for over-identification:\nChi-square(%d)%17.6f      Probability %.4f\n", v.svar_df, v.svar_lr, v.svar_lrp
        endif
        ev__line(70)
    endif
    printf "Estimated A matrix:\n"
    printf "%14.6f", v.svarA
    printf "Estimated B matrix:\n"
    printf "%14.6f", v.svarB
    printf "Impact of the structural shocks (inverse(A) * B):\n"
    printf "%14.6f", v.svarS
    if inbundle(v, "svar_lrmat")
        printf "Long-run response (lower triangular):\n"
        printf "%14.6f", v.svar_lrmat
    endif
end function

# -------------------------------------------------------------------
# Model objects: solve estimated equations and identities together
# -------------------------------------------------------------------

function series ev__genm (string expr, list vars, strings bases, const matrix D,
                          strings ovr[null], string suf[null])
    # evaluate expr with each series bases[k] shifted by D[,k] (lags included);
    # series named in ovr are replaced by their scenario versions name + suf
    string e = ev__prep(expr, vars)
    if exists(ovr)
        loop k = 1..nelem(ovr)
            e = regsub(e, "vars\." ~ ovr[k] ~ "(?![A-Za-z0-9_])", "vars." ~ ovr[k] ~ suf)
        endloop
    endif
    loop k = 1..nelem(bases)
        string dn = sprintf("evm_d%d", k)
        series @dn = D[, k]
        e = regsub(e, "vars\." ~ bases[k] ~ "(\(-?[0-9]+\))?(?![A-Za-z0-9_])", \
          "(vars." ~ bases[k] ~ "\1 + misszero(" ~ dn ~ "\1))")
    endloop
    series evm_out = @e
    return evm_out
end function

function matrix ev__mg (bundle C, list vars, scalar t, matrix x, matrix D, const matrix Sol, const matrix AF)
    # one evaluation of every model equation in period t, given the levels x of
    # the endogenous variables in t; returns the implied levels
    scalar m = C.m
    loop k = 1..m
        D[t, k] = ok(C.L[t, k]) ? x[k] - C.L[t, k] : 0
    endloop
    scalar st = C.tobs[t]
    matrix g = mshape(NA, 1, m)
    loop k = 1..m
        scalar v = NA
        if k <= C.ne && C.rhs[k] == ""
            bundle b = C.eqs[k]
            matrix XX = C.XX[k]
            matrix xr = XX[t,]
            matrix u = C.uses[k]
            strings tok = strsplit(b.spec)
            loop i = 1..cols(xr)
                if u[i]
                    series evm_c = ev__genm(tok[i+1], vars, C.bases, D, C.ovr, C.suf)
                    xr[i] = evm_c[st]
                endif
            endloop
            v = xr * b.coeff
        else
            series evm_c = ev__genm(C.rhs[k], vars, C.bases, D, C.ovr, C.suf)
            v = evm_c[st]
        endif
        v += AF[t, k]          # add factor and/or stochastic shock
        scalar prev = (C.dynamic && t > 1) ? Sol[t - 1, k] : C.Lp[t, k]
        scalar f = C.forms[k]
        g[k] = f == 0 ? v : (f == 1 ? exp(v) : (f == 2 ? prev + v : prev * exp(v)))
    endloop
    return g
end function

function matrix ev__msolve (bundle C, list vars, const matrix AF, matrix Sol, scalar *maxit, scalar *unconverged)
    # period-by-period damped Newton solution of x = G(x)
    scalar T = rows(Sol)
    scalar m = C.m
    matrix L = C.L
    matrix D = zeros(T, m)
    maxit = 0
    unconverged = 0
    loop t = 1..T
        if !C.dynamic
            D = zeros(T, m)
        endif
        matrix x = Sol[t,]
        scalar conv = 0
        loop it = 1..100
            matrix g = ev__mg(C, vars, t, x, D, Sol, AF)
            matrix F = x - g
            if sum(!ok(F))
                break
            endif
            if maxr(abs(F) ./ (1 + abs(x))) < 1e-8      # EViews default convergence
                conv = 1
                maxit = max(maxit, it)
                break
            endif
            matrix J = I(m)
            loop k = 1..m
                matrix xh = x
                scalar h = 1e-6 * (1 + abs(x[k]))
                xh[k] += h
                matrix gh = ev__mg(C, vars, t, xh, D, Sol, AF)
                J[, k] = J[, k] - ((gh - g) / h)'
            endloop
            matrix dx = (inv(J) * F')'
            scalar nF = maxr(abs(F) ./ (1 + abs(x)))
            scalar lam = 1
            loop 30
                matrix xt = x - lam * dx
                matrix gt = ev__mg(C, vars, t, xt, D, Sol, AF)
                matrix Ft = xt - gt
                if sum(!ok(Ft)) == 0
                    if maxr(abs(Ft) ./ (1 + abs(xt))) < nF
                        break
                    endif
                endif
                lam = lam / 2
            endloop
            x = xt
        endloop
        unconverged += !conv
        Sol[t,] = x
        loop k = 1..m
            D[t, k] = ok(L[t, k]) ? x[k] - L[t, k] : 0
        endloop
    endloop
    return Sol
end function

function series ev_eqres (bundle b "Estimated equation (ev_ls result)", list vars "Series used (e.g. dataset)")
    # residual of an equation over the current sample, in the units of its
    # left-hand side (used to initialise model add factors)
    string kind = inbundle(b, "kind") ? b.kind : "ls"
    errorif(kind != "ls" && kind != "nls", "Least squares or explicit equations only")
    if kind == "nls"
        series evr_y = ev_gen(b.lhs, vars)
        string r = b.rhs
        loop j = 1..b.k
            r = regsub(r, sprintf("evn_c%d(?![0-9])", b.cidx[j]), sprintf("(%.17g)", b.coeff[j]))
        endloop
        series evr_f = ev_gen(r, vars)
        return evr_y - evr_f
    endif
    strings tok = strsplit(b.spec)
    series evr_y = ev_gen(tok[1], vars)
    series evr_f = 0
    loop i = 2..nelem(tok)
        if tolower(tok[i]) == "c"
            evr_f += b.coeff[i-1]
        else
            series evr_x = ev_gen(tok[i], vars)
            evr_f += b.coeff[i-1] * evr_x
        endif
    endloop
    return evr_y - evr_f
end function

function bundle ev_modelsolve (bundles eqs "Estimated equations (ev_ls results)",
                               strings idents "Identities, e.g. Y = C + I + G",
                               list vars "Series used (e.g. dataset)",
                               bool dynamic[1] "Dynamic (1) or static (0) solution",
                               bool quiet[0],
                               bundle opts[null] "overrides (strings), suffix, addfactors (1/0), reps, seed")
    scalar ne = nelem(eqs)
    scalar m = ne + nelem(idents)
    errorif(m == 0, "The model has no equations")
    strings bases = array(0)
    matrix forms = zeros(1, m)
    strings rhs = array(0)          # expression to evaluate (identities and NLS)
    matrices XX = array(m)
    matrices uses = array(m)
    loop k = 1..m
        string dep = ""
        if k <= ne
            bundle b = eqs[k]
            string kind = inbundle(b, "kind") ? b.kind : "ls"
            errorif(kind != "ls" && kind != "nls", "Models can use least squares and explicit (NLS) equations")
            if kind == "nls"
                dep = b.lhs
                string r = b.rhs
                loop j = 1..b.k
                    r = regsub(r, sprintf("evn_c%d(?![0-9])", b.cidx[j]), sprintf("(%.17g)", b.coeff[j]))
                endloop
                rhs += r
            else
                dep = strsplit(b.spec)[1]
                rhs += ""
            endif
        else
            strings sd = strsplit(idents[k - ne], "=")
            errorif(nelem(sd) != 2, sprintf("Identity '%s' needs one '='", idents[k - ne]))
            dep = strstrip(sd[1])
            rhs += strstrip(sd[2])
        endif
        string bs = ""
        forms[k] = ev__depform(dep, &bs, vars)
        errorif(forms[k] < 0, sprintf("'%s': the left-hand side must be Y, log(Y), d(Y) or dlog(Y) of a series", dep))
        errorif(rows(instrings(bases, bs)) > 0, sprintf("%s is determined by two equations", bs))
        bases += bs
    endloop
    # regressors of least-squares equations; which terms involve endogenous variables
    loop k = 1..ne
        bundle b = eqs[k]
        if !inbundle(b, "kind") || b.kind == "ls"
            strings tok = strsplit(b.spec)
            matrix X = {}
            matrix u = {}
            loop i = 2..nelem(tok)
                if tolower(tok[i]) == "c"
                    series evm_r = 1
                    u ~= 0
                else
                    series evm_r = ev_gen(tok[i], vars)
                    scalar f = 0
                    loop j = 1..m
                        f = f || regsub(tok[i], "(?i)(?<![A-Za-z0-9_])" ~ bases[j] ~ "(?![A-Za-z0-9_])", "#") != tok[i]
                    endloop
                    u ~= f
                endif
                X ~= {evm_r}
            endloop
            XX[k] = X
            uses[k] = u
        endif
    endloop
    # actual levels and their previous values
    matrix L = {}
    matrix Lp = {}
    loop k = 1..m
        string e1 = "vars." ~ bases[k]
        string e2 = "vars." ~ bases[k] ~ "(-1)"
        series evm_a = @e1
        series evm_ap = @e2
        L ~= {evm_a}
        Lp ~= {evm_ap}
    endloop
    series evm_o = obs
    matrix tobs = {evm_o}
    scalar T = rows(L)
    matrix Sol = L
    loop i = 1..T
        loop k = 1..m
            if !ok(Sol[i, k])
                Sol[i, k] = Lp[i, k]
            endif
        endloop
    endloop
    matrix D = zeros(T, m)
    bundle C
    C.eqs = eqs
    C.rhs = rhs
    C.XX = XX
    C.uses = uses
    C.forms = forms
    C.bases = bases
    C.L = L
    C.Lp = Lp
    C.tobs = tobs
    C.ne = ne
    C.m = m
    C.dynamic = dynamic
    # options: scenario overrides, add factors, stochastic simulation
    strings ovr = array(0)
    string suf = "_0"
    scalar use_af = 0
    scalar reps = 0
    if exists(opts)
        if inbundle(opts, "overrides")
            ovr = opts.overrides
        endif
        suf = inbundle(opts, "suffix") ? opts.suffix : (nelem(ovr) ? "_1" : "_0")
        use_af = inbundle(opts, "addfactors") ? opts.addfactors : 0
        reps = inbundle(opts, "reps") ? opts.reps : 0
        if inbundle(opts, "seed")
            set seed opts.seed
        endif
    endif
    loop k = 1..nelem(ovr)
        errorif(rows(instrings(varnames(vars), ovr[k] ~ suf)) == 0, \
          sprintf("Override series %s%s does not exist", ovr[k], suf))
        errorif(rows(instrings(bases, ovr[k])) > 0, sprintf("%s is endogenous and cannot be overridden", ovr[k]))
    endloop
    C.ovr = ovr
    C.suf = suf
    # regressors that use an overridden series must be recomputed in each period
    matrices UU = C.uses
    loop k = 1..ne
        if C.rhs[k] == ""
            bundle b = eqs[k]
            strings tok = strsplit(b.spec)
            matrix u = UU[k]
            loop i = 2..nelem(tok)
                loop j = 1..nelem(ovr)
                    if regsub(tok[i], "(?i)(?<![A-Za-z0-9_])" ~ ovr[j] ~ "(?![A-Za-z0-9_])", "#") != tok[i]
                        u[i-1] = 1
                    endif
                endloop
            endloop
            UU[k] = u
        endif
    endloop
    C.uses = UU
    # add factors: series <endogenous>_a, in the units of each equation's left-hand side
    matrix AF = zeros(T, m)
    if use_af
        loop k = 1..m
            matrix pp = instrings(varnames(vars), bases[k] ~ "_a")
            if rows(pp) > 0
                series evm_af = vars[pp[1]]
                AF[, k] = misszero({evm_af})
            endif
        endloop
    endif
    scalar maxit = 0
    scalar unconverged = 0
    Sol = ev__msolve(C, vars, AF, Sol, &maxit, &unconverged)
    # stochastic simulation: normal shocks with each equation's S.E. of regression
    matrix smean = {}
    matrix ssd = {}
    if reps > 0
        matrix sig = zeros(1, m)
        loop k = 1..ne
            bundle b = eqs[k]
            sig[k] = b.sigma
        endloop
        matrix s1 = zeros(T, m)
        matrix s2 = zeros(T, m)
        loop rr = 1..reps
            matrix sh = mnormal(T, m) .* sig
            scalar mi = 0
            scalar un = 0
            matrix Sr = ev__msolve(C, vars, AF + sh, Sol, &mi, &un)
            s1 += Sr
            s2 += Sr.^2
        endloop
        smean = s1 / reps
        ssd = sqrt(abs(s2 / reps - smean.^2) * reps / (reps - 1))
    endif
    bundle ms
    ms.kind = "model"
    ms.suffix = suf
    ms.reps = reps
    if reps > 0
        ms.mean = smean
        ms.sd = ssd
    endif
    ms.names = bases
    ms.sol = Sol
    ms.actual = L
    ms.tobs = tobs
    ms.dynamic = dynamic
    ms.maxit = maxit
    ms.unconverged = unconverged
    ms.sample = sprintf("%s %s", obslabel($t1), obslabel($t2))
    if !quiet
        printf "\nModel solution\nSolver: Newton, %s\nSample: %s\n", dynamic ? "dynamic solution" : "static solution", ms.sample
        if nelem(ovr)
            printf "Scenario: overrides"
            loop k = 1..nelem(ovr)
                printf " %s -> %s%s", toupper(ovr[k]), toupper(ovr[k]), suf
            endloop
            printf "\n"
        endif
        if use_af
            printf "Add factors: series <variable>_a\n"
        endif
        if reps > 0
            printf "Stochastic simulation: %d repetitions (mean %sm, std. dev. %ss)\n", reps, suf, suf
        endif
        printf "Endogenous variables (solution series get the suffix %s):", suf
        loop k = 1..m
            printf " %s", toupper(bases[k])
        endloop
        printf "\n"
        if unconverged
            printf "Warning: %d period(s) did not converge in 100 iterations\n", unconverged
        else
            printf "Converged in at most %d iterations per period\n", maxit
        endif
        matrix ok2 = ok(L) .* ok(Sol)
        printf "\n%-16s%16s%16s\n", "Variable", "RMSE", "Mean abs. % err"
        loop k = 1..m
            matrix a = selifr(L[, k], ok2[, k])
            matrix s2 = selifr(Sol[, k], ok2[, k])
            printf "%-16s%16.6f%16.4f\n", toupper(bases[k]), sqrt(meanc((s2 - a).^2)), 100 * meanc(abs((s2 - a) ./ a))
        endloop
    endif
    return ms
end function

function series ev_modelseries (bundle ms "ev_modelsolve result", int k[1::1] "Endogenous variable number",
                                string what[null] "empty: solution; mean or sd: stochastic simulation")
    string w = exists(what) ? tolower(what) : ""
    if w == "mean"
        return ev__toseries(ms.mean[, k], ms.tobs)
    elif w == "sd"
        return ev__toseries(ms.sd[, k], ms.tobs)
    endif
    return ev__toseries(ms.sol[, k], ms.tobs)
end function

# -------------------------------------------------------------------
# ARCH family (eq.arch): GARCH, TARCH (GJR) and EGARCH, via the gig package
# -------------------------------------------------------------------

function matrix ev__garchh (const matrix th, const matrix y, const matrix XM, scalar eg,
                            scalar nm, scalar na, scalar nt, scalar ng, scalar mt, scalar h0)
    # conditional variance recursion of the ARCH family (EViews form);
    # th = [lambda (ARCH-M only), mean coefficients, omega, alpha, gamma, beta]
    # returns [log-likelihood_t, residual_t, h_t]
    scalar T = rows(y)
    scalar off = mt > 0
    scalar lam = 0
    if mt > 0
        lam = th[1]
    endif
    matrix mu = zeros(T, 1)
    if nm > 0
        mu = XM * th[off + 1:off + nm]
    endif
    scalar p0 = off + nm
    scalar w = th[p0 + 1]
    matrix e = zeros(T, 1)
    matrix h = zeros(T, 1)
    matrix ll = zeros(T, 1)
    scalar lh0 = log(h0)
    scalar az0 = sqrt(2 / $pi)
    loop t = 1..T
        scalar ht = w
        loop i = 1..na
            scalar a = th[p0 + 1 + i]
            scalar s = t - i
            if eg
                ht += s >= 1 ? a * abs(e[s]) / sqrt(h[s]) : a * az0
            else
                ht += s >= 1 ? a * e[s]^2 : a * h0
            endif
        endloop
        loop k = 1..nt
            scalar g = th[p0 + 1 + na + k]
            scalar s = t - k
            if eg
                ht += s >= 1 ? g * e[s] / sqrt(h[s]) : 0
            else
                ht += s >= 1 ? g * e[s]^2 * (e[s] < 0) : g * h0 / 2
            endif
        endloop
        loop j = 1..ng
            scalar bb = th[p0 + 1 + na + nt + j]
            scalar s = t - j
            if eg
                ht += s >= 1 ? bb * log(h[s]) : bb * lh0
            else
                ht += s >= 1 ? bb * h[s] : bb * h0
            endif
        endloop
        scalar hv = eg ? exp(ht) : ht
        if !ok(hv) || hv <= 0
            return mshape(NA, T, 3)
        endif
        h[t] = hv
        scalar gm = 0
        if mt == 1
            gm = hv
        elif mt == 2
            gm = sqrt(hv)
        elif mt == 3
            gm = log(hv)
        endif
        e[t] = y[t] - mu[t] - lam * gm
        ll[t] = -0.5 * (log(2 * $pi) + log(hv) + e[t]^2 / hv)
    endloop
    return ll ~ e ~ h
end function

function scalar ev__garchobj (const matrix th, const matrix y, const matrix XM, scalar eg,
                              scalar nm, scalar na, scalar nt, scalar ng, scalar mt, scalar h0)
    matrix r = ev__garchh(th, y, XM, eg, nm, na, nt, ng, mt, h0)
    scalar s = sumc(r[, 1])
    return ok(s) ? s : -1e100
end function

function bundle ev_garch (string spec "Mean equation, e.g. y c x",
                          list vars "Series used (e.g. dataset)",
                          string model[null] "garch, tarch or egarch",
                          int narch[0::1] "ARCH order",
                          int ngarch[0::1] "GARCH order",
                          bool quiet[0],
                          string archm[null] "ARCH-in-mean term: var, sd or log",
                          int nthr[-1::-1] "Threshold (asymmetric) order; -1 = EViews default",
                          string dist[null] "Error distribution: normal (default), t or ged")
    string md = exists(model) ? tolower(model) : "garch"
    errorif(!instring(" garch tarch egarch ", " " ~ md ~ " "), "model must be garch, tarch or egarch")
    if md == "garch" && nthr > 0
        md = "tarch"                  # EViews: arch(p,q,thrsh=k) is a threshold model
    endif
    scalar mt = 0
    string mlab = ""
    if exists(archm) && archm != ""
        string am = tolower(archm)
        errorif(!instring(" var sd log ", " " ~ am ~ " "), "archm must be var, sd or log")
        mt = am == "var" ? 1 : (am == "sd" ? 2 : 3)
        mlab = am == "var" ? "GARCH" : (am == "sd" ? "@SQRT(GARCH)" : "LOG(GARCH)")
    endif
    scalar gtype = md == "garch" ? 1 : (md == "tarch" ? 3 : 7)
    scalar ng0 = gtype == 1 ? 0 : narch       # threshold terms gig estimates
    scalar nt = nthr < 0 ? ng0 : nthr
    errorif(gtype == 3 && nt == 0, "a threshold model needs thrsh >= 1")
    strings tok = strsplit(spec)
    series evg_y = ev_gen(tok[1], vars)
    list X = null
    strings xlab = array(0)
    loop i = 2..nelem(tok)
        if tolower(tok[i]) == "c"
            list X += const
            xlab += "C"
        else
            string v = sprintf("evg_x%d", i)
            series @v = ev_gen(tok[i], vars)
            list X += @v
            xlab += toupper(tok[i])
        endif
    endloop
    if nelem(X) > 0
        bundle m = gig_setup(evg_y, gtype, X)
    else
        bundle m = gig_setup(evg_y, gtype)
    endif
    gig_set_pq(&m, ngarch, narch)
    string dst = exists(dist) ? tolower(dist) : "normal"
    dst = dst == "n" ? "normal" : (dst == "tdist" ? "t" : dst)
    errorif(!instring(" normal t ged ", " " ~ dst ~ " "), "dist must be normal, t or ged")
    scalar cdist = dst == "t" ? 1 : (dst == "ged" ? 2 : 0)
    errorif(cdist > 0 && (mt > 0 || nt != (gtype == 1 ? 0 : narch)), \
      "t/GED errors are available with gig's models (no ARCH-M, threshold order = ARCH order)")
    if cdist > 0
        gig_set_dist(&m, cdist)
    endif
    gig_estimate(&m, 0)
    scalar failed = !inbundle(m, "criteria")
    if !failed && inbundle(m, "errcode")
        failed = m.errcode != 0
    endif
    if failed
        # like EViews: warn and let the program go on (b.failed = 1, no estimates)
        printf "Warning: %s estimation of %s failed (no convergence)\n", toupper(md), toupper(tok[1])
        return _(kind = "garch", failed = 1, model = md, spec = spec)
    endif
    scalar nm = nelem(X)
    scalar nv0 = 1 + narch + ng0 + ngarch
    # gig's layout: mean, omega, alpha (narch), gamma (narch, fixed at 0 for GARCH),
    # beta (ngarch), then distribution parameters; the vcv covers the active ones
    matrix pos = seq(1, nm + 1 + narch)
    if gtype != 1
        pos ~= seq(nm + 2 + narch, nm + 1 + 2 * narch)
    endif
    pos ~= seq(nm + 2 + 2 * narch, nm + 1 + 2 * narch + ngarch)
    if cdist > 0
        pos ~= nm + 2 + 2 * narch + ngarch          # distribution parameter (t dof / GED shape)
    endif
    matrix act = m.active
    matrix vpos = zeros(1, cols(pos))
    loop i = 1..cols(pos)
        scalar pi = pos[i]
        vpos[i] = imaxc(act .= pi)
    endloop
    matrix c = m.coeff[pos]
    if inbundle(m, "vcv")
        matrix V = m.vcv[vpos, vpos]
    else
        # EViews also reports estimates when the covariance cannot be computed
        printf "Warning: the coefficient covariance could not be computed (singular Hessian)\n"
        matrix V = mshape(NA, cols(pos), cols(pos))
    endif
    # gig's GJR: h = w + a(|e| - g e)^2 + b h  ->  EViews TARCH:
    # h = w + A e^2 + G e^2 (e < 0) + b h, with A = a(1-g)^2, G = 4ag (delta method)
    if gtype == 3
        matrix Jm = I(rows(c))
        loop i = 1..narch
            scalar ia = nm + 1 + i
            scalar ig = nm + 1 + narch + i
            scalar a = c[ia]
            scalar g = c[ig]
            Jm[ia, ia] = (1 - g)^2
            Jm[ia, ig] = -2 * a * (1 - g)
            Jm[ig, ia] = 4 * g
            Jm[ig, ig] = 4 * a
            c[ia] = a * (1 - g)^2
            c[ig] = 4 * a * g
        endloop
        V = Jm * V * Jm'
    endif
    scalar lnl = m.criteria[1]
    scalar T = m.nobs
    matrix hm = {m.h}
    matrix um = {m.uhat}
    series evg_o = obs
    matrix tob = {evg_o}
    matrix okr = ok(hm) .* ok(um)
    hm = selifr(hm, okr)
    um = selifr(um, okr)
    tob = selifr(tob, okr)
    string meth = "ML ARCH - Normal distribution (gig, BFGS)"
    if mt > 0 || nt != ng0
        # ARCH-in-mean or other threshold orders: own likelihood (EViews recursion),
        # started from the estimates above; covariance from the numerical Hessian
        list LL = evg_y X evg_o
        matrix Dm = {LL}
        matrix yv = Dm[, 1]
        matrix XM = {}
        if nm > 0
            XM = Dm[, 2:1 + nm]
        endif
        tob = Dm[, cols(Dm)]
        matrix th = c[1:nm + 1 + narch]
        loop k = 1..nt
            scalar gk = k <= ng0 ? c[nm + 1 + narch + k] : 0
            th |= gk
        endloop
        if ngarch > 0
            th |= c[nm + 2 + narch + ng0:nm + 1 + narch + ng0 + ngarch]
        endif
        if mt > 0
            th = 0 | th
        endif
        scalar h0 = meanc(um.^2)
        scalar eg = gtype == 7
        set bfgs_toler 1e-9
        set max_verbose off
        scalar lnl = BFGSmax(&th, "ev__garchobj(th, yv, XM, eg, nm, narch, nt, ngarch, mt, h0)")
        matrix H = numhess(th, "ev__garchobj(th, yv, XM, eg, nm, narch, nt, ngarch, mt, h0)")
        catch matrix V = -inv(H)
        if $error
            matrix V = mshape(NA, rows(th), rows(th))
        endif
        if sumc(!ok(V)) > 0 || minc(diag(V)) <= 0
            printf "Warning: the coefficient covariance could not be computed (singular Hessian)\n"
            V = mshape(NA, rows(th), rows(th))
        endif
        matrix R = ev__garchh(th, yv, XM, eg, nm, narch, nt, ngarch, mt, h0)
        c = th
        um = R[, 2]
        hm = R[, 3]
        T = rows(yv)
        meth = "ML ARCH - Normal distribution (BFGS, numerical Hessian)"
    endif
    scalar nmp = nm + (mt > 0)              # mean-equation coefficients shown
    if mt > 0
        strings xl2 = defarray(mlab)
        loop i = 1..nelem(xlab)
            xl2 += xlab[i]
        endloop
        xlab = xl2
    endif
    bundle b
    b.kind = "garch"
    b.failed = 0
    b.model = md
    b.archm = mt
    b.spec = spec
    b.depvar = toupper(tok[1])
    b.method = cdist == 0 ? meth : strsub(meth, "Normal distribution", cdist == 1 ? "Student's t distribution" : "Generalized error distribution (GED)")
    b.dist = dst
    strings lab = array(0)
    loop i = 1..rows(c)
        lab += sprintf("C(%d)", i)
    endloop
    if cdist > 0
        lab[nelem(lab)] = cdist == 1 ? "T-DIST. DOF" : "GED PARAMETER"
    endif
    b.clabels = lab
    b.xlab = xlab
    b.nm = nmp
    b.narch = narch
    b.ngarch = ngarch
    b.nthr = nt
    b.coeff = c
    b.vcv = V
    b.stderr = sqrt(diag(V))
    b.k = rows(c)
    b.lnl = lnl
    b.T = T
    b.h = hm
    b.uhat = um
    b.tobs = tob
    b.sample = sprintf("%s %s", obslabel(minc(b.tobs)), obslabel(maxc(b.tobs)))
    b.estdate = strftime($now[1], "%m/%d/%y   Time: %H:%M")
    # variance equation as EViews writes it
    string ve = sprintf("C(%d)", nmp + 1)
    if gtype == 7
        loop i = 1..narch
            ve ~= sprintf(" + C(%d)*ABS(RESID(-%d)/@SQRT(GARCH(-%d)))", nmp + 1 + i, i, i)
        endloop
        loop i = 1..nt
            ve ~= sprintf(" + C(%d)*RESID(-%d)/@SQRT(GARCH(-%d))", nmp + 1 + narch + i, i, i)
        endloop
        loop i = 1..ngarch
            ve ~= sprintf(" + C(%d)*LOG(GARCH(-%d))", nmp + 1 + narch + nt + i, i)
        endloop
        ve = "LOG(GARCH) = " ~ ve
    else
        loop i = 1..narch
            ve ~= sprintf(" + C(%d)*RESID(-%d)^2", nmp + 1 + i, i)
        endloop
        loop i = 1..nt
            ve ~= sprintf(" + C(%d)*RESID(-%d)^2*(RESID(-%d)<0)", nmp + 1 + narch + i, i, i)
        endloop
        loop i = 1..ngarch
            ve ~= sprintf(" + C(%d)*GARCH(-%d)", nmp + 1 + narch + nt + i, i)
        endloop
        ve = "GARCH = " ~ ve
    endif
    b.vareq = ve
    scalar n = b.T
    b.aic = -2 * b.lnl / n + 2 * b.k / n
    b.sc = -2 * b.lnl / n + b.k * log(n) / n
    b.hq = -2 * b.lnl / n + 2 * b.k * log(log(n)) / n
    if !quiet
        ev_garchprint(&b)
    endif
    return b
end function

function void ev_garchprint (bundle *b)
    printf "\nDependent Variable: %s\nMethod: %s\nDate: %s\n", b.depvar, b.method, b.estdate
    printf "Sample: %s\nIncluded observations: %d\n", b.sample, b.T
    printf "%s\n\n", b.vareq
    ev__line(78)
    printf "%-26s%13s%13s%14s%12s\n", "Variable", "Coefficient", "Std. Error", "z-Statistic", "Prob."
    ev__line(78)
    loop i = 1..b.nm
        scalar z = b.coeff[i] / b.stderr[i]
        printf "%-26s%13.6f%13.6f%14.6f%12.4f\n", b.xlab[i], b.coeff[i], b.stderr[i], z, 2 * pvalue(z, abs(z))
    endloop
    printf "\n%38s\n\n", "Variance Equation"
    loop i = b.nm + 1..b.k
        scalar z = b.coeff[i] / b.stderr[i]
        printf "%-26s%13.6f%13.6f%14.6f%12.4f\n", b.clabels[i], b.coeff[i], b.stderr[i], z, 2 * pvalue(z, abs(z))
    endloop
    ev__line(78)
    printf "%-22s%14.6f    %-24s%14.6f\n", "Log likelihood", b.lnl, "Akaike info criterion", b.aic
    printf "%-22s%14s    %-24s%14.6f\n", "", "", "Schwarz criterion", b.sc
    printf "%-22s%14s    %-24s%14.6f\n", "", "", "Hannan-Quinn criter.", b.hq
    ev__line(78)
end function

function series ev_garchseries (bundle b "ev_garch result", string what[null] "h (conditional variance) or resid")
    string w = exists(what) ? tolower(what) : "h"
    return ev__toseries(w == "h" ? b.h : b.uhat, b.tobs)
end function

# -------------------------------------------------------------------
# Two-stage least squares: equation.tsls y c x @ c z
# -------------------------------------------------------------------

function bundle ev_tsls (string spec "Equation and instruments, e.g. y c x @ c z1 z2",
                         list vars "Series used (e.g. dataset)",
                         string cov[null] "ordinary or white",
                         bool quiet[0],
                         bool liml[0] "Limited information maximum likelihood")
    errorif(!instring(spec, "@"), "Give the instruments after @, e.g. y c x @ c z")
    strings parts = strsplit(spec, "@")
    strings tok = strsplit(strstrip(parts[1]))
    strings itok = strsplit(strstrip(parts[2]))
    string cv = exists(cov) ? tolower(cov) : "ordinary"
    series evt_y = ev_gen(tok[1], vars)
    list X = null
    strings lab = array(0)
    scalar hascon = 0
    loop i = 2..nelem(tok)
        if tolower(tok[i]) == "c"
            list X += const
            lab += "C"
            hascon = 1
        else
            string v = sprintf("evt_x%d", i)
            series @v = ev_gen(tok[i], vars)
            list X += @v
            lab += toupper(tok[i])
        endif
    endloop
    list Z = null
    string itxt = ""
    loop i = 1..nelem(itok)
        itxt ~= " " ~ toupper(itok[i])
        if tolower(itok[i]) == "c"
            list Z += const
        else
            string v = sprintf("evt_z%d", i)
            series @v = ev_gen(itok[i], vars)
            list Z += @v
        endif
    endloop
    errorif(nelem(Z) < nelem(X), "Order condition: at least as many instruments as regressors are needed")
    scalar n0 = $nobs
    if liml
        tsls evt_y X ; Z --liml --quiet
    elif cv == "white"
        set force_hc on
        tsls evt_y X ; Z --robust --quiet
    else
        tsls evt_y X ; Z --quiet
    endif
    bundle b
    b.kind = "tsls"
    b.iv = 1
    b.spec = spec
    b.method = liml ? "LIML / K-Class" : "Two-Stage Least Squares"
    b.eqline = "Instrument specification:" ~ itxt
    b.depvar = toupper(tok[1])
    b.labels = lab
    b.covtype = cv
    b.coeff = $coeff
    b.stderr = $stderr
    b.vcv = $vcv
    b.T = $T
    b.k = $ncoeff
    catch scalar r2 = $rsq          # not defined after LIML
    if $error
        r2 = NA
    endif
    b.rsq = r2
    b.adjrsq = 1 - (1 - r2) * ($T - 1) / ($T - $ncoeff)
    b.sigma = $sigma
    b.ssr = $ess
    catch scalar dwv = $dw
    if $error
        dwv = NA
    endif
    b.dw = dwv
    b.hascon = hascon
    b.adjusted = $T < n0
    b.estdate = strftime($now[1], "%m/%d/%y   Time: %H:%M")
    series evt_u = $uhat
    series evt_f = $yhat
    smpl ok(evt_u) --restrict
    b.y = {evt_y}
    b.X = {X}
    matrix Zm = {Z}
    b.uhat = {evt_u}
    b.yhat = {evt_f}
    series evt_o = obs
    b.tobs = {evt_o}
    b.sample = sprintf("%s %s", obslabel($t1), obslabel($t2))
    scalar n = b.T
    scalar k = b.k
    matrix d = b.y - meanc(b.y)
    b.meany = meanc(b.y)
    b.sdy = sqrt(d'd / (n - 1))
    # J-statistic (Sargan form, as EViews reports for TSLS) and instrument rank
    matrix u = b.uhat
    b.instrank = rank(Zm)
    b.J = qform(u', Zm * inv(Zm'Zm) * Zm') / (u'u / n)
    b.Jdf = b.instrank - k
    b.Jp = NA
    if b.Jdf > 0
        b.Jp = pvalue(c, b.Jdf, b.J)
    endif
    b.lnl = NA
    b.aic = NA
    b.sc = NA
    b.hq = NA
    b.F = NA
    b.Fp = NA
    b.tstat = b.coeff ./ b.stderr
    matrix p = zeros(k, 1)
    loop i = 1..k
        p[i] = 2 * pvalue(t, n - k, abs(b.tstat[i]))
    endloop
    b.pval = p
    if !quiet
        ev_print(&b)
    endif
    return b
end function

# -------------------------------------------------------------------
# Binary choice: equation.binary(d=l|p) y c x
# -------------------------------------------------------------------

function bundle ev_binary (string spec "Equation, e.g. y c x (y is 0/1)",
                           list vars "Series used (e.g. dataset)",
                           string dist[null] "logit (l) or probit (p)",
                           bool quiet[0])
    string ds = exists(dist) ? tolower(dist) : "logit"
    ds = ds == "l" ? "logit" : (ds == "p" || ds == "n" ? "probit" : ds)
    errorif(ds != "logit" && ds != "probit", "d= must be l (logit) or p (probit)")
    strings tok = strsplit(spec)
    series evb_y = ev_gen(tok[1], vars)
    list X = null
    strings lab = array(0)
    loop i = 2..nelem(tok)
        if tolower(tok[i]) == "c"
            list X += const
            lab += "C"
        else
            string v = sprintf("evb_x%d", i)
            series @v = ev_gen(tok[i], vars)
            list X += @v
            lab += toupper(tok[i])
        endif
    endloop
    scalar n0 = $nobs
    if ds == "logit"
        logit evb_y X --quiet
    else
        probit evb_y X --quiet
    endif
    bundle b
    b.kind = "binary"
    b.dist = ds
    b.spec = spec
    b.depvar = toupper(tok[1])
    b.labels = lab
    b.method = ds == "logit" ? "ML - Binary Logit (Newton-Raphson)" : "ML - Binary Probit (Newton-Raphson)"
    b.coeff = $coeff
    b.stderr = $stderr
    b.vcv = $vcv
    b.lnl = $lnl
    b.T = $T
    b.k = $ncoeff
    b.adjusted = $T < n0
    series evb_p = $yhat
    series evb_o = obs
    list L = evb_y evb_p evb_o
    matrix D = {L}
    b.y = D[, 1]
    b.yhat = D[, 2]                  # fitted probabilities
    b.uhat = D[, 1] - D[, 2]
    b.tobs = D[, 3]
    b.sample = sprintf("%s %s", obslabel(minc(b.tobs)), obslabel(maxc(b.tobs)))
    errorif(sumc((b.y .!= 0) .* (b.y .!= 1)) > 0, "The dependent variable must be 0 or 1")
    scalar n = b.T
    scalar k = b.k
    scalar n1 = sumc(b.y)
    scalar pbar = n1 / n
    b.n1 = n1
    b.n0 = n - n1
    b.lnl0 = n1 * log(pbar) + (n - n1) * log(1 - pbar)       # constant-only model
    b.mcfadden = 1 - b.lnl / b.lnl0
    b.LR = 2 * (b.lnl - b.lnl0)
    b.LRdf = k - 1
    b.LRp = pvalue(c, k - 1, b.LR)
    b.avglnl = b.lnl / n
    b.meany = pbar
    b.sdy = sqrt(pbar * (1 - pbar) * n / (n - 1))
    b.ssr = sumc(b.uhat.^2)
    b.sigma = sqrt(b.ssr / (n - k))
    b.aic = -2 * b.lnl / n + 2 * k / n
    b.sc = -2 * b.lnl / n + k * log(n) / n
    b.hq = -2 * b.lnl / n + 2 * k * log(log(n)) / n
    b.tstat = b.coeff ./ b.stderr
    b.pval = 2 * cnorm(-abs(b.tstat))
    b.estdate = strftime($now[1], "%m/%d/%y   Time: %H:%M")
    if !quiet
        ev_binaryprint(&b)
    endif
    return b
end function

function void ev_binaryprint (bundle *b)
    printf "\nDependent Variable: %s\nMethod: %s\nDate: %s\n", b.depvar, b.method, b.estdate
    printf "Sample%s: %s\nIncluded observations: %d\n\n", b.adjusted ? " (adjusted)" : "", b.sample, b.T
    ev__line(78)
    printf "%-26s%13s%13s%14s%12s\n", "Variable", "Coefficient", "Std. Error", "z-Statistic", "Prob."
    ev__line(78)
    loop i = 1..b.k
        printf "%-26s%13.6f%13.6f%14.6f%12.4f\n", b.labels[i], b.coeff[i], b.stderr[i], b.tstat[i], b.pval[i]
    endloop
    ev__line(78)
    printf "%-22s%14.6f    %-24s%14.6f\n", "McFadden R-squared", b.mcfadden, "Mean dependent var", b.meany
    printf "%-22s%14.6f    %-24s%14.6f\n", "S.D. dependent var", b.sdy, "S.E. of regression", b.sigma
    printf "%-22s%14.6f    %-24s%14.6f\n", "Akaike info criterion", b.aic, "Sum squared resid", b.ssr
    printf "%-22s%14.6f    %-24s%14.6f\n", "Schwarz criterion", b.sc, "Log likelihood", b.lnl
    printf "%-22s%14.6f    %-24s%14.6f\n", "Hannan-Quinn criter.", b.hq, "Restr. log likelihood", b.lnl0
    printf "%-22s%14.6f    %-24s%14.6f\n", "LR statistic", b.LR, "Avg. log likelihood", b.avglnl
    printf "%-22s%14.6f\n", "Prob(LR statistic)", b.LRp
    ev__line(78)
    printf "%-22s%14d    %-24s%14d\n", "Obs with Dep=0", b.n0, "Total obs", b.T
    printf "%-22s%14d\n", "Obs with Dep=1", b.n1
    ev__line(78)
end function

# -------------------------------------------------------------------
# ARDL with automatic lag selection, long-run form and bounds test
# -------------------------------------------------------------------

function string ev__lagx (string e, int j, list vars)
    # lag every series of an expression by j: log(y) -> log(y(-j)), as EViews writes it
    errorif(instring(e, "(-"), "ARDL variables cannot contain explicit lags: " ~ e)
    if j == 0
        return e
    endif
    strings nm = varnames(vars)
    string r = e
    loop i = 1..nelem(nm)
        r = regsub(r, "(?i)(?<![A-Za-z0-9_.])" ~ nm[i] ~ "(?![A-Za-z0-9_(])", nm[i] ~ sprintf("(-%d)", j))
    endloop
    return r
end function

function scalar ev__ic (scalar ssr, scalar n, scalar k, string ic)
    scalar l = -n / 2 * (1 + log(2 * $pi) + log(ssr / n))
    if ic == "sic" || ic == "bic"
        return -2 * l / n + k * log(n) / n
    elif ic == "hq"
        return -2 * l / n + 2 * k * log(log(n)) / n
    endif
    return -2 * l / n + 2 * k / n
end function

function bundle ev_ardl (string spec "Dependent variable and regressors, e.g. y x1 x2 [@ fixed]",
                         list vars "Series used (e.g. dataset)",
                         int deplags[1::4] "Maximum lags of the dependent variable",
                         int reglags[0::4] "Maximum lags of the regressors",
                         string ic[null] "aic, sic or hq",
                         string trend[null] "none, const or linear",
                         bool quiet[0])
    string icr = exists(ic) ? tolower(ic) : "aic"
    icr = icr == "bic" ? "sic" : icr
    errorif(!instring(" aic sic hq ", " " ~ icr ~ " "), "ic must be aic, sic or hq")
    string tr = exists(trend) ? tolower(trend) : "const"
    errorif(!instring(" none const linear ", " " ~ tr ~ " "), "trend must be none, const or linear")
    strings parts = strsplit(spec, "@")
    strings tok = strsplit(strstrip(parts[1]))
    strings ftok = array(0)
    if nelem(parts) > 1
        ftok = strsplit(strstrip(parts[2]))
    endif
    scalar kx = nelem(tok) - 1
    errorif(kx < 1, "ARDL needs at least one regressor")
    # all candidate columns, over the current sample
    set skip_missing off
    series eva_y = ev_gen(tok[1], vars)
    matrix Y = {eva_y}
    matrix YL = {}
    loop j = 1..deplags
        series eva_t = ev_gen(ev__lagx(tok[1], j, vars), vars)
        YL ~= {eva_t}
    endloop
    matrices XL = array(kx)
    loop i = 1..kx
        matrix M = {}
        loop j = 0..reglags
            series eva_t = ev_gen(ev__lagx(tok[i+1], j, vars), vars)
            M ~= {eva_t}
        endloop
        XL[i] = M
    endloop
    matrix F = {}
    strings flab = array(0)
    loop i = 1..nelem(ftok)
        if tolower(ftok[i]) != "c"
            series eva_t = ev_gen(ftok[i], vars)
            F ~= {eva_t}
            flab += toupper(ftok[i])
        endif
    endloop
    series eva_o = obs
    matrix tob = {eva_o}
    matrix D = {}
    if tr != "none"
        series eva_c = 1
        D ~= {eva_c}
    endif
    if tr == "linear"
        series eva_tt = obs - 1
        D ~= {eva_tt}
    endif
    # common sample: rows where every candidate column is available (as EViews)
    matrix all = Y ~ YL ~ F
    loop i = 1..kx
        all ~= XL[i]
    endloop
    matrix okr = sumr(!ok(all)) .= 0
    Y = selifr(Y, okr)
    YL = selifr(YL, okr)
    loop i = 1..kx
        XL[i] = selifr(XL[i], okr)
    endloop
    if rows(F)
        F = selifr(F, okr)
    endif
    if rows(D)
        D = selifr(D, okr)
    endif
    tob = selifr(tob, okr)
    scalar n = rows(Y)
    # search over p = 1..deplags and q_i = 0..reglags
    scalar nq = reglags + 1
    scalar ncomb = deplags * nq^kx
    scalar best = 1e300
    matrix bestq = {}
    scalar bestp = 1
    matrix tab = {}
    loop c = 0..ncomb - 1
        scalar r = c
        scalar p = 1 + (r % deplags)
        r = floor(r / deplags)
        matrix q = zeros(1, kx)
        loop i = 1..kx
            q[i] = r % nq
            r = floor(r / nq)
        endloop
        matrix W = YL[, 1:p] ~ F ~ D
        loop i = 1..kx
            matrix Mi = XL[i]
            W ~= Mi[, 1:q[i] + 1]
        endloop
        matrix e = Y - W * mols(Y, W)
        scalar v = ev__ic(e'e, n, cols(W), icr)
        tab |= p ~ q ~ v
        if v < best
            best = v
            bestp = p
            bestq = q
        endif
    endloop
    # final model, EViews order: Y(-1..p), each X with its lags, fixed regressors, C, @TREND
    matrix W = YL[, 1:bestp]
    strings lab = array(0)
    loop j = 1..bestp
        lab += sprintf("%s(-%d)", toupper(tok[1]), j)
    endloop
    loop i = 1..kx
        matrix Mi = XL[i]
        W ~= Mi[, 1:bestq[i] + 1]
        loop j = 0..bestq[i]
            lab += j == 0 ? toupper(tok[i+1]) : sprintf("%s(-%d)", toupper(tok[i+1]), j)
        endloop
    endloop
    W ~= F
    loop i = 1..nelem(flab)
        lab += flab[i]
    endloop
    if tr != "none"
        W ~= D[, 1]
        lab += "C"
    endif
    if tr == "linear"
        W ~= D[, 2]
        lab += "@TREND"
    endif
    matrix bh = mols(Y, W, &e)
    scalar k = cols(W)
    scalar s2 = e'e / (n - k)
    matrix V = s2 * inv(W'W)
    bundle b
    b.kind = "ardl"
    b.spec = spec
    b.depvar = toupper(tok[1])
    b.method = "ARDL"
    b.labels = lab
    b.p = bestp
    b.q = bestq
    b.ic = icr
    b.trend = tr
    b.kx = kx
    b.ncomb = ncomb
    b.models = tab
    string sel = sprintf("ARDL(%d", bestp)
    loop i = 1..kx
        sel ~= sprintf(", %d", bestq[i])
    endloop
    b.selected = sel ~ ")"
    b.eqline = sprintf("Dependent lags: %d (Automatic selection)\nAutomatic-lag linear regressors (%d max. lags):", deplags, reglags)
    loop i = 1..kx
        b.eqline = b.eqline ~ " " ~ toupper(tok[i+1])
    endloop
    b.eqline = b.eqline ~ sprintf("\nModel selection method: %s\nNumber of models evaluated: %d\nSelected Model: %s", \
      icr == "aic" ? "Akaike info criterion (AIC)" : (icr == "sic" ? "Schwarz criterion (SIC)" : "Hannan-Quinn criterion (HQ)"), ncomb, b.selected)
    b.coeff = bh
    b.vcv = V
    b.stderr = sqrt(diag(V))
    b.T = n
    b.k = k
    b.y = Y
    b.X = W
    b.uhat = e
    b.yhat = Y - e
    b.tobs = tob
    b.sample = sprintf("%s %s", obslabel(minc(tob)), obslabel(maxc(tob)))
    b.adjusted = 1
    b.covtype = "ordinary"
    b.hascon = tr != "none"
    matrix d = Y - meanc(Y)
    b.ssr = e'e
    b.rsq = 1 - b.ssr / (d'd)
    b.adjrsq = 1 - (1 - b.rsq) * (n - 1) / (n - k)
    b.sigma = sqrt(s2)
    b.lnl = -n / 2 * (1 + log(2 * $pi) + log(b.ssr / n))
    b.meany = meanc(Y)
    b.sdy = sqrt(d'd / (n - 1))
    b.aic = -2 * b.lnl / n + 2 * k / n
    b.sc = -2 * b.lnl / n + k * log(n) / n
    b.hq = -2 * b.lnl / n + 2 * k * log(log(n)) / n
    b.dw = sumc((e[2:] - e[1:n-1]).^2) / b.ssr
    scalar kc = k - (tr != "none")
    b.F = NA
    if b.hascon && k > 1
        b.F = (b.rsq / (k - 1)) / ((1 - b.rsq) / (n - k))
    endif
    b.Fp = ok(b.F) ? pvalue(F, k - 1, n - k, b.F) : NA
    b.tstat = bh ./ b.stderr
    matrix pv = zeros(k, 1)
    loop i = 1..k
        pv[i] = 2 * pvalue(t, n - k, abs(b.tstat[i]))
    endloop
    b.pval = pv
    b.estdate = strftime($now[1], "%m/%d/%y   Time: %H:%M")
    ev__ardllr(&b, XL, YL, F, D)
    if !quiet
        ev_print(&b)
    endif
    return b
end function

function void ev__ardllr (bundle *b, matrices XL, const matrix YL, const matrix F, const matrix D)
    # long-run coefficients (delta method) and the Pesaran-Shin-Smith bounds F test
    scalar p = b.p
    scalar kx = b.kx
    matrix c = b.coeff
    matrix V = b.vcv
    scalar k = rows(c)
    scalar sphi = sumc(c[1:p])
    scalar den = 1 - sphi
    matrix lr = {}
    matrix G = {}                       # Jacobian of the long-run coefficients
    strings lrl = array(0)
    scalar pos = p
    loop i = 1..kx
        scalar qi = b.q[i]
        matrix g = zeros(1, k)
        scalar sb = sumc(c[pos + 1:pos + qi + 1])
        g[1:p] = sb / den^2
        g[pos + 1:pos + qi + 1] = 1 / den
        lr |= sb / den
        G |= g
        strings lt = b.labels
        lrl += lt[pos + 1]
        pos += qi + 1
    endloop
    if b.trend != "none"
        scalar ic = 0
        loop j = 1..nelem(b.labels)
            if b.labels[j] == "C"
                ic = j
            endif
        endloop
        matrix g = zeros(1, k)
        g[1:p] = c[ic] / den^2
        g[ic] = 1 / den
        lr |= c[ic] / den
        G |= g
        lrl += "C"
    endif
    b.lr = lr
    b.lr_se = sqrt(diag(G * V * G'))
    b.lr_labels = lrl
    # conditional ECM: dY on Y(-1), X(-1), lagged dY, dX(t..t-q+1), deterministic terms
    matrix y = b.y
    matrix Yl1 = YL[, 1]
    matrix dy = y - Yl1
    matrix R = Yl1
    loop i = 1..kx
        matrix Mi = XL[i]
        R ~= Mi[, 2]
    endloop
    errorif(cols(XL[1]) < 2, "The bounds test needs at least one lag of the regressors in the data")
    matrix W = R
    loop j = 1..p - 1
        W ~= YL[, j] - YL[, j + 1]
    endloop
    loop i = 1..kx
        matrix Mi = XL[i]
        scalar qi = b.q[i]
        loop j = 0..max(qi - 1, 0)
            W ~= Mi[, j + 1] - Mi[, j + 2]
        endloop
    endloop
    W ~= F ~ D
    matrix eu = dy - W * mols(dy, W)
    scalar m = kx + 1
    matrix Wr = W[, m + 1:cols(W)]
    matrix er = dy - Wr * mols(dy, Wr)
    scalar n = rows(dy)
    b.bounds_F = ((er'er - eu'eu) / m) / (eu'eu / (n - cols(W)))
    b.bounds_k = kx
    # asymptotic critical values, Pesaran, Shin and Smith (2001), Table CI(iii):
    # unrestricted intercept, no trend; rows k = 1..5; columns I(0)/I(1) at 10%, 5%, 1%
    matrix cv = {4.04, 4.78, 4.94, 5.73, 6.84, 7.84; \
                 3.17, 4.14, 3.79, 4.85, 5.15, 6.36; \
                 2.72, 3.77, 3.23, 4.35, 4.29, 5.61; \
                 2.45, 3.52, 2.86, 4.01, 3.74, 5.06; \
                 2.26, 3.35, 2.62, 3.79, 3.41, 4.68}
    b.bounds_cv = mshape(NA, 1, 6)
    if b.trend == "const" && kx <= 5
        b.bounds_cv = cv[kx,]
    endif
end function

function void ev_ardlprint (bundle *b)
    ev_print(&b)
    printf "\nLevels Equation (long-run coefficients)\n"
    ev__line(78)
    printf "%-26s%13s%13s%14s%12s\n", "Variable", "Coefficient", "Std. Error", "t-Statistic", "Prob."
    ev__line(78)
    loop i = 1..rows(b.lr)
        scalar tt = b.lr[i] / b.lr_se[i]
        printf "%-26s%13.6f%13.6f%14.6f%12.4f\n", b.lr_labels[i], b.lr[i], b.lr_se[i], tt, 2 * pvalue(t, b.T - b.k, abs(tt))
    endloop
    ev__line(78)
    ev_boundsprint(&b)
end function

function void ev_boundsprint (bundle *b)
    printf "\nF-Bounds Test           Null Hypothesis: No levels relationship\n"
    ev__line(78)
    printf "%-22s%12s    %10s%12s%12s\n", "Test Statistic", "Value", "Signif.", "I(0)", "I(1)"
    ev__line(78)
    printf "%-22s%12.6f    %10s%12.2f%12.2f\n", "F-statistic", b.bounds_F, "10%", b.bounds_cv[1], b.bounds_cv[2]
    printf "%-22s%12d    %10s%12.2f%12.2f\n", "k", b.bounds_k, "5%", b.bounds_cv[3], b.bounds_cv[4]
    printf "%-22s%12s    %10s%12.2f%12.2f\n", "", "", "1%", b.bounds_cv[5], b.bounds_cv[6]
    printf "Asymptotic critical values: Pesaran, Shin and Smith (2001), case III\n"
    ev__line(78)
end function

# -------------------------------------------------------------------
# Equation tests: hettest, reset, chow, testadd, testdrop, rls (CUSUM)
# -------------------------------------------------------------------

function bundle ev__olsr (const matrix y, const matrix X)
    matrix e = {}
    matrix bh = mols(y, X, &e)
    scalar n = rows(y)
    matrix d = y - meanc(y)
    scalar ssr = e'e
    return _(coeff = bh, uhat = e, ssr = ssr, rsq = 1 - ssr / (d'd), n = n, k = cols(X), \
      lnl = -n / 2 * (1 + log(2 * $pi) + log(ssr / n)))
end function

function void ev__teststat (string name, scalar v, string dist, scalar p)
    printf "%-26s%12.6f    %-22s%10.4f\n", name, v, dist, p
end function

function bundle ev_hettest (bundle b "ev_ls result",
                            string htype[null] "bpg, harvey, glejser, arch or white",
                            int nlag[1::1] "Lags for the ARCH test",
                            bool quiet[0])
    errorif(!inbundle(b, "X"), "hettest needs a least squares equation (ev_ls)")
    string ty = exists(htype) ? tolower(htype) : "bpg"
    errorif(!instring(" bpg harvey glejser arch white ", " " ~ ty ~ " "), "type must be bpg, harvey, glejser, arch or white")
    matrix e = b.uhat
    scalar n = rows(e)
    matrix Z = b.X
    if !b.hascon
        Z = ones(n, 1) ~ Z
    endif
    matrix v = {}
    if ty == "bpg"
        v = e.^2
    elif ty == "harvey"
        v = log(e.^2)
    elif ty == "glejser"
        v = abs(e)
    elif ty == "arch"
        matrix e2 = e.^2
        v = e2[nlag + 1:n]
        matrix Z = ones(n - nlag, 1)
        loop j = 1..nlag
            Z ~= e2[nlag + 1 - j:n - j]
        endloop
    else
        # White: levels, squares and cross products of the regressors
        matrix X = b.X
        matrix W = ones(n, 1)
        loop i = 1..cols(X)
            if sdc(X[, i]) > 0
                W ~= X[, i]
            endif
        endloop
        scalar m0 = cols(W)
        loop i = 2..m0
            loop j = i..m0
                W ~= W[, i] .* W[, j]
            endloop
        endloop
        v = e.^2
        Z = W
    endif
    bundle a = ev__olsr(v, Z)
    scalar m = cols(Z) - 1
    scalar na = rows(v)
    bundle r
    r.type = ty
    r.F = (a.rsq / m) / ((1 - a.rsq) / (na - m - 1))
    r.Fp = pvalue(F, m, na - m - 1, r.F)
    r.obsr2 = na * a.rsq
    r.obsr2p = pvalue(c, m, r.obsr2)
    r.df = m
    if ty == "bpg"
        # scaled explained SS of e^2 / sigma^2 on Z
        scalar s2 = e'e / n
        matrix w = e.^2 / s2
        matrix d = w - meanc(w)
        bundle a2 = ev__olsr(w, Z)
        r.sess = (d'd - a2.ssr) / 2
        r.sessp = pvalue(c, m, r.sess)
    elif ty == "harvey" || ty == "glejser"
        matrix d = v - meanc(v)
        r.sess = ty == "harvey" ? (d'd - a.ssr) / 4.9348 : NA    # Harvey: var(log chi2_1) = pi^2/2
        r.sessp = ok(r.sess) ? pvalue(c, m, r.sess) : NA
    endif
    if !quiet
        string tn = ty == "bpg" ? "Breusch-Pagan-Godfrey" : (ty == "harvey" ? "Harvey" : (ty == "glejser" ? "Glejser" : (ty == "arch" ? "ARCH" : "White")))
        printf "\nHeteroskedasticity Test: %s\n", tn
        ev__line(78)
        ev__teststat("F-statistic", r.F, sprintf("Prob. F(%d,%d)", m, na - m - 1), r.Fp)
        ev__teststat("Obs*R-squared", r.obsr2, sprintf("Prob. Chi-Square(%d)", m), r.obsr2p)
        if inbundle(r, "sess") && ok(r.sess)
            ev__teststat("Scaled explained SS", r.sess, sprintf("Prob. Chi-Square(%d)", m), r.sessp)
        endif
        ev__line(78)
    endif
    return r
end function

function bundle ev_reset (bundle b "ev_ls result", int nfit[1::1] "Number of fitted terms", bool quiet[0])
    errorif(!inbundle(b, "X"), "RESET needs a least squares equation (ev_ls)")
    matrix y = b.y
    matrix X = b.X
    matrix f = b.yhat
    matrix Xa = X
    loop j = 1..nfit
        Xa ~= f.^(j + 1)
    endloop
    bundle u = ev__olsr(y, Xa)
    scalar n = rows(y)
    scalar ku = cols(Xa)
    bundle r
    r.F = ((b.ssr - u.ssr) / nfit) / (u.ssr / (n - ku))
    r.Fp = pvalue(F, nfit, n - ku, r.F)
    r.LR = n * log(b.ssr / u.ssr)
    r.LRp = pvalue(c, nfit, r.LR)
    if nfit == 1
        matrix V = u.ssr / (n - ku) * inv(Xa'Xa)
        r.t = u.coeff[ku] / sqrt(V[ku, ku])
        r.tp = 2 * pvalue(t, n - ku, abs(r.t))
    endif
    if !quiet
        printf "\nRamsey RESET Test\nOmitted Variables: Powers of fitted values from 2 to %d\n", nfit + 1
        ev__line(78)
        printf "%-26s%12s    %-10s%14s\n", "", "Value", "df", "Probability"
        if nfit == 1
            printf "%-26s%12.6f    %-10d%14.4f\n", "t-statistic", r.t, n - ku, r.tp
        endif
        printf "%-26s%12.6f    %-10s%14.4f\n", "F-statistic", r.F, sprintf("(%d, %d)", nfit, n - ku), r.Fp
        printf "%-26s%12.6f    %-10d%14.4f\n", "Likelihood ratio", r.LR, nfit, r.LRp
        ev__line(78)
    endif
    return r
end function

function bundle ev_chow (bundle b "ev_ls result", string dates "Breakpoint date(s), e.g. 1990:1 2000:1",
                         bool forecast[0] "Chow forecast test (one date)", bool quiet[0])
    errorif(!inbundle(b, "X"), "The Chow test needs a least squares equation (ev_ls)")
    matrix y = b.y
    matrix X = b.X
    matrix tob = b.tobs
    scalar n = rows(y)
    scalar k = cols(X)
    strings dt = strsplit(dates)
    matrix brk = {}
    loop i = 1..nelem(dt)
        scalar o = obsnum(dt[i])
        errorif(!ok(o), "Unknown date " ~ dt[i])
        brk ~= o
    endloop
    bundle r
    if forecast
        errorif(cols(brk) != 1, "The forecast test takes one date")
        matrix m1 = tob .< brk[1]
        scalar n1 = sumc(m1)
        scalar n2 = n - n1
        errorif(n1 <= k || n2 < 1, "The breakpoint leaves too few observations")
        bundle a1 = ev__olsr(selifr(y, m1), selifr(X, m1))
        r.F = ((b.ssr - a1.ssr) / n2) / (a1.ssr / (n1 - k))
        r.Fdf1 = n2
        r.Fdf2 = n1 - k
        r.Fp = pvalue(F, n2, n1 - k, r.F)
        r.LR = n * log(b.ssr / a1.ssr)
        r.LRp = pvalue(c, n2, r.LR)
        if !quiet
            printf "\nChow Forecast Test\nEquation: %s\nTest predictions for observations from %s to %s\n", b.spec, dt[1], obslabel(maxc(tob))
            ev__line(78)
            printf "%-26s%12s    %-10s%14s\n", "", "Value", "df", "Probability"
            printf "%-26s%12.6f    %-10s%14.4f\n", "F-statistic", r.F, sprintf("(%d, %d)", n2, n1 - k), r.Fp
            printf "%-26s%12.6f    %-10d%14.4f\n", "Likelihood ratio", r.LR, n2, r.LRp
            ev__line(78)
        endif
        return r
    endif
    # breakpoint test: separate regressions in each subsample
    matrix cuts = brk ~ 1e10
    scalar lo = -1e10
    scalar ssru = 0
    scalar lnlu = 0
    loop i = 1..cols(cuts)
        matrix m = (tob .>= lo) .* (tob .< cuts[i])
        errorif(sumc(m) <= k, "A subsample has too few observations for the Chow test")
        bundle a = ev__olsr(selifr(y, m), selifr(X, m))
        ssru += a.ssr
        lo = cuts[i]
    endloop
    scalar ns = cols(cuts)
    scalar q = (ns - 1) * k
    r.F = ((b.ssr - ssru) / q) / (ssru / (n - ns * k))
    r.Fdf1 = q
    r.Fdf2 = n - ns * k
    r.Fp = pvalue(F, q, n - ns * k, r.F)
    r.LR = n * log(b.ssr / ssru)
    r.LRp = pvalue(c, q, r.LR)
    r.Wald = q * r.F
    r.Waldp = pvalue(c, q, r.Wald)
    if !quiet
        printf "\nChow Breakpoint Test: %s\nNull Hypothesis: No breaks at specified breakpoints\n", dates
        printf "Equation Sample: %s\n", b.sample
        ev__line(78)
        ev__teststat("F-statistic", r.F, sprintf("Prob. F(%d,%d)", q, n - ns * k), r.Fp)
        ev__teststat("Log likelihood ratio", r.LR, sprintf("Prob. Chi-Square(%d)", q), r.LRp)
        ev__teststat("Wald Statistic", r.Wald, sprintf("Prob. Chi-Square(%d)", q), r.Waldp)
        ev__line(78)
    endif
    return r
end function

function bundle ev__nested (bundle b, const matrix Xr, const matrix Xu, scalar q, string title, string names, bool quiet)
    matrix y = b.y
    bundle r0 = ev__olsr(y, Xr)
    bundle r1 = ev__olsr(y, Xu)
    scalar n = rows(y)
    scalar ku = cols(Xu)
    bundle r
    r.F = ((r0.ssr - r1.ssr) / q) / (r1.ssr / (n - ku))
    r.Fp = pvalue(F, q, n - ku, r.F)
    r.LR = n * log(r0.ssr / r1.ssr)
    r.LRp = pvalue(c, q, r.LR)
    if !quiet
        printf "\n%s Test\nEquation: %s\nSpecification: %s\n%s: %s\n", title, b.spec, b.spec, \
          title == "Omitted Variables" ? "Omitted Variables" : "Redundant Variables", names
        ev__line(78)
        printf "%-26s%12s    %-10s%14s\n", "", "Value", "df", "Probability"
        printf "%-26s%12.6f    %-10s%14.4f\n", "F-statistic", r.F, sprintf("(%d, %d)", q, n - ku), r.Fp
        printf "%-26s%12.6f    %-10d%14.4f\n", "Likelihood ratio", r.LR, q, r.LRp
        ev__line(78)
    endif
    return r
end function

function bundle ev_testadd (bundle b "ev_ls result", list vars "Series used (e.g. dataset)",
                            string adds "Series to add, e.g. x2 log(z)", bool quiet[0])
    errorif(!inbundle(b, "X"), "testadd needs a least squares equation (ev_ls)")
    strings tok = strsplit(adds)
    matrix Z = {}
    set skip_missing off
    loop i = 1..nelem(tok)
        series eva_z = ev_gen(tok[i], vars)
        matrix zz = zeros(rows(b.tobs), 1)
        loop j = 1..rows(b.tobs)
            scalar t = b.tobs[j]
            zz[j] = eva_z[t]
        endloop
        errorif(sumc(!ok(zz)) > 0, tok[i] ~ " has missing values in the estimation sample")
        Z ~= zz
    endloop
    return ev__nested(b, b.X, b.X ~ Z, cols(Z), "Omitted Variables", toupper(adds), quiet)
end function

function bundle ev_testdrop (bundle b "ev_ls result", string drops "Regressors to drop, e.g. x2 c", bool quiet[0])
    errorif(!inbundle(b, "X"), "testdrop needs a least squares equation (ev_ls)")
    strings tok = strsplit(drops)
    matrix keep = ones(1, cols(b.X))
    loop i = 1..nelem(tok)
        scalar f = 0
        loop j = 1..nelem(b.labels)
            if b.labels[j] == toupper(tok[i])
                keep[j] = 0
                f = 1
            endif
        endloop
        errorif(!f, tok[i] ~ " is not a regressor of the equation")
    endloop
    matrix X = b.X
    return ev__nested(b, selifc(X, keep), X, cols(X) - sumr(keep), "Redundant Variables", toupper(drops), quiet)
end function

function bundle ev_rls (bundle b "ev_ls result", bool quiet[0])
    # recursive residuals, CUSUM and CUSUM of squares with 5% bands, recursive coefficients
    errorif(!inbundle(b, "X"), "Recursive estimates need a least squares equation (ev_ls)")
    matrix y = b.y
    matrix X = b.X
    scalar n = rows(y)
    scalar k = cols(X)
    scalar m = n - k
    errorif(m < 3, "Too few observations for recursive estimates")
    matrix w = zeros(m, 1)
    matrix B = zeros(m, k)
    matrix wse = zeros(m, 1)
    loop t = k + 1..n
        matrix Xt = X[1:t-1,]
        matrix XX = inv(Xt'Xt)
        matrix bt = XX * Xt' * y[1:t-1]
        matrix x = X[t,]
        scalar f = 1 + qform(x, XX)
        w[t - k] = (y[t] - x * bt) / sqrt(f)
        matrix bt2 = mols(y[1:t], X[1:t,])
        B[t - k,] = bt2'
    endloop
    scalar s = sdc(w) * sqrt(m / (m - 1))
    matrix cs = cum(w) / s
    matrix tt = seq(1, m)'
    matrix band = 0.948 * (sqrt(m) + 2 * tt / sqrt(m))
    matrix w2 = w.^2
    matrix cq = cum(w2) / sumc(w2)
    # CUSUM of squares band: Kolmogorov-Smirnov approximation of Durbin's c0 (5%)
    scalar c0 = 1.358 / sqrt(m / 2)
    bundle r
    r.tobs = b.tobs[k + 1:n]
    r.rresid = w
    r.cusum = cs
    r.cusum_band = band
    r.cusumsq = cq
    r.cusumsq_lo = tt / m - c0
    r.cusumsq_hi = tt / m + c0
    r.coefs = B
    r.labels = b.labels
    r.hc = meanc(w) / (s / sqrt(m))          # Harvey-Collier t
    r.hcp = 2 * pvalue(t, m - 1, abs(r.hc))
    r.cusum_out = sumc(abs(cs) .> band)
    r.cusumsq_out = sumc((cq .< r.cusumsq_lo) + (cq .> r.cusumsq_hi))
    if !quiet
        printf "\nRecursive Estimates: %s\n", b.spec
        printf "CUSUM: %d of %d points outside the 5%% band\n", r.cusum_out, m
        printf "CUSUM of squares: %d of %d points outside the 5%% band\n", r.cusumsq_out, m
        printf "Harvey-Collier t = %.6f  (Prob. %.4f)\n", r.hc, r.hcp
    endif
    return r
end function

function void ev_rlsplot (bundle r "ev_rls result", string what[null] "c (CUSUM), q (CUSUM of squares) or r (recursive residuals)",
                          string out[null] "Output file (default: display)")
    string w = exists(what) ? tolower(what) : "c"
    matrix M = {}
    if w == "q"
        M = r.cusumsq ~ r.cusumsq_lo ~ r.cusumsq_hi
        cnameset(M, defarray("CUSUM of Squares", "5% Significance", "5% Significance"))
    elif w == "r"
        M = r.rresid ~ 2 * sdc(r.rresid) * ones(rows(r.rresid), 1) ~ -2 * sdc(r.rresid) * ones(rows(r.rresid), 1)
        cnameset(M, defarray("Recursive Residuals", "+/- 2 S.E.", "+/- 2 S.E."))
    else
        M = r.cusum ~ r.cusum_band ~ -r.cusum_band
        cnameset(M, defarray("CUSUM", "5% Significance", "5% Significance"))
    endif
    string o = exists(out) ? out : "display"
    gnuplot 1 2 3 --matrix=M --with-lines --output="@o"
end function

# -------------------------------------------------------------------
# Phillips-Perron and Phillips-Ouliaris (long-run variance corrections)
# -------------------------------------------------------------------

function scalar ev__nwbw (const matrix u)
    # Newey-West (1994) automatic bandwidth for the Bartlett kernel (EViews default)
    scalar T = rows(u)
    scalar n = floor(4 * (T / 100)^(2 / 9))
    scalar s0 = u'u / T
    scalar s1 = 0
    loop j = 1..n
        scalar g = u[j+1:T]'u[1:T-j] / T
        s0 += 2 * g
        s1 += 2 * j * g
    endloop
    return 1.1447 * ((s1 / s0)^2)^(1 / 3) * T^(1 / 3)
end function

function scalar ev__lrvar (const matrix u, scalar bw)
    # Bartlett-kernel long-run variance with bandwidth bw (weights 1 - j/(bw+1))
    scalar T = rows(u)
    scalar l2 = u'u / T
    scalar jmax = floor(bw)
    loop j = 1..jmax
        if j < T
            l2 += 2 * (1 - j / (bw + 1)) * (u[j+1:T]'u[1:T-j] / T)
        endif
    endloop
    return l2
end function

function scalar ev__urccv (scalar T, scalar itv, scalar p)
    # MacKinnon critical value for level p: invert urcpval by bisection
    scalar lo = -10
    scalar hi = 3
    loop 60
        scalar mid = (lo + hi) / 2
        if urcpval(mid, T, 1, itv) > p
            hi = mid
        else
            lo = mid
        endif
    endloop
    return (lo + hi) / 2
end function

function bundle ev_pp (string expr "Series or expression, e.g. log(gdp)",
                       list vars "Series used (e.g. dataset)",
                       string det[null] "c (constant), ct (constant and trend) or nc (none)",
                       scalar bw[-1] "Bandwidth: -1 Newey-West automatic, -2 Newey-West fixed rule, >= 0 fixed",
                       bool dif[0] "Test the first difference",
                       bool quiet[0])
    string d = exists(det) ? tolower(det) : "c"
    errorif(!instring(" c ct nc ", " " ~ d ~ " "), "det must be c, ct or nc")
    set skip_missing off
    # lags written into the expression, so that pre-sample data are used (as EViews)
    series evp_0 = ev_gen(expr, vars)
    series evp_1 = ev_gen(ev__lagx(expr, 1, vars), vars)
    series evp_x = evp_0
    series evp_l = evp_1
    if dif
        series evp_2 = ev_gen(ev__lagx(expr, 2, vars), vars)
        evp_x = evp_0 - evp_1
        evp_l = evp_1 - evp_2
    endif
    series evp_d = evp_x - evp_l
    series evp_tr = obs - 1
    series evp_o = obs
    list L = evp_d evp_l evp_tr evp_o
    matrix D = {L}
    D = selifr(D, sumr(!ok(D)) .= 0)
    matrix dy = D[, 1]
    matrix X = D[, 2]
    if d != "nc"
        X ~= ones(rows(D), 1)
    endif
    if d == "ct"
        X ~= D[, 3]
    endif
    scalar T = rows(dy)
    scalar k = cols(X)
    matrix e = {}
    matrix bh = mols(dy, X, &e)
    scalar s2 = e'e / (T - k)
    matrix V = s2 * inv(X'X)
    scalar se = sqrt(V[1, 1])
    scalar tal = bh[1] / se
    scalar g0 = e'e / T
    scalar bwu = bw
    string bwm = "fixed"
    if bw == -1
        bwu = ev__nwbw(e)
        bwm = "Newey-West automatic"
    elif bw == -2
        bwu = floor(4 * (T / 100)^(2 / 9))
        bwm = "Newey-West fixed"
    endif
    scalar l2 = ev__lrvar(e, bwu)
    scalar zt = tal * sqrt(g0 / l2) - T * (l2 - g0) * se / (2 * sqrt(l2) * sqrt(s2))
    scalar itv = d == "nc" ? 1 : (d == "c" ? 2 : 3)
    bundle r
    r.stat = zt
    r.pval = urcpval(zt, T, 1, itv)
    r.cv = {ev__urccv(T, itv, 0.01), ev__urccv(T, itv, 0.05), ev__urccv(T, itv, 0.10)}
    r.bandwidth = bwu
    r.bwmethod = bwm
    r.T = T
    r.resvar = g0
    r.lrvar = l2
    r.tdf = tal
    r.coeff = bh
    r.det = d
    if !quiet
        printf "\nNull Hypothesis: %s has a unit root\n", toupper(dif ? "D(" ~ expr ~ ")" : expr)
        printf "Exogenous: %s\n", d == "c" ? "Constant" : (d == "ct" ? "Constant, Linear Trend" : "None")
        printf "Bandwidth: %.4g (%s) using Bartlett kernel\n\n", bwu, bwm
        printf "%-40s%14s%10s\n", "", "Adj. t-Stat", "Prob.*"
        ev__line(78)
        printf "%-40s%14.6f%10.4f\n", "Phillips-Perron test statistic", zt, r.pval
        printf "%-20s%-20s%14.6f\n", "Test critical values:", "1% level", r.cv[1]
        printf "%-20s%-20s%14.6f\n", "", "5% level", r.cv[2]
        printf "%-20s%-20s%14.6f\n", "", "10% level", r.cv[3]
        ev__line(78)
        printf "*MacKinnon (1996) one-sided p-values.\n\n"
        printf "%-40s%14.6f\n", "Residual variance (no correction)", g0
        printf "%-40s%14.6f\n", "HAC corrected variance (Bartlett kernel)", l2
    endif
    return r
end function

# -------------------------------------------------------------------
# Engle-Granger and Phillips-Ouliaris cointegration tests (group.coint(method=eg|po))
# -------------------------------------------------------------------

function bundle ev_cointeg (string names "Series, e.g. y x1 x2 (the first is the dependent one)",
                            list vars "Series used (e.g. dataset)",
                            string method[null] "eg (Engle-Granger) or po (Phillips-Ouliaris)",
                            string det[null] "c (constant), ct (constant and trend) or nc (none)",
                            int lag[-1::-1] "ADF lags for EG: -1 automatic (SIC)",
                            int maxlag[-1::-1] "Maximum lag for the automatic choice (-1: EViews rule)",
                            bool quiet[0])
    string meth = exists(method) ? tolower(method) : "eg"
    errorif(meth != "eg" && meth != "po", "method must be eg or po")
    string d = exists(det) ? tolower(det) : "c"
    strings tok = strsplit(names)
    scalar m = nelem(tok)
    errorif(m < 2, "Give at least two series")
    set skip_missing off
    matrix Y = {}
    loop i = 1..m
        series evc_x = ev_gen(tok[i], vars)
        Y ~= {evc_x}
    endloop
    Y = selifr(Y, sumr(!ok(Y)) .= 0)
    scalar T = rows(Y)
    matrix X = Y[, 2:m]
    if d != "nc"
        X ~= ones(T, 1)
    endif
    if d == "ct"
        X ~= seq(0, T - 1)'
    endif
    matrix u = {}
    matrix bh = mols(Y[, 1], X, &u)
    scalar itv = d == "nc" ? 1 : (d == "c" ? 2 : 3)
    bundle r
    r.method = meth
    r.coeff = bh
    r.uhat = u
    if meth == "eg"
        # ADF regression on the residuals without deterministic terms
        scalar pmax = maxlag >= 0 ? maxlag : floor(4 * (T / 100)^(1 / 4))
        scalar bestp = lag
        if lag < 0
            # choose the lag by SIC on a common sample
            scalar best = 1e300
            loop p = 0..pmax
                matrix du = u[2:T] - u[1:T-1]
                matrix Z = u[pmax+1:T-1]
                loop j = 1..p
                    Z ~= du[pmax+1-j:T-1-j]
                endloop
                matrix ee = {}
                matrix bb = mols(du[pmax+1:T-1], Z, &ee)
                scalar n = rows(ee)
                scalar sic = log(ee'ee / n) + cols(Z) * log(n) / n
                if sic < best
                    best = sic
                    bestp = p
                endif
            endloop
        endif
        scalar p = bestp
        matrix du = u[2:T] - u[1:T-1]
        matrix Z = u[p+1:T-1]
        loop j = 1..p
            Z ~= du[p+1-j:T-1-j]
        endloop
        matrix ee = {}
        matrix bb = mols(du[p+1:T-1], Z, &ee)
        scalar n = rows(ee)
        matrix V = (ee'ee / (n - cols(Z))) * inv(Z'Z)
        r.tau = bb[1] / sqrt(V[1, 1])
        scalar sg = p > 0 ? sumc(bb[2:p+1]) : 0
        r.z = n * bb[1] / (1 - sg)
        r.lag = p
        r.n = n
    else
        # Phillips-Ouliaris: PP-type correction of the residual autoregression
        matrix y1 = u[2:T]
        matrix y0 = u[1:T-1]
        scalar rho = (y0'y1) / (y0'y0)
        matrix e = y1 - rho * y0
        scalar n = rows(e)
        scalar bwu = ev__nwbw(e)
        scalar g0 = e'e / n
        scalar l2 = ev__lrvar(e, bwu)
        scalar lam = (l2 - g0) / 2
        scalar s2 = e'e / (n - 1)
        scalar se = sqrt(s2 / (y0'y0))
        scalar tr = (rho - 1) / se
        r.tau = tr * sqrt(g0 / l2) - lam * n * se / (sqrt(l2) * sqrt(s2))
        r.z = n * (rho - 1) - lam * n^2 / (y0'y0)
        r.bandwidth = bwu
        r.n = n
    endif
    r.taup = urcpval(r.tau, T, m, itv)        # sample size of the cointegrating regression (as gretl)
    if !quiet
        printf "\nNull hypothesis: Series are not cointegrated\nCointegrating equation deterministics: %s\n", \
          d == "c" ? "C" : (d == "ct" ? "C @TREND" : "none")
        if meth == "eg"
            printf "Automatic lags specification based on Schwarz criterion\n"
            printf "Lags: %d\n", r.lag
        else
            printf "Long-run variance estimate (Bartlett kernel, Newey-West bandwidth %.4g)\n", r.bandwidth
        endif
        printf "\n%-26s%14s%14s%10s\n", "Dependent", "tau-statistic", "z-statistic", "Prob.*"
        ev__line(78)
        printf "%-26s%14.6f%14.6f%10.4f\n", toupper(tok[1]), r.tau, r.z, r.taup
        ev__line(78)
        printf "*MacKinnon (1996) p-values (for the tau-statistic).\n"
        printf "Method: %s\n", meth == "eg" ? "Engle-Granger" : "Phillips-Ouliaris"
    endif
    return r
end function

# -------------------------------------------------------------------
# Seasonal adjustment by moving averages: series.seas(m|a)
# -------------------------------------------------------------------

function series ev_seasadj (series x "Monthly or quarterly series",
                            string kind[null] "m (multiplicative) or a (additive)",
                            series *factors[null] "Output: seasonal factors")
    errorif($pd != 4 && $pd != 12, "Seasonal adjustment needs quarterly or monthly data")
    string k = exists(kind) ? tolower(kind) : "m"
    errorif(k != "m" && k != "a", "kind must be m or a")
    errorif(k == "m" && min(x) <= 0, "Multiplicative adjustment needs positive values")
    scalar s = $pd
    scalar h = s / 2
    # centred 2 x s moving average
    set skip_missing off
    matrix v = {x}
    matrix mv = 0.5 * mlag(v, h, NA) + 0.5 * mlag(v, -h, NA)
    scalar jlo = 1 - h
    loop j = jlo..h-1
        mv += mlag(v, j, NA)
    endloop
    series ma = mv / s
    series ratio = k == "m" ? x / ma : x - ma
    series per = $obsminor
    matrix idx = zeros(s, 1)
    loop j = 1..s
        series sel = per == j && ok(ratio)
        idx[j] = sum(sel ? ratio : 0) / sum(sel)
    endloop
    # normalise: product 1 (multiplicative) or sum 0 (additive)
    if k == "m"
        idx = idx / exp(meanc(log(idx)))
    else
        idx = idx - meanc(idx)
    endif
    series sf = 0
    loop j = 1..s
        sf = per == j ? idx[j] : sf
    endloop
    if exists(factors)
        factors = sf
    endif
    return k == "m" ? x / sf : x - sf
end function

# -------------------------------------------------------------------
# VAR views: AR roots, residual serial correlation LM, normality; VAR forecast
# -------------------------------------------------------------------

function matrix ev_varroots (bundle v "ev_varest result", bool quiet[0])
    # roots of the characteristic polynomial = eigenvalues of the companion matrix
    matrix A = v.sys.A
    matrix ev = eigen(A)
    matrix re = Re(ev)
    matrix im = Im(ev)
    matrix md = sqrt(re.^2 + im.^2)
    # sort by modulus, largest first
    matrix o = msortby(seq(1, rows(md))' ~ -md, 2)
    matrix S = zeros(rows(md), 3)
    loop i = 1..rows(md)
        scalar j = o[i, 1]
        S[i,] = re[j] ~ im[j] ~ md[j]
    endloop
    if !quiet
        printf "\nRoots of Characteristic Polynomial\nEndogenous variables:"
        loop i = 1..nelem(v.ylab)
            printf " %s", v.ylab[i]
        endloop
        printf "\nLag specification: %d %d\n\n", v.lags[1], v.lags[2]
        printf "%-36s%14s\n", "Root", "Modulus"
        ev__line(52)
        loop i = 1..rows(S)
            if abs(S[i, 2]) < 1e-12
                printf "%-36.6f%14.6f\n", S[i, 1], S[i, 3]
            else
                printf "%-36s%14.6f\n", sprintf("%.6f %s %.6fi", S[i, 1], S[i, 2] < 0 ? "-" : "+", abs(S[i, 2])), S[i, 3]
            endif
        endloop
        ev__line(52)
        if maxc(S[, 3]) < 1
            printf "No root lies outside the unit circle.\nVAR satisfies the stability condition.\n"
        else
            printf "Warning: at least one root lies outside the unit circle.\nVAR does not satisfy the stability condition.\n"
        endif
    endif
    return S
end function

function matrix ev_varlm (bundle v "ev_varest result", int h[1::4] "Number of lags to test", bool quiet[0])
    # Breusch-Godfrey LM tests for residual serial correlation (Lutkepohl):
    # LM = T (n - tr(inv(S_u) S_e)), chi-square(n^2 m); rows: lag j alone and lags 1..j
    matrix U = v.sys.uhat
    matrix X = v.sys.X
    scalar T = rows(U)
    scalar n = cols(U)
    matrix Su = U'U / T
    matrix R = {}
    loop j = 1..h
        loop kind = 1..2
            matrix Z = X
            scalar m = 0
            loop l = 1..j
                if kind == 2 || l == j
                    Z ~= mlag(U, l, 0)
                    m++
                endif
            endloop
            matrix E = U - Z * mols(U, Z)
            matrix Se = E'E / T
            scalar lm = T * (n - tr(inv(Su) * Se))
            scalar df = n^2 * m
            R |= {j, kind, lm, df, pvalue(c, df, lm)}
        endloop
    endloop
    if !quiet
        printf "\nVAR Residual Serial Correlation LM Tests\nSample: %s\nIncluded observations: %d\n", v.sample, T
        printf "\nNull hypothesis: No serial correlation at lag h\n"
        printf "%6s%14s%8s%10s\n", "Lag", "LM-Stat", "df", "Prob."
        loop i = 1..rows(R)
            if R[i, 2] == 1
                printf "%6d%14.6f%8d%10.4f\n", R[i, 1], R[i, 3], R[i, 4], R[i, 5]
            endif
        endloop
        printf "\nNull hypothesis: No serial correlation at lags 1 to h\n"
        printf "%6s%14s%8s%10s\n", "Lag", "LM-Stat", "df", "Prob."
        loop i = 1..rows(R)
            if R[i, 2] == 2
                printf "%6d%14.6f%8d%10.4f\n", R[i, 1], R[i, 3], R[i, 4], R[i, 5]
            endif
        endloop
        printf "*LM statistic, chi-square distribution\n"
    endif
    return R
end function

function bundle ev_varnorm (bundle v "ev_varest result", bool quiet[0])
    # Jarque-Bera normality tests on Cholesky-orthogonalised residuals (Lutkepohl)
    matrix U = v.sys.uhat
    scalar T = rows(U)
    scalar n = cols(U)
    matrix Uc = U .- meanc(U)
    matrix S = Uc'Uc / T
    matrix P = cholesky(S)
    matrix W = Uc * inv(P')
    matrix sk = meanc(W.^3)
    matrix ku = meanc(W.^4)
    matrix ls = T * sk.^2 / 6
    matrix lk = T * (ku - 3).^2 / 24
    bundle r
    r.skew = sk'
    r.kurt = ku'
    r.skew_chi = ls'
    r.kurt_chi = lk'
    r.jb = ls' + lk'
    r.skew_joint = sumr(ls)
    r.kurt_joint = sumr(lk)
    r.jb_joint = r.skew_joint + r.kurt_joint
    r.skew_p = pvalue(c, n, r.skew_joint)
    r.kurt_p = pvalue(c, n, r.kurt_joint)
    r.jb_p = pvalue(c, 2 * n, r.jb_joint)
    if !quiet
        printf "\nVAR Residual Normality Tests\nOrthogonalization: Cholesky (Lutkepohl)\n"
        printf "Null Hypothesis: Residuals are multivariate normal\nIncluded observations: %d\n\n", T
        printf "%-12s%14s%14s%8s%10s\n", "Component", "Skewness", "Chi-sq", "df", "Prob."
        loop i = 1..n
            printf "%-12d%14.6f%14.6f%8d%10.4f\n", i, sk[i], ls[i], 1, pvalue(c, 1, ls[i])
        endloop
        printf "%-12s%14s%14.6f%8d%10.4f\n\n", "Joint", "", r.skew_joint, n, r.skew_p
        printf "%-12s%14s%14s%8s%10s\n", "Component", "Kurtosis", "Chi-sq", "df", "Prob."
        loop i = 1..n
            printf "%-12d%14.6f%14.6f%8d%10.4f\n", i, ku[i], lk[i], 1, pvalue(c, 1, lk[i])
        endloop
        printf "%-12s%14s%14.6f%8d%10.4f\n\n", "Joint", "", r.kurt_joint, n, r.kurt_p
        printf "%-12s%14s%8s%10s\n", "Component", "Jarque-Bera", "df", "Prob."
        loop i = 1..n
            printf "%-12d%14.6f%8d%10.4f\n", i, r.jb[i], 2, pvalue(c, 2, r.jb[i])
        endloop
        printf "%-12s%14.6f%8d%10.4f\n", "Joint", r.jb_joint, 2 * n, r.jb_p
    endif
    return r
end function

function bundle ev_varfcast (bundle v "ev_varest result",
                             list vars "Series used (e.g. dataset)",
                             bool dynamic[1] "Dynamic (1) or static (0)",
                             bool quiet[0])
    # forecasts of every endogenous variable over the current sample, with S.E.
    scalar n = v.n
    matrix lg = v.lags
    scalar p = maxr(lg)
    matrix C = v.coeff                     # k x n, rows as in v.clab
    set skip_missing off
    series evf_o = obs
    matrix tob = {evf_o}
    scalar T = rows(tob)
    # actual values and actual lags (pre-sample data included)
    matrix Ya = {}
    matrices YL = array(p)
    loop j = 1..p
        YL[j] = {}
    endloop
    loop i = 1..n
        series evf_y = ev_gen(v.ytok[i], vars)
        Ya ~= {evf_y}
        loop j = 1..p
            series evf_l = ev_gen(ev__lagx(v.ytok[i], j, vars), vars)
            matrix M = YL[j]
            YL[j] = M ~ {evf_l}
        endloop
    endloop
    matrix XE = {}
    loop i = 1..nelem(v.xtok)
        if tolower(v.xtok[i]) != "c"
            series evf_x = ev_gen(v.xtok[i], vars)
            XE ~= {evf_x}
        endif
    endloop
    matrix F = zeros(T, n)
    loop t = 1..T
        # regressor row in the order of v.clab: C, then each variable with its lags, then exogenous
        matrix row = {}
        if v.hasc
            row ~= 1
        endif
        loop i = 1..n
            loop jj = 1..cols(lg)
                scalar j = lg[jj]
                if dynamic && t - j >= 1
                    row ~= F[t - j, i]
                else
                    matrix M = YL[j]
                    row ~= M[t, i]
                endif
            endloop
        endloop
        if cols(XE) > 0
            row ~= XE[t,]
        endif
        F[t,] = row * C
    endloop
    # forecast standard errors from the MA representation (dynamic) or one step (static)
    matrix A = v.sys.A
    matrix Sg = v.sys.sigma
    scalar np = rows(A)
    matrix J = I(n) ~ zeros(n, np - n)
    matrix SE = zeros(T, n)
    matrix Mse = zeros(n, n)
    matrix Ap = I(np)
    loop h = 1..T
        matrix Phi = J * Ap * J'
        Mse += Phi * Sg * Phi'
        SE[h,] = sqrt(diag(dynamic ? Mse : Sg))'
        Ap = Ap * A
    endloop
    bundle r
    r.fcast = F
    r.se = SE
    r.actual = Ya
    r.tobs = tob
    r.names = v.ylab
    r.dynamic = dynamic
    if !quiet
        printf "\nVAR %s forecast, %s - %s\n", dynamic ? "dynamic" : "static", obslabel(minc(tob)), obslabel(maxc(tob))
        printf "%-12s", "obs"
        loop i = 1..n
            printf "%16s%12s", v.ylab[i], "S.E."
        endloop
        printf "\n"
        loop t = 1..T
            printf "%-12s", obslabel(tob[t])
            loop i = 1..n
                printf "%16.6f%12.6f", F[t, i], SE[t, i]
            endloop
            printf "\n"
        endloop
    endif
    return r
end function

function series ev_varfseries (bundle r "ev_varfcast result", int i[1::1] "Variable number",
                               bool se[0] "Return the S.E. instead of the forecast")
    return ev__toseries(se ? r.se[, i] : r.fcast[, i], r.tobs)
end function

# -------------------------------------------------------------------
# Frequency conversion between pages (copy(c=...) page\series)
# -------------------------------------------------------------------

function series ev__epochdays (void)
    # calendar day number (days since 1 Jan 1 AD, day 1) of each observation's start
    errorif($datatype != 2, "Frequency conversion needs dated time-series pages")
    series d = $obsdate
    series y = floor(d / 10000)
    series m = floor(d / 100) - 100 * y
    series dd = d - 10000 * y - 100 * m
    series r = NA
    loop t = 1..$nobs
        r[t] = epochday(y[t], m[t], dd[t])
    endloop
    return r
end function

function matrix ev_pagecol (series x "Series of the source page")
    # [day number, value] of every observation, for ev_freqconv
    set skip_missing off
    series d = ev__epochdays()
    return {d} ~ {x}
end function

function series ev_freqconv (const matrix S "ev_pagecol() of the source series",
                             string method[null] "a s f l x n (high to low); r d i q t c (low to high)")
    # convert to the frequency of the current page, as EViews copy(c=...)
    set skip_missing off
    series d = ev__epochdays()
    matrix D = {d}
    scalar T = rows(D)
    scalar ns = rows(S)
    # length of a period: next start date (the last one: same spacing as before)
    matrix Dn = D[2:T] | (2 * D[T] - D[T - 1])
    matrix Sn = S[2:ns, 1] | (2 * S[ns, 1] - S[ns - 1, 1])
    scalar tgt_len = meanc(Dn - D)
    scalar src_len = meanc(Sn - S[, 1])
    string m = exists(method) ? tolower(method) : (src_len < tgt_len ? "a" : "r")
    series r = NA
    if src_len < tgt_len
        errorif(!instring(" a s f l x n ", " " ~ m ~ " "), "high to low frequency: c=a, s, f, l, x or n")
        loop t = 1..T
            matrix in = (S[, 1] .>= D[t]) .* (S[, 1] .< Dn[t])
            if sumc(in) > 0
                matrix v = selifr(S[, 2], in)
                if sumc(!ok(v)) == 0
                    if m == "a"
                        r[t] = meanc(v)
                    elif m == "s"
                        r[t] = sumc(v)
                    elif m == "f"
                        r[t] = v[1]
                    elif m == "l"
                        r[t] = v[rows(v)]
                    elif m == "x"
                        r[t] = maxc(v)
                    else
                        r[t] = minc(v)
                    endif
                endif
            endif
        endloop
    else
        errorif(!instring(" r d i q t c ", " " ~ m ~ " "), \
          "low to high frequency: c=r, d, i, q (quadratic match average), t (quadratic match sum) or c (cubic match last)")
        # the source period that contains each target date
        matrix j = zeros(T, 1)
        loop t = 1..T
            matrix in = (S[, 1] .<= D[t]) .* (Sn .> D[t])
            j[t] = sumc(in) > 0 ? imaxc(in) : 0
        endloop
        if m == "q" || m == "t" || m == "c"
            # high-frequency periods per source period, and the position of each target in its period
            scalar mm = round(src_len / tgt_len)
            matrix pos = zeros(T, 1)
            loop t = 1..T
                if j[t] > 0
                    pos[t] = sumc(j[1:t] .= j[t])
                endif
            endloop
            # (a first source period cut by the page start is counted back from its end below)
            errorif(ns < 3, "Quadratic and cubic conversions need at least 3 source observations")
            matrix Y = S[, 2]
            if m == "c"
                # natural cubic spline through the last high-frequency position of each source period
                matrix xk = seq(1, ns)' * mm
                matrix h = xk[2:ns] - xk[1:ns-1]
                matrix A = zeros(ns, ns)
                matrix rhs = zeros(ns, 1)
                A[1, 1] = 1
                A[ns, ns] = 1
                loop i = 2..ns - 1
                    A[i, i - 1] = h[i - 1]
                    A[i, i] = 2 * (h[i - 1] + h[i])
                    A[i, i + 1] = h[i]
                    rhs[i] = 6 * ((Y[i + 1] - Y[i]) / h[i] - (Y[i] - Y[i - 1]) / h[i - 1])
                endloop
                matrix M2 = inv(A) * rhs
                loop t = 1..T
                    if j[t] > 0
                        scalar k = j[t]
                        scalar x = (k - 1) * mm + pos[t] + (mm - sumc(j .= k)) * (k == 1)
                        scalar i = max(1, min(ns - 1, floor((x - xk[1]) / mm) + 1))
                        if x < xk[1]
                            i = 1
                        endif
                        scalar hh = xk[i + 1] - xk[i]
                        scalar a1 = (xk[i + 1] - x) / hh
                        scalar b1 = (x - xk[i]) / hh
                        r[t] = a1 * Y[i] + b1 * Y[i + 1] + ((a1^3 - a1) * M2[i] + (b1^3 - b1) * M2[i + 1]) * hh^2 / 6
                    endif
                endloop
            else
                # quadratic through each source period and its neighbours, matching their averages (or sums)
                loop t = 1..T
                    if j[t] > 0
                        scalar k = j[t]
                        scalar k0 = k == 1 ? 1 : (k == ns ? ns - 2 : k - 1)
                        k0 = max(1, k0)
                        matrix Am = zeros(3, 3)
                        matrix bv = zeros(3, 1)
                        loop q = 1..3
                            scalar pq = k0 + q - 1
                            matrix sj = (pq - 1) * mm + seq(1, mm)'
                            Am[q,] = {1, meanc(sj), meanc(sj.^2)}
                            bv[q] = m == "q" ? Y[pq] : Y[pq] / mm
                        endloop
                        matrix cf = inv(Am) * bv
                        scalar x = (k - 1) * mm + pos[t] + (mm - sumc(j .= k)) * (k == 1)
                        r[t] = cf[1] + cf[2] * x + cf[3] * x^2
                    endif
                endloop
            endif
        elif m == "i"
            # linear interpolation, matching the source value in the last period of each source period
            matrix xs = {}
            matrix ys = {}
            loop k = 1..ns
                matrix in = j .= k
                if sumc(in) > 0
                    scalar last = 0
                    loop t = 1..T
                        if in[t]
                            last = t
                        endif
                    endloop
                    xs |= last
                    ys |= S[k, 2]
                endif
            endloop
            loop t = 1..T
                loop k = 1..rows(xs) - 1
                    if t >= xs[k] && t <= xs[k + 1]
                        r[t] = ys[k] + (ys[k + 1] - ys[k]) * (t - xs[k]) / (xs[k + 1] - xs[k])
                    endif
                endloop
            endloop
        else
            loop t = 1..T
                scalar k = j[t]
                if k > 0
                    scalar cnt = m == "d" ? sumc(j .= k) : 1
                    r[t] = S[k, 2] / cnt
                endif
            endloop
        endif
    endif
    return r
end function

# -------------------------------------------------------------------
# String and date functions (EViews @left, @mid, @instr, @word, @dateval, ...)
# -------------------------------------------------------------------

function string ev_left (string s, int n)
    if n <= 0
        return ""
    endif
    return substr(s, 1, min(n, strlen(s)))
end function

function string ev_right (string s, int n)
    scalar L = strlen(s)
    if n <= 0 || L == 0
        return ""
    endif
    return substr(s, max(1, L - n + 1), L)
end function

function string ev_mid (string s, int n1, int n2[-1])
    scalar L = strlen(s)
    if n1 > L || n2 == 0
        return ""
    endif
    scalar e = n2 < 0 ? L : min(L, n1 + n2 - 1)
    return substr(s, max(1, n1), e)
end function

function scalar ev_instr (string s, string t, int nth[1::1])
    # position of the nth occurrence of t in s (0 if not found), as EViews @instr
    scalar base = 0
    string rest = s
    loop k = 1..nth
        if !instring(rest, t)
            return 0
        endif
        scalar p = strlen(rest) - strlen(strstr(rest, t)) + 1
        if k == nth
            return base + p
        endif
        if p >= strlen(rest)
            return 0
        endif
        base += p
        rest = substr(rest, p + 1, strlen(rest))
    endloop
    return 0
end function

function string ev_word (string s, int n)
    strings w = strsplit(s)
    if n < 1 || n > nelem(w)
        return ""
    endif
    return w[n]
end function

function scalar ev_dateval (string s, string fmt[null] "EViews format, e.g. YYYY-MM-DD or MM/DD/YYYY")
    # EViews date number (days since 1 Jan 1 AD, starting at 0)
    string f = exists(fmt) ? fmt : (instring(s, "/") ? "MM/DD/YYYY" : "YYYY-MM-DD")
    f = strsub(strsub(strsub(toupper(f), "YYYY", "%Y"), "MM", "%m"), "DD", "%d")
    scalar sec = strptime(s, f)
    errorif(!ok(sec), "Cannot read the date " ~ s)
    return round(sec / 86400) + 719162         # strptime reads local time: round to the day
end function

function string ev_datestr (scalar d "EViews date number", string fmt[null] "EViews format, default YYYY-MM-DD")
    string f = exists(fmt) ? fmt : "YYYY-MM-DD"
    f = strsub(strsub(strsub(toupper(f), "YYYY", "%Y"), "MM", "%m"), "DD", "%d")
    return strftime((d - 719162) * 86400 + 43200, f)   # noon UTC: the same day in any time zone
end function

function series ev_date (void)
    # EViews @date: date number of each observation
    series r = ev__epochdays()
    return r - 1
end function

# -------------------------------------------------------------------
# Table objects: table(r,c) t, t(i,j) = v, t.setcell, t.setwidth, t.save
# -------------------------------------------------------------------

function bundle ev_table (int r[1::1], int c[1::1])
    bundle t
    t.kind = "table"
    t.rows = r
    t.cols = c
    strings cells = array(r * c)
    loop i = 1..r * c
        cells[i] = ""
    endloop
    t.cells = cells
    t.width = 10 * ones(1, c)
    return t
end function

function void ev__tgrow (bundle *t, int i, int j)
    # tables grow when a cell outside them is set (as EViews)
    if i > t.rows || j > t.cols
        scalar r = max(i, t.rows)
        scalar c = max(j, t.cols)
        strings nc = array(r * c)
        loop a = 1..r
            loop b = 1..c
                nc[(a - 1) * c + b] = ""
                if a <= t.rows && b <= t.cols
                    nc[(a - 1) * c + b] = t.cells[(a - 1) * t.cols + b]
                endif
            endloop
        endloop
        matrix w = 10 * ones(1, c)
        w[1:t.cols] = t.width
        t.cells = nc
        t.width = w
        t.rows = r
        t.cols = c
    endif
end function

function void ev_tset (bundle *t, int i[1::], int j[1::], string v)
    ev__tgrow(&t, i, j)
    strings cl = t.cells
    cl[(i - 1) * t.cols + j] = v
    t.cells = cl
end function

function void ev_tsetnum (bundle *t, int i[1::], int j[1::], scalar v)
    ev_tset(&t, i, j, ok(v) ? sprintf("%.8g", v) : "NA")
end function

function string ev_tget (bundle t, int i, int j)
    if i > t.rows || j > t.cols
        return ""
    endif
    return t.cells[(i - 1) * t.cols + j]
end function

function void ev_twidth (bundle *t, int j[1::], int w[1::])
    ev__tgrow(&t, 1, j)
    matrix ww = t.width
    ww[j] = w
    t.width = ww
end function

function string ev_ttext (bundle t, string fmt[null] "txt, csv or html")
    string f = exists(fmt) ? tolower(fmt) : "txt"
    string out = ""
    string nl = sprintf("\n")             # string literals do not expand \n
    if f == "html"
        out = "<table>" ~ nl
    endif
    loop i = 1..t.rows
        string line = ""
        loop j = 1..t.cols
            string v = t.cells[(i - 1) * t.cols + j]
            if f == "csv"
                line ~= (j > 1 ? "," : "") ~ (instring(v, ",") || instring(v, "\"") ? "\"" ~ strsub(v, "\"", "\"\"") ~ "\"" : v)
            elif f == "html"
                line ~= "<td>" ~ v ~ "</td>"
            else
                string fm = sprintf("%%%ds", t.width[j])
                line ~= sprintf(fm, v)
            endif
        endloop
        out ~= f == "html" ? "<tr>" ~ line ~ "</tr>" ~ nl : line ~ nl
    endloop
    if f == "html"
        out ~= "</table>" ~ nl
    endif
    return out
end function

function void ev_tprint (bundle t)
    printf "%s", ev_ttext(t, "txt")
end function

function void ev_tsave (bundle t, string fname, string fmt[null] "txt, csv or html")
    string f = exists(fmt) ? tolower(fmt) : "csv"
    string txt = ev_ttext(t, f)
    outfile "@fname" --quiet
        printf "%s", txt
    end outfile
end function

# -------------------------------------------------------------------
# Maximum likelihood and other single-equation estimators:
# ordered choice, censored (tobit), count, quantile regression
# -------------------------------------------------------------------

function bundle ev_mlreg (string spec "Equation, e.g. y c x",
                          list vars "Series used (e.g. dataset)",
                          string method "ologit, oprobit, tobit, poisson, negbin or qreg",
                          scalar p1[NA] "tobit: left limit (default 0); qreg: quantile (default 0.5)",
                          scalar p2[NA] "tobit: right limit (default none)",
                          bool quiet[0])
    string m = tolower(method)
    errorif(!instring(" ologit oprobit tobit poisson negbin qreg ", " " ~ m ~ " "), "unknown method " ~ method)
    strings tok = strsplit(spec)
    series evm_y = ev_gen(tok[1], vars)
    list X = null
    strings lab = array(0)
    scalar hascon = 0
    loop i = 2..nelem(tok)
        if tolower(tok[i]) == "c"
            list X += const
            lab += "C"
            hascon = 1
        else
            string v = sprintf("evm_x%d", i)
            series @v = ev_gen(tok[i], vars)
            list X += @v
            lab += toupper(tok[i])
        endif
    endloop
    errorif((m == "ologit" || m == "oprobit") && hascon, "Ordered models have no constant (the limit points take its place): drop c")
    scalar n0 = $nobs
    scalar tau = ok(p1) ? p1 : 0.5
    if m == "ologit"
        logit evm_y X --quiet
    elif m == "oprobit"
        probit evm_y X --quiet
    elif m == "tobit"
        scalar ll = ok(p1) ? p1 : 0
        if ok(p2)
            tobit evm_y X --llimit=ll --rlimit=p2 --quiet
        else
            tobit evm_y X --llimit=ll --quiet
        endif
    elif m == "poisson"
        poisson evm_y X --quiet
    elif m == "negbin"
        negbin evm_y X --quiet
    else
        quantreg tau evm_y X --quiet
    endif
    bundle b
    b.kind = "mlreg"
    b.method = m
    b.spec = spec
    b.depvar = toupper(tok[1])
    matrix c = $coeff
    matrix se = $stderr
    matrix V = $vcv
    scalar k = rows(c)
    scalar kx = nelem(X)
    # extra parameters after the regressors: limit points, NB dispersion
    loop i = kx + 1..k
        if m == "ologit" || m == "oprobit"
            lab += sprintf("LIMIT_%d:C(%d)", i - kx, i)
        elif m == "negbin"
            lab += sprintf("ALPHA:C(%d)", i)
        else
            lab += sprintf("C(%d)", i)
        endif
    endloop
    if m == "tobit"
        # EViews reports the scale with the coefficients
        lab += sprintf("SCALE:C(%d)", k + 1)
        c |= $sigma
        se |= NA
        k++
    endif
    b.labels = lab
    b.coeff = c
    b.stderr = se
    b.vcv = V
    b.k = k
    b.T = $T
    b.adjusted = $T < n0
    catch scalar lnl = $lnl
    if $error
        lnl = NA
    endif
    b.lnl = lnl
    b.tstat = c ./ se
    b.zstat = m != "qreg"
    matrix pv = zeros(k, 1)
    loop i = 1..k
        pv[i] = b.zstat ? 2 * cnorm(-abs(b.tstat[i])) : 2 * pvalue(t, $T - k, abs(b.tstat[i]))
    endloop
    b.pval = pv
    series evm_o = obs
    catch series evm_f = $yhat
    if $error
        series evm_f = NA
    endif
    list L = evm_y evm_o
    matrix D = {L}
    b.y = D[, 1]
    b.tobs = D[, 2]
    set skip_missing off
    matrix F = {evm_f}
    b.yhat = ev__atrows(F, b.tobs)
    b.uhat = b.y - b.yhat
    b.sample = sprintf("%s %s", obslabel(minc(b.tobs)), obslabel(maxc(b.tobs)))
    scalar n = b.T
    b.meany = meanc(b.y)
    b.sdy = sdc(b.y) * sqrt(n / (n - 1))
    if ok(lnl)
        b.aic = -2 * lnl / n + 2 * k / n
        b.sc = -2 * lnl / n + k * log(n) / n
        b.hq = -2 * lnl / n + 2 * k * log(log(n)) / n
        b.avglnl = lnl / n
    endif
    if m == "qreg"
        # pseudo R-squared (Koenker-Machado): 1 - V(tau) / V(tau | constant only)
        b.tau = tau
        matrix u = b.uhat
        scalar Vt = sumc(u .* (tau - (u .< 0)))
        scalar q = quantile(b.y, tau)
        matrix u0 = b.y - q
        scalar V0 = sumc(u0 .* (tau - (u0 .< 0)))
        b.pseudo_r2 = 1 - Vt / V0
        b.adj_pseudo_r2 = 1 - (1 - b.pseudo_r2) * (n - 1) / (n - k)
        b.qdep = q
    endif
    if m == "ologit" || m == "oprobit"
        b.ncat = rows(values(b.y))
    endif
    b.estdate = strftime($now[1], "%m/%d/%y   Time: %H:%M")
    if !quiet
        ev_mlprint(&b)
    endif
    return b
end function

function matrix ev__atrows (const matrix F, const matrix tobs)
    # rows tobs (observation numbers) of a full-sample column, relative to the sample start
    scalar o1 = $t1
    matrix r = zeros(rows(tobs), 1)
    loop i = 1..rows(tobs)
        scalar t = tobs[i] - o1 + 1
        r[i] = t >= 1 && t <= rows(F) ? F[t] : NA
    endloop
    return r
end function

function void ev_mlprint (bundle *b)
    string title = b.method == "ologit" ? "ML - Ordered Logit (Newton-Raphson)" : \
      (b.method == "oprobit" ? "ML - Ordered Probit (Newton-Raphson)" : \
      (b.method == "tobit" ? "ML - Censored Normal (TOBIT) (Newton-Raphson)" : \
      (b.method == "poisson" ? "ML/QML - Poisson Count (Newton-Raphson)" : \
      (b.method == "negbin" ? "ML - Negative Binomial Count (Newton-Raphson)" : "Quantile Regression"))))
    printf "\nDependent Variable: %s\nMethod: %s\nDate: %s\n", b.depvar, title, b.estdate
    printf "Sample%s: %s\nIncluded observations: %d\n", b.adjusted ? " (adjusted)" : "", b.sample, b.T
    if b.method == "qreg"
        printf "Quantile: %g\n", b.tau
    endif
    printf "\n"
    ev__line(78)
    printf "%-26s%13s%13s%14s%12s\n", "Variable", "Coefficient", "Std. Error", b.zstat ? "z-Statistic" : "t-Statistic", "Prob."
    ev__line(78)
    loop i = 1..b.k
        if ok(b.stderr[i])
            printf "%-26s%13.6f%13.6f%14.6f%12.4f\n", b.labels[i], b.coeff[i], b.stderr[i], b.tstat[i], b.pval[i]
        else
            printf "%-26s%13.6f\n", b.labels[i], b.coeff[i]
        endif
    endloop
    ev__line(78)
    if b.method == "qreg"
        printf "%-22s%14.6f    %-24s%14.6f\n", "Pseudo R-squared", b.pseudo_r2, "Mean dependent var", b.meany
        printf "%-22s%14.6f    %-24s%14.6f\n", "Adjusted R-squared", b.adj_pseudo_r2, "S.D. dependent var", b.sdy
        printf "%-22s%14.6f\n", "Quantile dependent var", b.qdep
    else
        printf "%-22s%14.6f    %-24s%14.6f\n", "Mean dependent var", b.meany, "S.D. dependent var", b.sdy
        printf "%-22s%14.6f    %-24s%14.6f\n", "Akaike info criterion", b.aic, "Schwarz criterion", b.sc
        printf "%-22s%14.6f    %-24s%14.6f\n", "Log likelihood", b.lnl, "Hannan-Quinn criter.", b.hq
        printf "%-22s%14.6f\n", "Avg. log likelihood", b.avglnl
    endif
    ev__line(78)
end function

function void ev_coefprint (bundle *b)
    # generic coefficient table (cointegrating regressions, dynamic panels)
    printf "\nDependent Variable: %s\nMethod: %s\n", b.depvar, b.method
    if inbundle(b, "sample")
        printf "Sample: %s\n", b.sample
    endif
    printf "Included observations: %d\n\n", b.T
    ev__line(78)
    printf "%-26s%13s%13s%14s%12s\n", "Variable", "Coefficient", "Std. Error", "t-Statistic", "Prob."
    ev__line(78)
    loop i = 1..b.k
        printf "%-26s%13.6f%13.6f%14.6f%12.4f\n", b.labels[i], b.coeff[i], b.stderr[i], b.tstat[i], b.pval[i]
    endloop
    ev__line(78)
end function

# -------------------------------------------------------------------
# Weighted least squares: ls(w=series, wtype=istdev|ivar|stdev|var)
# -------------------------------------------------------------------

function bundle ev_wls (string spec "Equation, e.g. y c x", list vars "Series used (e.g. dataset)",
                        string wexpr "Weight series or expression",
                        string wtype[null] "istdev (default), ivar, stdev or var",
                        bool quiet[0])
    string wt = exists(wtype) ? tolower(wtype) : "istdev"
    errorif(!instring(" istdev ivar stdev var ", " " ~ wt ~ " "), "wtype must be istdev, ivar, stdev or var")
    strings tok = strsplit(spec)
    series evw_y = ev_gen(tok[1], vars)
    series evw_s = ev_gen(wexpr, vars)
    # gretl wls minimises sum(w * u^2): EViews weights multiply the residuals
    series evw_w = wt == "istdev" ? 1 / evw_s^2 : (wt == "ivar" ? 1 / evw_s : (wt == "stdev" ? evw_s^2 : evw_s))
    list X = null
    strings lab = array(0)
    scalar hascon = 0
    loop i = 2..nelem(tok)
        if tolower(tok[i]) == "c"
            list X += const
            lab += "C"
            hascon = 1
        else
            string v = sprintf("evw_x%d", i)
            series @v = ev_gen(tok[i], vars)
            list X += @v
            lab += toupper(tok[i])
        endif
    endloop
    scalar n0 = $nobs
    wls evw_w evw_y X --quiet
    bundle b
    b.spec = spec
    b.method = "Least Squares"
    b.eqline = sprintf("Weighting series: %s\nWeight type: %s", toupper(wexpr), \
      wt == "istdev" ? "Inverse standard deviation" : (wt == "ivar" ? "Inverse variance" : (wt == "stdev" ? "Standard deviation" : "Variance")))
    b.depvar = toupper(tok[1])
    b.labels = lab
    b.covtype = "ordinary"
    b.coeff = $coeff
    b.stderr = $stderr
    b.vcv = $vcv
    b.T = $T
    b.k = $ncoeff
    b.rsq = $rsq
    b.adjrsq = 1 - (1 - $rsq) * ($T - 1) / ($T - $ncoeff)
    b.sigma = $sigma
    b.ssr = $ess
    b.lnl = $lnl
    b.dw = $dw
    b.hascon = hascon
    b.adjusted = $T < n0
    b.estdate = strftime($now[1], "%m/%d/%y   Time: %H:%M")
    series evw_u = $uhat
    series evw_f = $yhat
    smpl ok(evw_u) --restrict
    b.y = {evw_y}
    b.X = {X}
    b.uhat = {evw_u}
    b.yhat = {evw_f}
    series evw_o = obs
    b.tobs = {evw_o}
    b.sample = sprintf("%s %s", obslabel($t1), obslabel($t2))
    scalar n = b.T
    scalar k = b.k
    matrix d = b.y - meanc(b.y)
    b.meany = meanc(b.y)
    b.sdy = sqrt(d'd / (n - 1))
    b.aic = -2 * b.lnl / n + 2 * k / n
    b.sc = -2 * b.lnl / n + k * log(n) / n
    b.hq = -2 * b.lnl / n + 2 * k * log(log(n)) / n
    b.F = NA
    b.Fp = NA
    if hascon && k > 1
        b.F = (b.rsq / (k - 1)) / ((1 - b.rsq) / (n - k))
        b.Fp = pvalue(F, k - 1, n - k, b.F)
    endif
    b.tstat = b.coeff ./ b.stderr
    matrix p = zeros(k, 1)
    loop i = 1..k
        p[i] = 2 * pvalue(t, n - k, abs(b.tstat[i]))
    endloop
    b.pval = p
    if !quiet
        ev_print(&b)
    endif
    return b
end function

# -------------------------------------------------------------------
# Cointegrating regressions: DOLS and FMOLS (equation.cointreg)
# -------------------------------------------------------------------

function matrix ev__lrcov (const matrix U, scalar bw, bool onesided)
    # Bartlett-kernel long-run covariance (onesided: sum over j >= 0 only)
    scalar T = rows(U)
    matrix S = U'U / T
    matrix O = S
    scalar jmax = floor(bw)
    loop j = 1..jmax
        if j < T
            matrix G = U[j+1:T,]' * U[1:T-j,] / T     # Gamma(j) = E u_t u_{t-j}'
            scalar w = 1 - j / (bw + 1)
            if onesided
                O += w * G'
            else
                O += w * (G + G')
            endif
        endif
    endloop
    return O
end function

function bundle ev_cointreg (string spec "Cointegrating equation: y x1 x2 (a constant is added)",
                             list vars "Series used (e.g. dataset)",
                             string method[null] "dols (default), fmols or ccr",
                             int nlead[0::1] "DOLS leads of the differenced regressors",
                             int nlag[0::1] "DOLS lags of the differenced regressors",
                             string trend[null] "const (default), linear or none",
                             bool quiet[0])
    string m = exists(method) ? tolower(method) : "dols"
    errorif(m != "dols" && m != "fmols" && m != "ccr", "method must be dols, fmols or ccr")
    string tr = exists(trend) ? tolower(trend) : "const"
    strings tok = strsplit(spec)
    scalar kx = nelem(tok) - 1
    errorif(kx < 1, "Give the dependent variable and at least one regressor")
    set skip_missing off
    series evc_y = ev_gen(tok[1], vars)
    matrix Y = {evc_y}
    matrix X = {}
    matrix DX = {}
    loop i = 1..kx
        series evc_x = ev_gen(tok[i+1], vars)
        series evc_l = ev_gen(ev__lagx(tok[i+1], 1, vars), vars)
        X ~= {evc_x}
        DX ~= {evc_x} - {evc_l}
    endloop
    series evc_o = obs
    matrix tob = {evc_o}
    scalar T0 = rows(Y)
    matrix Dt = {}
    if tr != "none"
        Dt ~= ones(T0, 1)
    endif
    if tr == "linear"
        Dt ~= seq(0, T0 - 1)'
    endif
    strings lab = array(0)
    loop i = 1..kx
        lab += toupper(tok[i+1])
    endloop
    if tr != "none"
        lab += "C"
    endif
    if tr == "linear"
        lab += "@TREND"
    endif
    bundle b
    if m == "dols"
        # regressors in levels, deterministic terms, leads and lags of the differences
        matrix W = X ~ Dt
        scalar jlo = -nlead
        loop j = jlo..nlag
            W ~= mlag(DX, j, NA)
        endloop
        matrix okr = sumr(!ok(Y ~ W)) .= 0
        matrix y = selifr(Y, okr)
        matrix Z = selifr(W, okr)
        tob = selifr(tob, okr)
        matrix e = {}
        matrix bh = mols(y, Z, &e)
        scalar n = rows(y)
        scalar kk = cols(Z)
        scalar s2 = e'e / (n - kk)
        # EViews default: OLS covariance rescaled by the long-run residual variance
        scalar bw = ev__nwbw(e)
        scalar lr = ev__lrcov(e, bw, 0)
        matrix V = (lr / s2) * s2 * inv(Z'Z)
        scalar kp = kx + cols(Dt)
        b.coeff = bh[1:kp]
        b.vcv = V[1:kp, 1:kp]
        b.uhat = e
        b.ssr = e'e
        b.lrvar = lr
        b.bandwidth = bw
        b.eqline = sprintf("Method: Dynamic Least Squares (DOLS)\nCointegrating equation deterministics: %s\n" ~ \
          "Fixed leads and lags specification (lead=%d, lag=%d)\nLong-run variance estimate (Bartlett kernel, Newey-West bandwidth = %.4f)", \
          tr == "const" ? "C" : (tr == "linear" ? "C @TREND" : "none"), nlead, nlag, bw)
        b.T = n
    else
        # Phillips-Hansen fully modified OLS
        matrix okr = sumr(!ok(Y ~ X ~ DX)) .= 0
        matrix y = selifr(Y, okr)
        matrix Xs = selifr(X, okr)
        matrix dX = selifr(DX, okr)
        matrix Dd = {}
        if rows(Dt)
            Dd = selifr(Dt, okr)
        endif
        tob = selifr(tob, okr)
        scalar n = rows(y)
        matrix Z = Xs ~ Dd
        matrix u1 = {}
        matrix b0 = mols(y, Z, &u1)
        matrix U = u1 ~ dX
        scalar bw = ev__nwbw(u1)
        matrix Om = ev__lrcov(U, bw, 0)
        matrix La = ev__lrcov(U, bw, 1)
        matrix O12 = Om[1, 2:]
        matrix O22 = Om[2:, 2:]
        scalar w12 = Om[1, 1] - O12 * inv(O22) * O12'
        if m == "ccr"
            # Park (1992) canonical cointegrating regression: transform y and X, then OLS
            scalar kx = cols(Xs)
            matrix Sg = U'U / n
            matrix L2 = La[, 2:]
            matrix Xst = Xs - U * inv(Sg) * L2
            matrix ccv = inv(Sg) * L2 * b0[1:kx] + (0 | inv(O22) * O12')
            matrix yst = y - U * ccv
            matrix Zs = Xst ~ Dd
            matrix bh = mols(yst, Zs)
            b.coeff = bh
            b.vcv = w12 * inv(Zs'Zs)
        else
            matrix ys = y - dX * inv(O22) * O12'
            matrix l12 = La[2:, 1] - La[2:, 2:] * inv(O22) * O12'
            matrix adjm = n * (l12 | zeros(cols(Dd), 1))
            matrix ZZi = inv(Z'Z)
            matrix bh = ZZi * (Z'ys - adjm)
            b.coeff = bh
            b.vcv = w12 * ZZi
        endif
        matrix e = y - Z * bh
        b.uhat = e
        b.ssr = e'e
        b.lrvar = w12
        b.bandwidth = bw
        b.eqline = sprintf("Method: %s\nCointegrating equation deterministics: %s\n" ~ \
          "Long-run covariance estimate (Bartlett kernel, Newey-West bandwidth = %.4f)", \
          m == "ccr" ? "Canonical Cointegrating Regression (CCR)" : "Fully Modified Least Squares (FMOLS)", \
          tr == "const" ? "C" : (tr == "linear" ? "C @TREND" : "none"), bw)
        b.T = n
    endif
    b.kind = "cointreg"
    b.spec = spec
    b.depvar = toupper(tok[1])
    b.method = m == "dols" ? "Dynamic Least Squares (DOLS)" : (m == "ccr" ? "Canonical Cointegrating Regression (CCR)" : "Fully Modified Least Squares (FMOLS)")
    b.labels = lab
    b.k = rows(b.coeff)
    b.stderr = sqrt(diag(b.vcv))
    b.tstat = b.coeff ./ b.stderr
    matrix pv = zeros(b.k, 1)
    loop i = 1..b.k
        pv[i] = 2 * pvalue(t, b.T - b.k, abs(b.tstat[i]))
    endloop
    b.pval = pv
    b.tobs = tob
    b.sample = sprintf("%s %s", obslabel(minc(tob)), obslabel(maxc(tob)))
    b.adjusted = 1
    b.estdate = strftime($now[1], "%m/%d/%y   Time: %H:%M")
    b.meany = meanc(y)
    b.sdy = sdc(y) * sqrt(n / (n - 1))
    if !quiet
        printf "\nDependent Variable: %s\nMethod: %s\nDate: %s\n", b.depvar, b.method, b.estdate
        printf "Sample (adjusted): %s\nIncluded observations: %d after adjustments\n%s\n\n", b.sample, b.T, b.eqline
        ev__line(78)
        printf "%-26s%13s%13s%14s%12s\n", "Variable", "Coefficient", "Std. Error", "t-Statistic", "Prob."
        ev__line(78)
        loop i = 1..b.k
            printf "%-26s%13.6f%13.6f%14.6f%12.4f\n", b.labels[i], b.coeff[i], b.stderr[i], b.tstat[i], b.pval[i]
        endloop
        ev__line(78)
        printf "%-22s%14.6f    %-24s%14.6f\n", "Mean dependent var", b.meany, "S.D. dependent var", b.sdy
        printf "%-22s%14.6f    %-24s%14.6f\n", "Sum squared resid", b.ssr, "Long-run variance", b.lrvar
        ev__line(78)
    endif
    return b
end function

# -------------------------------------------------------------------
# Dynamic panel GMM (Arellano-Bond), as EViews gmm(cx=fd) with @dyn instruments
# -------------------------------------------------------------------

function bundle ev_dpanel (string y "Dependent variable",
                           string xs[null] "Other regressors, e.g. x1 x2",
                           list vars "Series used (e.g. dataset)",
                           int p[1::1] "Lags of the dependent variable",
                           bool twostep[0] "Two-step GMM",
                           bool timedum[0] "Period dummies",
                           bool quiet[0])
    errorif($datatype != 3, "Dynamic panel GMM needs a panel page")
    series evd_y = ev_gen(y, vars)
    list X = null
    strings lab = array(0)
    loop j = 1..p
        lab += sprintf("%s(-%d)", toupper(y), j)
    endloop
    if exists(xs) && strstrip(xs) != ""
        strings tok = strsplit(xs)
        loop i = 1..nelem(tok)
            string v = sprintf("evd_x%d", i)
            series @v = ev_gen(tok[i], vars)
            list X += @v
            lab += toupper(tok[i])
        endloop
    endif
    if nelem(X) == 0
        list X = null
    endif
    if twostep && timedum
        dpanel p ; evd_y X --two-step --time-dummies --quiet
    elif twostep
        dpanel p ; evd_y X --two-step --quiet
    elif timedum
        dpanel p ; evd_y X --time-dummies --quiet
    else
        dpanel p ; evd_y X --quiet
    endif
    bundle b
    b.kind = "dpanel"
    b.depvar = "D(" ~ toupper(y) ~ ")"
    b.method = sprintf("Panel Generalized Method of Moments (Arellano-Bond, %s)", twostep ? "2-step" : "1-step")
    scalar k = nelem(lab)
    b.coeff = $coeff[1:k]
    b.stderr = $stderr[1:k]
    b.vcv = $vcv[1:k, 1:k]
    b.labels = lab
    b.k = k
    b.T = $T
    b.tstat = b.coeff ./ b.stderr
    b.pval = 2 * cnorm(-abs(b.tstat))
    catch b.sargan = $sargan
    if !quiet
        printf "\nDependent Variable: %s\nMethod: %s\nTransformation: First Differences\n", b.depvar, b.method
        printf "Total panel observations: %d\n\n", b.T
        ev__line(78)
        printf "%-26s%13s%13s%14s%12s\n", "Variable", "Coefficient", "Std. Error", "z-Statistic", "Prob."
        ev__line(78)
        loop i = 1..k
            printf "%-26s%13.6f%13.6f%14.6f%12.4f\n", b.labels[i], b.coeff[i], b.stderr[i], b.tstat[i], b.pval[i]
        endloop
        ev__line(78)
    endif
    return b
end function

# -------------------------------------------------------------------
# Equation views: residual correlogram, Quandt-Andrews, VIF
# -------------------------------------------------------------------

function matrix ev_rescorr (bundle b "Equation with residuals (uhat)", int k[1::12] "Lags",
                            bool squared[0] "Correlogram of squared residuals", bool quiet[0])
    # AC, PAC, Ljung-Box Q and its p-value for lags 1..k (EViews eq.correlogram / correlsq)
    matrix u = b.uhat
    if squared
        u = u.^2
    endif
    u = u - meanc(u)
    scalar T = rows(u)
    matrix ac = zeros(k, 1)
    loop j = 1..k
        ac[j] = (u[j+1:T]'u[1:T-j]) / (u'u)
    endloop
    # partial autocorrelations by Durbin-Levinson
    matrix pac = zeros(k, 1)
    matrix phi = zeros(k, k)
    loop j = 1..k
        if j == 1
            phi[1, 1] = ac[1]
        else
            scalar num = ac[j]
            scalar den = 1
            loop i = 1..j-1
                num -= phi[j-1, i] * ac[j-i]
                den -= phi[j-1, i] * ac[i]
            endloop
            phi[j, j] = num / den
            loop i = 1..j-1
                phi[j, i] = phi[j-1, i] - phi[j, j] * phi[j-1, j-i]
            endloop
        endif
        pac[j] = phi[j, j]
    endloop
    matrix Q = cum(T * (T + 2) * ac.^2 ./ (T - seq(1, k)'))
    scalar narma = inbundle(b, "narma") ? b.narma : 0
    matrix pv = zeros(k, 1)
    loop j = 1..k
        pv[j] = j > narma ? pvalue(c, j - narma, Q[j]) : NA
    endloop
    matrix R = ac ~ pac ~ Q ~ pv
    cnameset(R, defarray("AC", "PAC", "Q-Stat", "Prob"))
    if !quiet
        printf "\nCorrelogram of %s\nIncluded observations: %d\n\n", squared ? "Residuals Squared" : "Residuals", T
        printf "%6s%12s%12s%12s%10s\n", "", "AC", "PAC", "Q-Stat", "Prob"
        loop j = 1..k
            printf "%6d%12.4f%12.4f%12.4f%10.4f\n", j, ac[j], pac[j], Q[j], pv[j]
        endloop
    endif
    return R
end function

function bundle ev_ubreak (bundle b "ev_ls result", scalar trim[0.15] "Trimming fraction (EViews default 15%)",
                           bool quiet[0])
    # Quandt-Andrews unknown breakpoint test: Chow F at every date in the trimmed sample
    errorif(!inbundle(b, "X"), "The Quandt-Andrews test needs a least squares equation (ev_ls)")
    matrix y = b.y
    matrix X = b.X
    scalar n = rows(y)
    scalar k = cols(X)
    scalar t1 = ceil(trim * n)
    scalar t2 = floor((1 - trim) * n)
    matrix Fs = {}
    matrix at = {}
    loop t = t1 + 1..t2
        matrix m1 = seq(1, n)' .< t
        bundle a1 = ev__olsr(selifr(y, m1), selifr(X, m1))
        bundle a2 = ev__olsr(selifr(y, !m1), selifr(X, !m1))
        scalar ssru = a1.ssr + a2.ssr
        Fs |= ((b.ssr - ssru) / k) / (ssru / (n - 2 * k))
        at |= b.tobs[t]
    endloop
    bundle r
    r.F = Fs
    r.tobs = at
    scalar im = imaxc(Fs)
    r.maxF = Fs[im]
    r.maxWald = k * Fs[im]
    r.break = obslabel(at[im])
    r.expF = log(meanc(exp(Fs / 2)))
    r.aveF = meanc(Fs)
    # Andrews (1993) asymptotic p-value of the sup-Wald statistic (gretl qlrpval)
    r.maxWaldp = qlrpval(r.maxWald, k, trim, 1 - trim)
    if !quiet
        printf "\nQuandt-Andrews unknown breakpoint test\nNull Hypothesis: No breakpoints within %g%% trimmed data\n", 100 * trim
        printf "Varying regressors: all equation variables\nEquation Sample: %s\nTest Sample: %s %s\nNumber of breaks compared: %d\n\n", \
          b.sample, obslabel(at[1]), obslabel(at[rows(at)]), rows(at)
        printf "%-40s%14s%10s\n", "Statistic", "Value", "Prob."
        ev__line(64)
        printf "%-40s%14.6f%10.4f\n", sprintf("Maximum Wald F-statistic (%s)", r.break), r.maxF, r.maxWaldp
        printf "%-40s%14.6f\n", "Exp Wald F-statistic", r.expF
        printf "%-40s%14.6f\n", "Ave Wald F-statistic", r.aveF
        ev__line(64)
        printf "Note: probability from Andrews (1993) via Hansen's approximation (gretl qlrpval)\n"
    endif
    return r
end function

function matrix ev_vif (bundle b "ev_ls result", bool quiet[0])
    # coefficient variance (uncentered) and centered variance inflation factors
    errorif(!inbundle(b, "X"), "VIFs need a least squares equation (ev_ls)")
    matrix X = b.X
    matrix V = b.vcv
    scalar k = cols(X)
    matrix R = zeros(k, 3)
    loop j = 1..k
        R[j, 1] = V[j, j]
        matrix xj = X[, j]
        matrix oth = {}
        if j == 1
            oth = X[, 2:k]
        elif j == k
            oth = X[, 1:k-1]
        else
            oth = X[, 1:j-1] ~ X[, j+1:k]
        endif
        matrix e = xj - oth * mols(xj, oth)
        R[j, 2] = (xj'xj) / (e'e)                 # uncentered VIF
        matrix d = xj - meanc(xj)
        R[j, 3] = sdc(xj) > 0 ? (d'd) / (e'e) : NA # centered VIF (NA for the constant)
    endloop
    if !quiet
        printf "\nVariance Inflation Factors\nIncluded observations: %d\n\n", b.T
        printf "%-20s%16s%16s%16s\n", "Variable", "Coefficient", "Uncentered", "Centered"
        printf "%-20s%16s%16s%16s\n", "", "Variance", "VIF", "VIF"
        ev__line(68)
        loop j = 1..k
            if ok(R[j, 3])
                printf "%-20s%16.6g%16.6f%16.6f\n", b.labels[j], R[j, 1], R[j, 2], R[j, 3]
            else
                printf "%-20s%16.6g%16.6f%16s\n", b.labels[j], R[j, 1], R[j, 2], "NA"
            endif
        endloop
    endif
    return R
end function

# -------------------------------------------------------------------
# Panel tests: correlated random effects (Hausman), redundant fixed effects
# -------------------------------------------------------------------

function bundle ev_paneltests (string spec "Equation, e.g. y c x", list vars "Series used (e.g. dataset)",
                               bool quiet[0])
    bundle fe = ev_panel(spec, vars, "fixed", 0, 1)
    bundle re = ev_panel(spec, vars, "random", 0, 1)
    bundle po = ev_panel(spec, vars, "none", 0, 1)
    # slopes only (no constant)
    matrix keep = zeros(1, fe.k)
    loop i = 1..fe.k
        keep[i] = fe.xlab[i] != "C"
    endloop
    matrix d = selifr(fe.coeff - re.coeff, keep')
    matrix Vd = selifc(selifr(fe.vcv - re.vcv, keep'), keep)
    bundle r
    r.hausman = qform(d', inv(Vd))
    r.hdf = rows(d)
    r.hp = pvalue(c, r.hdf, r.hausman)
    scalar N = fe.ncross
    scalar q = N - 1
    r.F = ((po.ssr - fe.ssr) / q) / (fe.ssr / fe.df)
    r.Fdf1 = q
    r.Fdf2 = fe.df
    r.Fp = pvalue(F, q, fe.df, r.F)
    r.chi2 = -2 * (po.lnl - fe.lnl)
    r.chi2p = pvalue(c, q, r.chi2)
    if !quiet
        printf "\nCorrelated Random Effects - Hausman Test\nTest cross-section random effects\n\n"
        printf "%-26s%18s%10s%10s\n", "Test Summary", "Chi-Sq. Statistic", "Chi-Sq. d.f.", "Prob."
        ev__line(68)
        printf "%-26s%18.6f%10d%10.4f\n", "Cross-section random", r.hausman, r.hdf, r.hp
        ev__line(68)
        printf "\nRedundant Fixed Effects Tests\nTest cross-section fixed effects\n\n"
        printf "%-26s%14s%14s%10s\n", "Effects Test", "Statistic", "d.f.", "Prob."
        ev__line(68)
        printf "%-26s%14.6f%14s%10.4f\n", "Cross-section F", r.F, sprintf("(%d,%d)", q, fe.df), r.Fp
        printf "%-26s%14.6f%14d%10.4f\n", "Cross-section Chi-square", r.chi2, q, r.chi2p
        ev__line(68)
    endif
    return r
end function

# -------------------------------------------------------------------
# Pairwise Granger causality (group.cause)
# -------------------------------------------------------------------

function matrix ev_cause (string names "Series, e.g. y x z", list vars "Series used (e.g. dataset)",
                          int p[1::2] "Lags", bool quiet[0])
    strings tok = strsplit(names)
    scalar m = nelem(tok)
    set skip_missing off
    matrix Y = {}
    matrices L = array(m)
    loop i = 1..m
        series evg_x = ev_gen(tok[i], vars)
        Y ~= {evg_x}
        matrix M = {}
        loop j = 1..p
            series evg_l = ev_gen(ev__lagx(tok[i], j, vars), vars)
            M ~= {evg_l}
        endloop
        L[i] = M
    endloop
    matrix R = {}
    if !quiet
        printf "\nPairwise Granger Causality Tests\nLags: %d\n\n", p
        printf "%-44s%8s%14s%10s\n", "Null Hypothesis:", "Obs", "F-Statistic", "Prob."
        ev__line(76)
    endif
    loop a = 1..m
        loop cc = 1..m
            if a != cc
                # does tok[c] Granger-cause tok[a]?
                matrix yv = Y[, a]
                matrix Xr = ones(rows(yv), 1) ~ L[a]
                matrix Xu = Xr ~ L[cc]
                matrix okr = sumr(!ok(yv ~ Xu)) .= 0
                bundle r0 = ev__olsr(selifr(yv, okr), selifr(Xr, okr))
                bundle r1 = ev__olsr(selifr(yv, okr), selifr(Xu, okr))
                scalar n = sumc(okr)
                scalar Fst = ((r0.ssr - r1.ssr) / p) / (r1.ssr / (n - cols(Xu)))
                scalar pv = pvalue(F, p, n - cols(Xu), Fst)
                R |= {cc, a, n, Fst, pv}
                if !quiet
                    printf "%-44s%8d%14.5f%10.4f\n", sprintf(" %s does not Granger Cause %s", toupper(tok[cc]), toupper(tok[a])), n, Fst, pv
                endif
            endif
        endloop
    endloop
    return R
end function

# -------------------------------------------------------------------
# VAR: White heteroskedasticity test, impulse responses with bands, VAR -> model
# -------------------------------------------------------------------

function bundle ev_varwhite (bundle v "ev_varest result", bool quiet[0])
    # joint White test without cross terms (Lutkepohl/Kelejian system LM)
    matrix U = v.sys.uhat
    matrix X = v.sys.X
    scalar T = rows(U)
    scalar n = cols(U)
    matrix Z = ones(T, 1)
    loop j = 1..cols(X)
        if sdc(X[, j]) > 0
            Z ~= X[, j] ~ X[, j].^2
        endif
    endloop
    matrix P = {}
    loop i = 1..n
        loop j = i..n
            P ~= U[, i] .* U[, j]
        endloop
    endloop
    scalar m = cols(P)
    matrix Pc = P .- meanc(P)
    matrix E = P - Z * mols(P, Z)
    scalar q = cols(Z) - 1
    bundle r
    r.chi2 = T * (m - tr(inv(Pc'Pc / T) * (E'E / T)))
    r.df = m * q
    r.p = pvalue(c, r.df, r.chi2)
    if !quiet
        printf "\nVAR Residual Heteroskedasticity Tests (Levels and Squares)\nIncluded observations: %d\n\n", T
        printf "Joint test:\n%14s%8s%10s\n", "Chi-sq", "df", "Prob."
        printf "%14.6f%8d%10.4f\n", r.chi2, r.df, r.p
    endif
    return r
end function

function matrix ev__irfs (const matrix A, const matrix S, scalar n, scalar h, string kind, bool accum)
    # responses (h x n^2; column (s-1)*n+t: variable t to shock s)
    scalar np = rows(A)
    matrix J = I(n) ~ zeros(n, np - n)
    matrix P = kind == "gen" ? S ./ sqrt(diag(S)') : cholesky(S)
    matrix R = zeros(h, n * n)
    matrix Ap = I(np)
    loop t = 1..h
        matrix Phi = J * Ap * J'
        matrix M = Phi * P
        R[t,] = vec(M)'
        Ap = Ap * A
    endloop
    if accum
        R = cum(R)
    endif
    return R
end function

function bundle ev_varimpulse (bundle v "ev_varest result", int h[1::10] "Horizon",
                               string kind[null] "chol (default) or gen (generalized)",
                               bool accum[0] "Accumulated responses",
                               int reps[0::200] "Bootstrap repetitions for the bands (0: none)",
                               scalar level[0.95] "Band coverage",
                               bool quiet[0])
    string k = exists(kind) ? tolower(kind) : "chol"
    errorif(k != "chol" && k != "gen", "kind must be chol or gen")
    scalar n = v.n
    matrix A = v.sys.A
    matrix S = v.sys.sigma
    bundle r
    r.irf = ev__irfs(A, S, n, h, k, accum)
    if reps > 0
        # residual bootstrap: rebuild the data with resampled residuals, re-estimate by OLS
        matrix U = v.sys.uhat
        matrix X = v.sys.X
        matrix Y = v.sys.Y
        matrix B = v.coeff
        scalar T = rows(U)
        scalar p = maxr(v.lags)
        matrix lg = v.lags
        matrix draws = zeros(reps, h * n * n)
        loop b = 1..reps
            matrix Ub = U[mrandgen(i, 1, T, T, 1),]
            matrix Yb = Y
            matrix Xb = X
            loop t = 1..T
                # rebuild the lagged regressors from the simulated values
                matrix row = X[t,]
                scalar col = v.hasc
                loop i = 1..n
                    loop jj = 1..cols(lg)
                        scalar j = lg[jj]
                        col++
                        if t - j >= 1
                            row[col] = Yb[t - j, i]
                        endif
                    endloop
                endloop
                Xb[t,] = row
                Yb[t,] = row * B + Ub[t,]
            endloop
            matrix Bb = mols(Yb, Xb)
            matrix Eb = Yb - Xb * Bb
            # companion matrix of the bootstrap estimates
            matrix Ab = zeros(n * p, n * p)
            loop i = 1..n
                scalar col = v.hasc
                loop ii = 1..n
                    loop jj = 1..cols(lg)
                        scalar j = lg[jj]
                        col++
                        Ab[i, (j - 1) * n + ii] = Bb[col, i]
                    endloop
                endloop
            endloop
            if p > 1
                Ab[n + 1:n * p, 1:n * (p - 1)] = I(n * (p - 1))
            endif
            draws[b,] = vec(ev__irfs(Ab, Eb'Eb / T, n, h, k, accum))'
        endloop
        scalar a = (1 - level) / 2
        r.lo = mshape(quantile(draws, a)', h, n * n)
        r.hi = mshape(quantile(draws, 1 - a)', h, n * n)
        r.reps = reps
    endif
    r.kind = k
    r.accum = accum
    if !quiet
        printf "\n%s%s impulse responses, horizon %d%s\n", accum ? "Accumulated " : "", \
          k == "gen" ? "Generalized" : "Cholesky (one S.D.)", h, reps > 0 ? sprintf(", %d bootstrap draws", reps) : ""
        loop s = 1..n
            printf "\nResponse to %s:\n%6s", v.ylab[s], "Period"
            loop t = 1..n
                printf "%16s", v.ylab[t]
            endloop
            printf "\n"
            loop t = 1..h
                printf "%6d", t
                loop i = 1..n
                    printf "%16.6f", r.irf[t, (s - 1) * n + i]
                endloop
                printf "\n"
            endloop
        endloop
    endif
    return r
end function

function bundles ev_var2eqs (bundle v "ev_varest result", list vars "Series used (e.g. dataset)")
    # each VAR equation as a least-squares equation bundle, for ev_modelsolve (var.makemodel)
    bundles out = array(0)
    scalar n = v.n
    matrix lg = v.lags
    loop i = 1..n
        string spec = v.ytok[i]
        if v.hasc
            spec ~= " c"
        endif
        loop ii = 1..n
            loop jj = 1..cols(lg)
                spec ~= " " ~ ev__lagx(v.ytok[ii], lg[jj], vars)
            endloop
        endloop
        loop x = 1..nelem(v.xtok)
            if tolower(v.xtok[x]) != "c"
                spec ~= " " ~ v.xtok[x]
            endif
        endloop
        bundle e = defbundle()
        e.kind = "ls"
        e.spec = spec
        e.coeff = v.coeff[, i]
        e.sigma = sqrt(v.sys.sigma[i, i])
        out += e
    endloop
    return out
end function

# -------------------------------------------------------------------
# Restricted VEC: cointegrating vector restrictions B(r,c) (EViews text form)
# -------------------------------------------------------------------

function bundle ev_vecrestrict (bundle v "ev_vecm result", string restr "e.g. B(1,1)=1, B(1,2)=-1",
                                list vars "Series used (e.g. dataset)", bool quiet[0])
    # linear restrictions on vec(beta); EViews B(i,j) = gretl beta[j, i]
    matrix beta = v.beta
    scalar nb = rows(beta)
    scalar r = cols(beta)
    # restrictions are separated by commas outside B(i,j)
    strings parts = strsplit(regsub(regsub(restr, "\s", ""), ",(?![0-9]+\))", ";"), ";")
    matrix R = {}
    matrix q = {}
    loop i = 1..nelem(parts)
        string pt = parts[i]
        errorif(!instring(pt, "="), "Each restriction needs '=': " ~ pt)
        strings lrs = strsplit(pt, "=")
        matrix row = zeros(1, nb * r)
        string t = regsub(toupper(lrs[1]), "-", "+-")
        strings terms = strsplit(t, "+")
        loop jj = 1..nelem(terms)
            string term = terms[jj]
            if term != ""
                errorif(instring(term, "A("), "Restrictions on the adjustment coefficients A() are not supported")
                string sc = regsub(term, "\*?B\(.*", "")
                scalar coef = sc == "" ? 1 : (sc == "-" ? -1 : atof(sc))
                scalar ri = atof(regsub(term, ".*B\(([0-9]+),.*", "\1"))
                scalar cj = atof(regsub(term, ".*B\([0-9]+,([0-9]+)\).*", "\1"))
                row[(ri - 1) * nb + cj] = row[(ri - 1) * nb + cj] + coef
            endif
        endloop
        R |= row
        q |= atof(lrs[2])
    endloop
    bundle w = ev_vecm(v.spec, vars, v.case, v.rank, 1, null, R, q)
    w.restr = restr
    if !quiet
        printf "\nCointegration Restrictions: %s\n", restr
        printf "Restricted cointegrating vector(s) (rows = variables):\n"
        matrix br = w.beta
        print br
        if inbundle(w, "lr_restr")
            printf "LR test for binding restrictions: Chi-square(%d) = %g, Prob. = %.4f\n", rows(q) - r * r, w.lr_restr, w.lr_restr_p
        endif
    endif
    return w
end function

# -------------------------------------------------------------------
# Unit root tests: ERS point optimal and Ng-Perron (GLS detrending),
# Zivot-Andrews breakpoint test, panel Fisher and Hadri tests
# -------------------------------------------------------------------

function matrix ev__glsdetrend (const matrix y, bool trend, scalar *cbar)
    # ERS quasi-differencing with c-bar = -7 (constant) or -13.5 (trend)
    scalar T = rows(y)
    cbar = trend ? -13.5 : -7
    scalar a = 1 + cbar / T
    matrix Z = ones(T, 1)
    if trend
        Z ~= seq(1, T)'
    endif
    matrix yq = y[1] | (y[2:T] - a * y[1:T-1])
    matrix Zq = Z[1,] | (Z[2:T,] - a * Z[1:T-1,])
    matrix b = mols(yq, Zq)
    return y - Z * b
end function

function scalar ev__arspec (const matrix yd, int maxlag, scalar *kopt)
    # AR spectral density at frequency zero of GLS-detrended data, lag chosen by SIC
    scalar T = rows(yd)
    matrix dy = yd[2:T] - yd[1:T-1]
    scalar best = 1e300
    scalar f0 = NA
    loop k = 0..maxlag
        matrix Z = yd[maxlag + 1:T - 1]
        loop j = 1..k
            Z ~= dy[maxlag + 1 - j:T - 1 - j]
        endloop
        matrix e = {}
        matrix b = mols(dy[maxlag + 1:T - 1], Z, &e)
        scalar n = rows(e)
        scalar s2 = e'e / n
        scalar sic = log(s2) + cols(Z) * log(n) / n
        if sic < best
            best = sic
            kopt = k
            scalar sb = 0
            if k > 0
                sb = sumc(b[2:k+1])
            endif
            f0 = s2 / (1 - sb)^2
        endif
    endloop
    return f0
end function

function bundle ev_ngperron (string expr "Series or expression", list vars "Series used (e.g. dataset)",
                             bool trend[0] "Include a linear trend", int maxlag[-1::-1] "Maximum lag (-1: EViews rule)",
                             bool quiet[0])
    # ERS point-optimal P_T and Ng-Perron MZa, MZt, MSB, MPT (AR spectral, GLS-detrended, SIC lags)
    set skip_missing off
    series evn_x = ev_gen(expr, vars)
    matrix y = {evn_x}
    y = selifr(y, ok(y))
    scalar T = rows(y)
    scalar cb = 0
    matrix yd = ev__glsdetrend(y, trend, &cb)
    scalar pmax = maxlag >= 0 ? maxlag : floor(12 * (T / 100)^(1 / 4))
    scalar kopt = 0
    scalar f0 = ev__arspec(yd, pmax, &kopt)
    matrix yl = yd[1:T-1]
    scalar s1 = yl'yl / T^2
    scalar yT = yd[T]
    bundle r
    r.MZa = (yT^2 / T - f0) / (2 * s1)
    r.MSB = sqrt(s1 / f0)
    r.MZt = r.MZa * r.MSB
    r.MPT = trend ? (cb^2 * s1 + (1 - cb) * yT^2 / T) / f0 : (cb^2 * s1 - cb * yT^2 / T) / f0
    # ERS point optimal: SSR of the quasi-differenced regressions at a-bar and at 1
    scalar abar = 1 + cb / T
    matrix Z = ones(T, 1)
    if trend
        Z ~= seq(1, T)'
    endif
    matrix yq = y[1] | (y[2:T] - abar * y[1:T-1])
    matrix Zq = Z[1,] | (Z[2:T,] - abar * Z[1:T-1,])
    matrix ea = yq - Zq * mols(yq, Zq)
    matrix y1 = y[1] | (y[2:T] - y[1:T-1])
    matrix Z1 = Z[1,] | (Z[2:T,] - Z[1:T-1,])
    matrix e1 = y1 - Z1 * mols(y1, Z1)
    r.PT = (ea'ea - abar * e1'e1) / f0
    r.f0 = f0
    r.lag = kopt
    r.T = T
    # asymptotic critical values (1%, 5%, 10%): Ng and Perron (2001) Table 1; ERS (1996) Table 1
    if trend
        r.cv = {-23.8, -3.42, 0.143, 4.03; -17.3, -2.91, 0.168, 5.48; -14.2, -2.62, 0.185, 6.67}
        r.cvpt = {4.26, 5.64, 6.79}
    else
        r.cv = {-13.8, -2.58, 0.174, 1.78; -8.1, -1.98, 0.233, 3.17; -5.7, -1.62, 0.275, 4.45}
        r.cvpt = {1.99, 3.26, 4.48}
    endif
    if !quiet
        printf "\nNull Hypothesis: %s has a unit root\nExogenous: %s\n", toupper(expr), trend ? "Constant, Linear Trend" : "Constant"
        printf "Lag length: %d (Spectral GLS-detrended AR based on SIC, maxlag=%d)\nSample size: %d\n\n", kopt, pmax, T
        printf "%-34s%10s%10s%10s%10s\n", "", "MZa", "MZb", "MSB", "MPT"
        ev__line(74)
        printf "%-34s%10.4f%10.4f%10.4f%10.4f\n", "Ng-Perron test statistics", r.MZa, r.MZt, r.MSB, r.MPT
        strings lv = defarray("1%", "5%", "10%")
        loop i = 1..3
            printf "%-34s%10.3f%10.3f%10.3f%10.3f\n", sprintf("Asymptotic critical values*: %s", lv[i]), r.cv[i, 1], r.cv[i, 2], r.cv[i, 3], r.cv[i, 4]
        endloop
        ev__line(74)
        printf "*Ng-Perron (2001, Table 1)\n\nElliott-Rothenberg-Stock point-optimal P-statistic: %.4f\n", r.PT
        printf "Asymptotic critical values (ERS 1996): 1%% %.2f  5%% %.2f  10%% %.2f\n", r.cvpt[1], r.cvpt[2], r.cvpt[3]
        printf "(MZb above is MZt)\n"
    endif
    return r
end function

function bundle ev_zivot (string expr "Series or expression", list vars "Series used (e.g. dataset)",
                          string model[null] "a (intercept break), b (trend break) or c (both)",
                          int lag[-1::-1] "ADF lags (-1: chosen by SIC without break)",
                          scalar trim[0.15], bool quiet[0])
    # Zivot-Andrews (1992) unit root test with one endogenous break: minimum t over break dates
    string md = exists(model) ? tolower(model) : "a"
    errorif(md != "a" && md != "b" && md != "c", "model must be a, b or c")
    set skip_missing off
    series evz_x = ev_gen(expr, vars)
    series evz_o = obs
    matrix D = {evz_x} ~ {evz_o}
    D = selifr(D, ok(D[, 1]))
    matrix y = D[, 1]
    matrix tob = D[, 2]
    scalar T = rows(y)
    matrix dy = y[2:T] - y[1:T-1]
    # lag order: SIC on the ADF regression without a break
    scalar pmax = floor(12 * (T / 100)^(1 / 4))
    scalar p = lag
    if lag < 0
        scalar best = 1e300
        loop k = 0..pmax
            matrix Z = ones(T - 1 - pmax, 1) ~ seq(pmax + 2, T)' ~ y[pmax + 1:T - 1]
            loop j = 1..k
                Z ~= dy[pmax + 1 - j:T - 1 - j]
            endloop
            matrix e = {}
            matrix b = mols(dy[pmax + 1:T - 1], Z, &e)
            scalar n = rows(e)
            scalar sic = log(e'e / n) + cols(Z) * log(n) / n
            if sic < best
                best = sic
                p = k
            endif
        endloop
    endif
    scalar t1 = ceil(trim * T)
    scalar t2 = floor((1 - trim) * T)
    scalar tmin = 1e300
    scalar tb = NA
    loop bk = t1..t2
        matrix tt = seq(p + 2, T)'
        matrix Z = ones(rows(tt), 1) ~ tt ~ y[p + 1:T - 1]
        if md == "a" || md == "c"
            Z ~= tt .> bk                        # DU: intercept shift
        endif
        if md == "b" || md == "c"
            Z ~= (tt .> bk) .* (tt - bk)         # DT: trend shift
        endif
        loop j = 1..p
            Z ~= dy[p + 1 - j:T - 1 - j]
        endloop
        matrix e = {}
        matrix b = mols(dy[p + 1:T - 1], Z, &e)
        matrix V = (e'e / (rows(e) - cols(Z))) * inv(Z'Z)
        scalar tv = b[3] / sqrt(V[3, 3])
        if tv < tmin
            tmin = tv
            tb = bk
        endif
    endloop
    bundle r
    r.stat = tmin
    r.break = obslabel(tob[tb + 1])
    r.lag = p
    r.model = md
    # Zivot and Andrews (1992), Tables 2-4: 1%, 5%, 10%
    r.cv = md == "a" ? {-5.34, -4.80, -4.58} : (md == "b" ? {-4.93, -4.42, -4.11} : {-5.57, -5.08, -4.82})
    if !quiet
        printf "\nZivot-Andrews Unit Root Test\nNull Hypothesis: %s has a unit root with a structural break in the %s\n", \
          toupper(expr), md == "a" ? "intercept" : (md == "b" ? "trend" : "intercept and trend")
        printf "Chosen lag length: %d\nChosen break point: %s\n\n", p, r.break
        printf "%-30s%12s\n", "", "t-Statistic"
        printf "%-30s%12.6f\n", "Zivot-Andrews test statistic", r.stat
        printf "%-30s%12.2f\n%-30s%12.2f\n%-30s%12.2f\n", "1% critical value:", r.cv[1], "5% critical value:", r.cv[2], \
          "10% critical value:", r.cv[3]
    endif
    return r
end function

function bundle ev_panelur (series x "Series of a panel page", string test[null] "fisher (ADF, default), fisherpp or hadri",
                            bool trend[0], int lag[0::1] "ADF lag for the Fisher test", bool quiet[0])
    # Maddala-Wu / Choi Fisher-type tests and Hadri's stationarity test
    errorif($datatype != 3, "Panel unit root tests need a panel page")
    string ts = exists(test) ? tolower(test) : "fisher"
    set skip_missing off
    matrix M = ev_unstack(x)
    scalar N = cols(M)
    matrix pv = zeros(N, 1)
    matrix stv = zeros(N, 1)
    bundle r
    if ts == "hadri"
        matrix LMi = zeros(N, 1)
        scalar ssum = 0
        scalar nobs = 0
        scalar lmh = 0
        matrix s2i = zeros(N, 1)
        matrix etas = zeros(N, 1)
        loop i = 1..N
            matrix yi = M[, i]
            yi = selifr(yi, ok(yi))
            scalar T = rows(yi)
            matrix Z = ones(T, 1)
            if trend
                Z ~= seq(1, T)'
            endif
            matrix e = yi - Z * mols(yi, Z)
            matrix S = cum(e)
            etas[i] = (S'S) / T^2
            s2i[i] = e'e / T
        endloop
        scalar s2 = meanc(s2i)
        scalar xi = trend ? 1 / 15 : 1 / 6
        scalar ze = trend ? sqrt(11 / 6300) : sqrt(1 / 45)
        scalar LMh = meanc(etas / s2)              # homoskedastic
        scalar LMhet = meanc(etas ./ s2i)          # heteroskedasticity consistent
        r.Z = sqrt(N) * (LMh - xi) / ze
        r.Zhet = sqrt(N) * (LMhet - xi) / ze
        r.p = 1 - cnorm(r.Z)
        r.phet = 1 - cnorm(r.Zhet)
        if !quiet
            printf "\nHadri Panel Unit Root Test\nNull Hypothesis: Stationarity\nExogenous variables: %s\n\n", trend ? "Individual effects, individual linear trends" : "Individual effects"
            printf "%-34s%14s%10s\n", "Method", "Statistic", "Prob.**"
            printf "%-34s%14.6f%10.4f\n", "Hadri Z-stat", r.Z, r.p
            printf "%-34s%14.6f%10.4f\n", "Heteroscedastic Consistent Z-stat", r.Zhet, r.phet
        endif
        return r
    endif
    errorif(ts != "fisher" && ts != "fisherpp", "test must be fisher, fisherpp or hadri")
    scalar itv = trend ? 3 : 2
    loop i = 1..N
        matrix yi = M[, i]
        yi = selifr(yi, ok(yi))
        scalar T = rows(yi)
        matrix dy = yi[2:T] - yi[1:T-1]
        scalar st = NA
        if ts == "fisher"
            matrix Z = ones(T - 1 - lag, 1)
            if trend
                Z ~= seq(lag + 2, T)'
            endif
            Z ~= yi[lag + 1:T - 1]
            loop j = 1..lag
                Z ~= dy[lag + 1 - j:T - 1 - j]
            endloop
            matrix e = {}
            matrix b = mols(dy[lag + 1:T - 1], Z, &e)
            matrix V = (e'e / (rows(e) - cols(Z))) * inv(Z'Z)
            scalar kk = trend ? 3 : 2
            st = b[kk] / sqrt(V[kk, kk])
            stv[i] = st
            pv[i] = urcpval(st, rows(e), 1, itv)
        else
            matrix Z = ones(T - 1, 1)
            if trend
                Z ~= seq(2, T)'
            endif
            Z ~= yi[1:T - 1]
            matrix e = {}
            matrix b = mols(dy, Z, &e)
            scalar kk = cols(Z)
            scalar s2 = e'e / (rows(e) - kk)
            matrix ZZi = inv(Z'Z)
            scalar se = sqrt(s2 * ZZi[kk, kk])
            scalar g0 = e'e / rows(e)
            scalar l2 = ev__lrvar(e, ev__nwbw(e))
            st = (b[kk] / se) * sqrt(g0 / l2) - rows(e) * (l2 - g0) * se / (2 * sqrt(l2) * sqrt(s2))
            pv[i] = urcpval(st, rows(e), 1, itv)
        endif
    endloop
    r.pvals = pv
    r.stats = stv
    r.fisher = -2 * sumc(log(pv))
    r.fisherp = pvalue(c, 2 * N, r.fisher)
    r.choi = sumc(invcdf(z, pv)) / sqrt(N)
    r.choip = cnorm(r.choi)
    if !quiet
        printf "\n%s Fisher Panel Unit Root Test\nNull Hypothesis: Unit root (individual unit root process)\nCross-sections: %d\n\n", \
          ts == "fisher" ? "ADF -" : "PP -", N
        printf "%-34s%14s%10s\n", "Method", "Statistic", "Prob.**"
        printf "%-34s%14.6f%10.4f\n", ts == "fisher" ? "ADF - Fisher Chi-square" : "PP - Fisher Chi-square", r.fisher, r.fisherp
        printf "%-34s%14.6f%10.4f\n", ts == "fisher" ? "ADF - Choi Z-stat" : "PP - Choi Z-stat", r.choi, r.choip
        printf "** Probabilities for Fisher tests use the asymptotic Chi-square distribution;\n   the Choi test assumes asymptotic normality.\n"
    endif
    return r
end function

# -------------------------------------------------------------------
# Band-pass filters (series.bpf), exponential smoothing (series.smooth),
# interpolation (series.ipolate), kernel density
# -------------------------------------------------------------------

function series ev_cf (series x "Series", int low[2::6] "Lower period", int high[2::32] "Upper period")
    # Christiano-Fitzgerald asymmetric full-sample filter (random-walk assumption, drift removed)
    set skip_missing off
    matrix y = {x}
    errorif(sumc(!ok(y)) > 0, "The series has missing values in the sample")
    scalar T = rows(y)
    # remove the drift
    scalar d = (y[T] - y[1]) / (T - 1)
    y = y - d * seq(0, T - 1)'
    scalar a = 2 * $pi / high
    scalar bb = 2 * $pi / low
    matrix B = zeros(T, 1)                     # B[j+1] = B_j
    B[1] = (bb - a) / $pi
    loop j = 1..T - 1
        B[j + 1] = (sin(j * bb) - sin(j * a)) / ($pi * j)
    endloop
    matrix cy = zeros(T, 1)
    loop t = 1..T
        scalar v = B[1] * y[t]
        # forward: y[t+1] .. y[T-1], then y[T] with B-tilde(T-t) = -B0/2 - sum B
        scalar sf = 0
        if T - t - 1 >= 1
            loop j = 1..T - t - 1
                v += B[j + 1] * y[t + j]
                sf += B[j + 1]
            endloop
        endif
        v += (-B[1] / 2 - sf) * y[T]
        # backward: y[t-1] .. y[2], then y[1] with B-tilde(t-1)
        scalar sb = 0
        if t - 2 >= 1
            loop j = 1..t - 2
                v += B[j + 1] * y[t - j]
                sb += B[j + 1]
            endloop
        endif
        v += (-B[1] / 2 - sb) * y[1]
        cy[t] = v
    endloop
    series out = cy
    return out
end function

function series ev_smooth (series x "Series", string method[null] "s (single), d (double), n (Holt-Winters no seasonal), a (additive) or m (multiplicative)",
                           scalar pa[NA] "alpha", scalar pb[NA] "beta", scalar pg[NA] "gamma", bundle *res[null] "Output: parameters, SSR, RMSE")
    # exponential smoothing; parameters not given are estimated by minimising the sum of squared one-step errors
    string m = exists(method) ? tolower(method) : "s"
    errorif(!instring(" s d n a m ", " " ~ m ~ " "), "method must be s, d, n, a or m")
    set skip_missing off
    matrix y = {x}
    errorif(sumc(!ok(y)) > 0, "The series has missing values in the sample")
    scalar s = $pd
    errorif((m == "a" || m == "m") && s < 2, "Seasonal Holt-Winters needs seasonal data")
    errorif(m == "m" && minc(y) <= 0, "Multiplicative seasonals need positive data")
    matrix fix = {pa, pb, pg}
    scalar np = m == "s" || m == "d" ? 1 : (m == "n" ? 2 : 3)
    matrix th = zeros(np, 1)                 # logit scale
    matrix th0 = th
    scalar nfree = 0
    loop i = 1..np
        nfree += !ok(fix[i])
    endloop
    if nfree > 0
        set max_verbose off
        scalar ssr = BFGSmin(&th, "ev__smooth_ssr(th, y, m, s, fix)")
    endif
    matrix f = ev__smooth_run(th, y, m, s, fix)
    if exists(res)
        matrix par = 1 ./ (1 + exp(-th))
        loop i = 1..np
            if ok(fix[i])
                par[i] = fix[i]
            endif
        endloop
        res.params = par
        res.ssr = sumc((y - f[, 1]).^2)
        res.rmse = sqrt(res.ssr / rows(y))
    endif
    return f[, 2]
end function

function scalar ev__smooth_ssr (const matrix th, const matrix y, string m, scalar s, const matrix fix)
    matrix f = ev__smooth_run(th, y, m, s, fix)
    scalar r = sumc((y - f[, 1]).^2)
    return ok(r) ? r : 1e300
end function

function matrix ev__smooth_run (const matrix th, const matrix y, string m, scalar s, const matrix fix)
    # returns [one-step forecast, smoothed series]
    matrix par = 1 ./ (1 + exp(-th))
    loop i = 1..rows(par)
        if ok(fix[i])
            par[i] = fix[i]
        endif
    endloop
    scalar T = rows(y)
    matrix F = zeros(T, 2)
    if m == "s"
        scalar a = par[1]
        scalar S = meanc(y[1:ceil((T + 1) / 2)])
        loop t = 1..T
            F[t, 1] = S
            S = a * y[t] + (1 - a) * S
            F[t, 2] = S
        endloop
    elif m == "d"
        scalar a = par[1]
        scalar S = y[1]
        scalar D = y[1]
        loop t = 1..T
            F[t, 1] = 2 * S - D + a / (1 - a) * (S - D)
            S = a * y[t] + (1 - a) * S
            D = a * S + (1 - a) * D
            F[t, 2] = S
        endloop
    else
        scalar a = par[1]
        scalar b = par[2]
        scalar g = m == "n" ? 0 : par[3]
        scalar L = y[1]
        scalar Bt = 0
        matrix Sc = m == "m" ? ones(s, 1) : zeros(s, 1)
        if m != "n"
            matrix y1 = y[1:s]
            L = meanc(y1)
            Bt = T > 2 * s ? (meanc(y[s+1:2*s]) - L) / s : 0
            Sc = m == "m" ? y1 / L : y1 - L
        endif
        loop t = 1..T
            scalar k = (t - 1) % s + 1
            if m == "m"
                F[t, 1] = (L + Bt) * Sc[k]
            elif m == "a"
                F[t, 1] = L + Bt + Sc[k]
            else
                F[t, 1] = L + Bt
            endif
            scalar Lold = L
            if m == "m"
                L = a * y[t] / Sc[k] + (1 - a) * (L + Bt)
                Bt = b * (L - Lold) + (1 - b) * Bt
                Sc[k] = g * y[t] / L + (1 - g) * Sc[k]
                F[t, 2] = (L + Bt) * Sc[k]
            elif m == "a"
                L = a * (y[t] - Sc[k]) + (1 - a) * (L + Bt)
                Bt = b * (L - Lold) + (1 - b) * Bt
                Sc[k] = g * (y[t] - L) + (1 - g) * Sc[k]
                F[t, 2] = L + Bt + Sc[k]
            else
                L = a * y[t] + (1 - a) * (L + Bt)
                Bt = b * (L - Lold) + (1 - b) * Bt
                F[t, 2] = L + Bt
            endif
        endloop
    endif
    return F
end function

function series ev_ipolate (series x "Series with missing values", string kind[null] "lin (default) or log")
    # fills interior missing values by linear (or log-linear) interpolation, as EViews ipolate
    string k = exists(kind) ? tolower(kind) : "lin"
    set skip_missing off
    matrix y = {x}
    if k == "log"
        errorif(minc(selifr(y, ok(y))) <= 0, "Log interpolation needs positive values")
        y = log(y)
    endif
    scalar T = rows(y)
    matrix r = y
    scalar last = 0
    loop t = 1..T
        if ok(y[t])
            if last > 0 && t - last > 1
                loop j = last + 1..t - 1
                    r[j] = y[last] + (y[t] - y[last]) * (j - last) / (t - last)
                endloop
            endif
            last = t
        endif
    endloop
    if k == "log"
        r = exp(r)
    endif
    series out = r
    return out
end function

function void ev_kdplot (series x "Series", string out[null] "Output file (default: display)")
    # kernel density estimate (Epanechnikov in EViews; gretl's default Gaussian kernel here)
    matrix K = kdensity(x)
    cnameset(K, defarray("x", "Kernel density"))
    string o = exists(out) ? out : "display"
    gnuplot 2 1 --matrix=K --with-lines --output="@o"
end function

# -------------------------------------------------------------------
# Principal components (group.pcomp)
# -------------------------------------------------------------------

function bundle ev_pcomp (string names "Series, e.g. x1 x2 x3", list vars "Series used (e.g. dataset)",
                          bool cov[0] "Use the covariance (default: correlation) matrix", bool quiet[0])
    strings tok = strsplit(names)
    scalar m = nelem(tok)
    set skip_missing off
    matrix X = {}
    series evp_o = obs
    loop i = 1..m
        series evp_x = ev_gen(tok[i], vars)
        X ~= {evp_x}
    endloop
    matrix okr = sumr(!ok(X)) .= 0
    X = selifr(X, okr)
    matrix tob = selifr({evp_o}, okr)
    scalar T = rows(X)
    matrix Xc = X .- meanc(X)
    matrix S = Xc'Xc / (T - 1)
    if !cov
        matrix d = sqrt(diag(S))
        S = S ./ (d * d')
        Xc = Xc ./ d'
    endif
    matrix EV = {}
    matrix lam = eigensym(S, &EV)
    # eigensym returns ascending order: reverse
    lam = mreverse(lam)
    EV = mreverse(EV')'
    # sign convention: largest loading of each vector positive
    loop j = 1..m
        if EV[imaxc(abs(EV[, j])), j] < 0
            EV[, j] = -EV[, j]
        endif
    endloop
    bundle r
    r.eigval = lam
    r.prop = lam / sumc(lam)
    r.cumprop = cum(r.prop)
    r.eigvec = EV
    r.scores = Xc * EV
    r.tobs = tob
    r.names = tok
    if !quiet
        printf "\nPrincipal Components Analysis\nComputed using: %s\nIncluded observations: %d\n\n", cov ? "Covariance" : "Ordinary correlations", T
        printf "%-10s%14s%14s%14s\n", "Number", "Value", "Proportion", "Cumulative"
        loop j = 1..m
            printf "%-10d%14.6f%14.4f%14.4f\n", j, lam[j], r.prop[j], r.cumprop[j]
        endloop
        printf "\nEigenvectors (loadings):\n%-12s", "Variable"
        loop j = 1..m
            printf "%12s", sprintf("PC %d", j)
        endloop
        printf "\n"
        loop i = 1..m
            printf "%-12s", toupper(tok[i])
            loop j = 1..m
                printf "%12.6f", EV[i, j]
            endloop
            printf "\n"
        endloop
    endif
    return r
end function

function series ev_pcscore (bundle r "ev_pcomp result", int j[1::1] "Component")
    return ev__toseries(r.scores[, j], r.tobs)
end function

# -------------------------------------------------------------------
# More date, word-list and statistics functions (@dateadd, @wfind, @cov, ...)
# -------------------------------------------------------------------

function matrix ev__ymd (scalar d "EViews date number")
    scalar iso = isodate(d + 1)                 # epoch day = EViews date number + 1
    scalar y = floor(iso / 10000)
    scalar m = floor(iso / 100) - 100 * y
    return {y, m, iso - 10000 * y - 100 * m}
end function

function scalar ev_dateadd (scalar d "EViews date number", scalar n, string unit[null] "dd, ww, mm, qq or yy")
    string u = exists(unit) ? tolower(unit) : "dd"
    if u == "dd"
        return d + n
    elif u == "ww"
        return d + 7 * n
    endif
    matrix ymd = ev__ymd(d)
    scalar months = u == "mm" ? n : (u == "qq" ? 3 * n : (u == "yy" ? 12 * n : NA))
    errorif(!ok(months), "unit must be dd, ww, mm, qq or yy")
    scalar tot = ymd[1] * 12 + ymd[2] - 1 + months
    scalar y = floor(tot / 12)
    scalar m = tot - 12 * y + 1
    scalar dd = ymd[3]
    # clamp the day to the length of the target month
    scalar ml = monthlen(m, y, 7)
    return epochday(y, m, min(dd, ml)) - 1
end function

function scalar ev_datediff (scalar d1 "EViews date number", scalar d2, string unit[null] "dd, ww, mm, qq or yy")
    # d1 - d2 in whole units
    string u = exists(unit) ? tolower(unit) : "dd"
    if u == "dd"
        return d1 - d2
    elif u == "ww"
        return floor((d1 - d2) / 7)
    endif
    matrix a = ev__ymd(d1)
    matrix b = ev__ymd(d2)
    scalar months = (a[1] - b[1]) * 12 + a[2] - b[2]
    if u == "mm"
        return months
    elif u == "qq"
        return floor(months / 3)
    elif u == "yy"
        return a[1] - b[1]
    endif
    errorif(1, "unit must be dd, ww, mm, qq or yy")
    return NA
end function

function scalar ev_makedate (scalar v, string fmt "yyyy, yyyymm, yyyymmdd, yyyy.mm or mm.dd")
    string f = tolower(fmt)
    if f == "yyyy"
        return epochday(v, 1, 1) - 1
    elif f == "yyyymm"
        return epochday(floor(v / 100), v % 100, 1) - 1
    elif f == "yyyymmdd"
        return epochday(floor(v / 10000), floor(v / 100) % 100, v % 100) - 1
    elif f == "yyyy.mm"
        return epochday(floor(v), round(100 * (v - floor(v))), 1) - 1
    endif
    errorif(1, "format must be yyyy, yyyymm, yyyymmdd or yyyy.mm")
    return NA
end function

function scalar ev_wfind (string s "Word list", string w "Word")
    # position of a word in a space-separated list (0 if absent), case-insensitive
    strings t = strsplit(s)
    loop i = 1..nelem(t)
        if toupper(t[i]) == toupper(w)
            return i
        endif
    endloop
    return 0
end function

function string ev_wdrop (string s "Word list", string drop "Words to drop")
    strings t = strsplit(s)
    string out = ""
    loop i = 1..nelem(t)
        if !ev_wfind(drop, t[i])
            out ~= (out == "" ? "" : " ") ~ t[i]
        endif
    endloop
    return out
end function

function string ev_wkeep (string s "Word list", string keep "Words to keep")
    strings t = strsplit(s)
    string out = ""
    loop i = 1..nelem(t)
        if ev_wfind(keep, t[i])
            out ~= (out == "" ? "" : " ") ~ t[i]
        endif
    endloop
    return out
end function

function string ev_wunique (string s "Word list")
    strings t = strsplit(s)
    string out = ""
    loop i = 1..nelem(t)
        if !ev_wfind(out, t[i])
            out ~= (out == "" ? "" : " ") ~ t[i]
        endif
    endloop
    return out
end function

function string ev_wreplace (string s "Word list", string src "Word", string dst "Replacement")
    strings t = strsplit(s)
    string out = ""
    loop i = 1..nelem(t)
        string w = toupper(t[i]) == toupper(src) ? dst : t[i]
        out ~= (out == "" ? "" : " ") ~ w
    endloop
    return out
end function

function string ev_wsort (string s "Word list", bool desc[0])
    strings t = strsplit(s)
    scalar n = nelem(t)
    # insertion sort, case-insensitive
    loop i = 2..n
        string key = t[i]
        scalar j = i - 1
        loop while j >= 1
            scalar cmpv = strncmp(toupper(t[j]), toupper(key))
            if (desc && cmpv < 0) || (!desc && cmpv > 0)
                t[j + 1] = t[j]
                j--
            else
                break
            endif
        endloop
        t[j + 1] = key
    endloop
    string out = ""
    loop i = 1..n
        out ~= (out == "" ? "" : " ") ~ t[i]
    endloop
    return out
end function

function scalar ev_covp (series x, series y)
    # EViews @cov: population covariance (divides by n)
    smpl ok(x) && ok(y) --restrict
    return cov(x, y) * ($nobs - 1) / $nobs
end function

function series ev_cumprod (series x)
    set skip_missing off
    matrix v = {x}
    matrix r = v
    loop t = 2..rows(v)
        r[t] = r[t - 1] * v[t]
    endloop
    series out = r
    return out
end function

function series ev_cummax (series x, bool mn[0] "Cumulative minimum instead")
    set skip_missing off
    matrix v = {x}
    matrix r = v
    loop t = 2..rows(v)
        if ok(r[t - 1]) && ok(v[t])
            r[t] = mn ? min(r[t - 1], v[t]) : max(r[t - 1], v[t])
        elif ok(r[t - 1])
            r[t] = r[t - 1]
        endif
    endloop
    series out = r
    return out
end function

function scalar ev_ifirst (series x)
    # observation number of the first non-missing value (EViews @ifirst)
    set skip_missing off
    matrix v = {x}
    loop t = 1..rows(v)
        if ok(v[t])
            return $t1 + t - 1
        endif
    endloop
    return NA
end function

function scalar ev_ilast (series x)
    set skip_missing off
    matrix v = {x}
    scalar n = rows(v)
    loop i = 1..n                 # hansl loops only count upwards
        scalar t = n - i + 1
        if ok(v[t])
            return $t1 + t - 1
        endif
    endloop
    return NA
end function

# -------------------------------------------------------------------
# Phase 3 estimators: PARCH and component GARCH, truncated regression,
# Heckman selection, robust and stepwise LS, CCR, breaks / thresholds /
# Markov switching, MIDAS, GLM, elastic net, panel IV, two-way RE
# -------------------------------------------------------------------

function bundle ev__xspec (string spec, list vars, string pfx)
    # parse "y c x1 x2": returns y and X as matrices over the current sample (missing kept) and labels
    strings tok = strsplit(spec)
    set skip_missing off
    series ev_xs_y = ev_gen(tok[1], vars)
    matrix y = {ev_xs_y}
    matrix X = {}
    strings lab = array(0)
    loop i = 2..nelem(tok)
        if tolower(tok[i]) == "c"
            X ~= ones(rows(y), 1)
            lab += "C"
        else
            series ev_xs_x = ev_gen(tok[i], vars)
            X ~= {ev_xs_x}
            lab += toupper(tok[i])
        endif
    endloop
    series ev_xs_o = obs
    matrix tob = {ev_xs_o}
    matrix okr = sumr(!ok(y ~ X)) .= 0
    return _(y = selifr(y, okr), X = selifr(X, okr), tobs = selifr(tob, okr), labels = lab, \
      depvar = toupper(tok[1]), spec = spec)
end function

function void ev__finish (bundle *b, bool zstat)
    # common statistics and t/z tables for matrix-based estimators
    b.k = rows(b.coeff)
    b.stderr = sqrt(diag(b.vcv))
    b.tstat = b.coeff ./ b.stderr
    matrix pv = zeros(b.k, 1)
    loop i = 1..b.k
        pv[i] = zstat ? 2 * cnorm(-abs(b.tstat[i])) : 2 * pvalue(t, b.T - b.k, abs(b.tstat[i]))
    endloop
    b.pval = pv
    b.sample = sprintf("%s %s", obslabel(minc(b.tobs)), obslabel(maxc(b.tobs)))
    b.estdate = strftime($now[1], "%m/%d/%y   Time: %H:%M")
end function

# --- PARCH (power ARCH, asymmetric) and component GARCH, (1,1)

function matrix ev__pch (const matrix th, const matrix y, const matrix X, scalar comp, scalar s2)
    # returns [ll_t, e_t, h_t]; th = [b (k), omega, alpha, gamma, beta, delta] (PARCH)
    #                                 or [b (k), omega, rho, phi, alpha, beta] (component)
    scalar T = rows(y)
    scalar k = cols(X)
    matrix e = y - X * th[1:k]
    matrix h = zeros(T, 1)
    matrix ll = zeros(T, 1)
    if comp
        scalar w = th[k+1]
        scalar rho = th[k+2]
        scalar phi = th[k+3]
        scalar a = th[k+4]
        scalar bt = th[k+5]
        scalar q = s2
        scalar hp = s2
        scalar ep = s2                 # pre-sample e^2
        loop t = 1..T
            scalar qn = w + rho * (q - w) + phi * (ep - hp)
            scalar hn = qn + a * (ep - q) + bt * (hp - q)
            if !ok(hn) || hn <= 0
                return mshape(NA, T, 3)
            endif
            h[t] = hn
            q = qn
            hp = hn
            ep = e[t]^2
        endloop
    else
        scalar w = th[k+1]
        scalar a = th[k+2]
        scalar g = th[k+3]
        scalar bt = th[k+4]
        scalar dl = th[k+5]
        if dl <= 0 || abs(g) >= 1
            return mshape(NA, T, 3)
        endif
        scalar sp = s2^(dl / 2)          # pre-sample sigma^delta
        scalar ap = sp
        loop t = 1..T
            scalar sd = w + a * ap + bt * sp
            if !ok(sd) || sd <= 0
                return mshape(NA, T, 3)
            endif
            h[t] = sd^(2 / dl)
            sp = sd
            ap = (abs(e[t]) - g * e[t])^dl
        endloop
    endif
    ll = -0.5 * (log(2 * $pi) + log(h) + e.^2 ./ h)
    return ll ~ e ~ h
end function

function scalar ev__pchobj (const matrix th, const matrix y, const matrix X, scalar comp, scalar s2)
    matrix r = ev__pch(th, y, X, comp, s2)
    scalar s = sumc(r[, 1])
    return ok(s) ? s : -1e100
end function

function bundle ev_garchx (string spec "Mean equation, e.g. r c", list vars "Series used (e.g. dataset)",
                           string model "parch or component", bool quiet[0])
    # EViews arch(1,1,parch) and arch(1,1,cgarch): own likelihood, started from GARCH(1,1)
    string md = tolower(model)
    errorif(md != "parch" && md != "component", "model must be parch or component")
    bundle g0 = ev_garch(spec, vars, "garch", 1, 1, 1)
    errorif(g0.failed, "the GARCH(1,1) starting values could not be computed")
    bundle d = ev__xspec(spec, vars, "evg")
    scalar k = cols(d.X)
    matrix yv = d.y
    matrix Xv = d.X
    matrix c0 = g0.coeff
    scalar s2 = meanc(g0.uhat.^2)
    scalar comp = md == "component"
    matrix th = c0[1:k]
    if comp
        # GARCH(1,1) is the component model with alpha = beta = 0: omega = w/(1-rho), phi = a, rho = a + b
        scalar rho0 = min(0.99, c0[k+2] + c0[k+3])
        th |= {c0[k+1] / (1 - rho0); rho0; c0[k+2]; 0.05; 0.5}
    else
        th |= {c0[k+1]; c0[k+2]; 0; c0[k+3]; 2}
    endif
    set max_verbose off
    set bfgs_richardson on
    # BFGS; if the final gradient check fails, restart once from the last point (EViews also
    # reports a warning and the estimates when convergence is not achieved)
    scalar conv = 1
    catch scalar lnl = BFGSmax(&th, "ev__pchobj(th, yv, Xv, comp, s2)")
    if $error
        catch lnl = BFGSmax(&th, "ev__pchobj(th, yv, Xv, comp, s2)")
        if $error
            conv = 0
            printf "Warning: convergence not achieved (gradient check)\n"
            lnl = ev__pchobj(th, yv, Xv, comp, s2)
        endif
    endif
    matrix H = numhess(th, "ev__pchobj(th, yv, Xv, comp, s2)")
    set bfgs_richardson off
    catch matrix V = -inv(H)
    if $error
        matrix V = mshape(NA, rows(th), rows(th))
    endif
    matrix R = ev__pch(th, yv, Xv, comp, s2)
    bundle b
    b.kind = "garch"
    b.failed = 0
    b.model = md
    b.archm = 0
    b.nthr = comp ? 0 : 1
    b.narch = 1
    b.ngarch = 1
    b.spec = spec
    b.depvar = d.depvar
    b.method = comp ? "ML ARCH - Normal distribution (component ARCH(1,1))" : "ML ARCH - Normal distribution (Power ARCH)"
    b.coeff = th
    b.vcv = V
    b.stderr = sqrt(diag(V))
    b.k = rows(th)
    strings lab = array(0)
    loop i = 1..b.k
        lab += sprintf("C(%d)", i)
    endloop
    if !comp
        lab[b.k] = sprintf("C(%d) (delta)", b.k)
    endif
    b.clabels = lab
    b.xlab = d.labels
    b.nm = k
    b.lnl = lnl
    b.T = rows(d.y)
    b.uhat = R[, 2]
    b.h = R[, 3]
    b.tobs = d.tobs
    b.sample = sprintf("%s %s", obslabel(minc(d.tobs)), obslabel(maxc(d.tobs)))
    b.estdate = strftime($now[1], "%m/%d/%y   Time: %H:%M")
    if comp
        b.vareq = sprintf("Q = C(%d) + C(%d)*(Q(-1) - C(%d)) + C(%d)*(RESID(-1)^2 - GARCH(-1))\nGARCH = Q + C(%d)*(RESID(-1)^2 - Q(-1)) + C(%d)*(GARCH(-1) - Q(-1))", \
          k+1, k+2, k+1, k+3, k+4, k+5)
    else
        b.vareq = sprintf("@SQRT(GARCH)^C(%d) = C(%d) + C(%d)*(ABS(RESID(-1)) - C(%d)*RESID(-1))^C(%d) + C(%d)*@SQRT(GARCH(-1))^C(%d)", \
          k+5, k+1, k+2, k+3, k+5, k+4, k+5)
    endif
    scalar n = b.T
    b.aic = -2 * lnl / n + 2 * b.k / n
    b.sc = -2 * lnl / n + b.k * log(n) / n
    b.hq = -2 * lnl / n + 2 * b.k * log(log(n)) / n
    if !quiet
        ev_garchprint(&b)
    endif
    return b
end function

# --- truncated regression (equation.censored with the truncated option)

function scalar ev__trll (const matrix th, const matrix y, const matrix X, scalar lo, scalar hi)
    scalar k = cols(X)
    scalar s = exp(th[k+1])
    matrix m = X * th[1:k]
    matrix ll = log(dnorm((y - m) / s)) - log(s)
    matrix pr = ones(rows(y), 1)
    if ok(lo) && ok(hi)
        pr = cnorm((hi - m) / s) - cnorm((lo - m) / s)
    elif ok(lo)
        pr = 1 - cnorm((lo - m) / s)
    elif ok(hi)
        pr = cnorm((hi - m) / s)
    endif
    scalar r = sumc(ll - log(pr))
    return ok(r) ? r : -1e100
end function

function bundle ev_truncreg (string spec "Equation, e.g. y c x", list vars "Series used (e.g. dataset)",
                             scalar lo[NA] "Left truncation point", scalar hi[NA] "Right truncation point",
                             bool quiet[0])
    bundle d = ev__xspec(spec, vars, "evt")
    errorif(!ok(lo) && !ok(hi), "Give a truncation point (left and/or right)")
    matrix y = d.y
    matrix X = d.X
    matrix th = mols(y, X)
    th |= log(sdc(y - X * th))
    set max_verbose off
    scalar lnl = BFGSmax(&th, "ev__trll(th, y, X, lo, hi)")
    matrix H = numhess(th, "ev__trll(th, y, X, lo, hi)")
    matrix V = -inv(H)
    scalar k = cols(X)
    # report the scale (not its log), delta method
    matrix J = I(k + 1)
    J[k+1, k+1] = exp(th[k+1])
    bundle b
    b.kind = "mlreg"
    b.method = "trunc"
    b.depvar = d.depvar
    b.spec = spec
    b.labels = d.labels
    b.labels += sprintf("SCALE:C(%d)", k + 1)
    b.coeff = th[1:k] | exp(th[k+1])
    b.vcv = J * V * J'
    b.T = rows(y)
    b.tobs = d.tobs
    b.lnl = lnl
    b.y = y
    b.yhat = X * th[1:k]
    b.uhat = y - b.yhat
    ev__finish(&b, 1)
    b.zstat = 1
    b.adjusted = 0
    b.meany = meanc(y)
    b.sdy = sdc(y) * sqrt(b.T / (b.T - 1))
    b.aic = -2 * lnl / b.T + 2 * b.k / b.T
    b.sc = -2 * lnl / b.T + b.k * log(b.T) / b.T
    b.hq = -2 * lnl / b.T + 2 * b.k * log(log(b.T)) / b.T
    b.avglnl = lnl / b.T
    if !quiet
        ev_mlprint(&b)
    endif
    return b
end function

# --- Heckman selection (equation.heckit y c x @ s c z)

function bundle ev_heckit (string spec "Outcome equation @ selection equation, e.g. y c x @ s c z",
                           list vars "Series used (e.g. dataset)", bool twostep[0], bool quiet[0])
    errorif(!instring(spec, "@"), "Give the selection equation after @")
    strings parts = strsplit(spec, "@")
    strings t1 = strsplit(strstrip(parts[1]))
    strings t2 = strsplit(strstrip(parts[2]))
    series evh_y = ev_gen(t1[1], vars)
    series evh_s = ev_gen(t2[1], vars)
    list X = null
    list Z = null
    strings lab = array(0)
    loop i = 2..nelem(t1)
        if tolower(t1[i]) == "c"
            list X += const
            lab += "C"
        else
            string v = sprintf("evh_x%d", i)
            series @v = ev_gen(t1[i], vars)
            list X += @v
            lab += toupper(t1[i])
        endif
    endloop
    loop i = 2..nelem(t2)
        if tolower(t2[i]) == "c"
            list Z += const
            lab += "C (selection)"
        else
            string v = sprintf("evh_z%d", i)
            series @v = ev_gen(t2[i], vars)
            list Z += @v
            lab += toupper(t2[i]) ~ " (selection)"
        endif
    endloop
    if twostep
        heckit evh_y X ; evh_s Z --two-step --quiet
    else
        heckit evh_y X ; evh_s Z --quiet
    endif
    bundle b
    b.kind = "heckit"
    b.depvar = toupper(t1[1])
    b.method = twostep ? "Heckman Selection (2-step)" : "Heckman Selection (ML)"
    scalar k = nelem(lab)
    b.coeff = $coeff[1:k]
    b.vcv = $vcv[1:k, 1:k]
    b.labels = lab
    b.T = $T
    series evh_o = obs
    matrix tob = {evh_o}
    b.tobs = tob
    catch scalar lnl = $lnl
    b.lnl = $error ? NA : lnl
    ev__finish(&b, 1)
    if !quiet
        ev_coefprint(&b)
        printf "Log likelihood %.6f\n", b.lnl
    endif
    return b
end function

# --- robust least squares (M-estimation) and stepwise least squares

function bundle ev_robustls (string spec "Equation, e.g. y c x", list vars "Series used (e.g. dataset)",
                             string psi[null] "bisquare (default) or huber", scalar tune[NA] "Tuning constant",
                             bool quiet[0])
    string f = exists(psi) ? tolower(psi) : "bisquare"
    errorif(f != "bisquare" && f != "huber", "psi must be bisquare or huber")
    scalar cc = ok(tune) ? tune : (f == "bisquare" ? 4.685 : 1.345)
    bundle d = ev__xspec(spec, vars, "evr")
    matrix y = d.y
    matrix X = d.X
    scalar n = rows(y)
    scalar k = cols(X)
    matrix b = mols(y, X)
    scalar s = 1
    loop it = 1..200
        matrix e = y - X * b
        s = quantile(abs(e - quantile(e, 0.5)), 0.5) / 0.6745       # MAD scale
        matrix u = e / s
        matrix w = f == "huber" ? (abs(u) .<= cc) + (abs(u) .> cc) .* (cc ./ abs(u)) : (abs(u) .< cc) .* (1 - (u / cc).^2).^2
        matrix bn = mols(y .* sqrt(w), X .* sqrt(w))
        scalar dlt = maxc(abs(bn - b) ./ (1 + abs(b)))
        b = bn
        if dlt < 1e-10
            break
        endif
    endloop
    matrix e = y - X * b
    matrix u = e / s
    matrix ps = f == "huber" ? (abs(u) .<= cc) .* u + (abs(u) .> cc) .* cc .* sgn(u) : (abs(u) .< cc) .* u .* (1 - (u / cc).^2).^2
    matrix dps = f == "huber" ? (abs(u) .<= cc) : (abs(u) .< cc) .* (1 - (u / cc).^2) .* (1 - 5 * (u / cc).^2)
    scalar m1 = meanc(dps)
    scalar m2 = meanc(ps.^2)
    # Huber type I covariance
    scalar kap = 1 + k / n * (1 - m1) / m1
    matrix V = kap^2 * (m2 / m1^2) * s^2 * (n / (n - k)) * inv(X'X)
    bundle r
    r.kind = "robustls"
    r.method = sprintf("Robust Least Squares (M-estimation, %s, c = %g)", f == "huber" ? "Huber" : "Bisquare", cc)
    r.depvar = d.depvar
    r.spec = spec
    r.labels = d.labels
    r.coeff = b
    r.vcv = V
    r.T = n
    r.tobs = d.tobs
    r.y = y
    r.uhat = e
    r.yhat = y - e
    r.scale = s
    r.weights = f == "huber" ? (abs(u) .<= cc) + (abs(u) .> cc) .* (cc ./ abs(u)) : (abs(u) .< cc) .* (1 - (u / cc).^2).^2
    ev__finish(&r, 1)
    if !quiet
        ev_coefprint(&r)
        printf "Scale (MAD): %.6f\n", s
    endif
    return r
end function

function bundle ev_stepls (string spec "y and always-included regressors @ candidates, e.g. y c @ x1 x2 x3",
                           list vars "Series used (e.g. dataset)",
                           string method[null] "fwd (stepwise forwards, default) or back (backwards)",
                           scalar pin[0.05] "p-value to enter", scalar pout[0.10] "p-value to remove",
                           bool quiet[0])
    errorif(!instring(spec, "@"), "Give the search regressors after @")
    string m = exists(method) ? tolower(method) : "fwd"
    strings parts = strsplit(spec, "@")
    string base = strstrip(parts[1])
    strings cand = strsplit(strstrip(parts[2]))
    scalar nc = nelem(cand)
    matrix inn = m == "back" ? ones(1, nc) : zeros(1, nc)
    loop it = 1..4 * nc + 4
        scalar changed = 0
        # forward step: the candidate with the smallest p-value
        if m != "back"
            scalar bestp = 1
            scalar bestj = 0
            loop j = 1..nc
                if !inn[j]
                    string sp = base
                    loop i = 1..nc
                        if inn[i] || i == j
                            sp ~= " " ~ cand[i]
                        endif
                    endloop
                    bundle e = ev_ls(sp, vars, null, 1)
                    scalar pj = e.pval[e.k]
                    if pj < bestp
                        bestp = pj
                        bestj = j
                    endif
                endif
            endloop
            if bestj > 0 && bestp < pin
                inn[bestj] = 1
                changed = 1
            endif
        endif
        # backward step: remove the worst included candidate
        string sp = base
        strings incl = array(0)
        loop i = 1..nc
            if inn[i]
                sp ~= " " ~ cand[i]
                incl += cand[i]
            endif
        endloop
        if nelem(incl) > 0
            bundle e = ev_ls(sp, vars, null, 1)
            scalar kb = e.k - nelem(incl)
            matrix pc = e.pval[kb + 1:e.k]
            scalar worst = imaxc(pc)
            if pc[worst] > pout
                loop i = 1..nc
                    if cand[i] == incl[worst]
                        inn[i] = 0
                    endif
                endloop
                changed = 1
            endif
        endif
        if !changed
            break
        endif
    endloop
    string sp = base
    loop i = 1..nc
        if inn[i]
            sp ~= " " ~ cand[i]
        endif
    endloop
    bundle r = ev_ls(sp, vars, null, 1)
    r.method = sprintf("Stepwise Regression (%s, p-value to enter %g, to remove %g)", m == "back" ? "backwards" : "stepwise forwards", pin, pout)
    r.selected = sp
    if !quiet
        ev_print(&r)
    endif
    return r
end function

# --- Markov switching regression (two regimes, Hamilton filter)

function matrix ev__msw (const matrix th, const matrix y, const matrix X, scalar k)
    # th = [b1 (k); b2 (k); log s1; log s2; logit p11; logit p22]; returns [ll_t, P(s=1|t), P(s=1|t-1)]
    matrix b1 = th[1:k]
    matrix b2 = th[k+1:2*k]
    scalar s1 = exp(th[2*k+1])
    scalar s2 = exp(th[2*k+2])
    scalar p11 = 1 / (1 + exp(-th[2*k+3]))
    scalar p22 = 1 / (1 + exp(-th[2*k+4]))
    scalar T = rows(y)
    matrix f1 = dnorm((y - X * b1) / s1) / s1
    matrix f2 = dnorm((y - X * b2) / s2) / s2
    scalar xi = (1 - p22) / (2 - p11 - p22)          # ergodic probability of regime 1
    matrix out = zeros(T, 3)
    loop t = 1..T
        scalar pr1 = t == 1 ? xi : p11 * xi + (1 - p22) * (1 - xi)
        scalar lik = pr1 * f1[t] + (1 - pr1) * f2[t]
        if !(lik > 0)
            return mshape(NA, T, 3)
        endif
        xi = pr1 * f1[t] / lik
        out[t,] = log(lik) ~ xi ~ pr1
    endloop
    return out
end function

function scalar ev__mswobj (const matrix th, const matrix y, const matrix X, scalar k)
    matrix r = ev__msw(th, y, X, k)
    scalar s = sumc(r[, 1])
    return ok(s) ? s : -1e100
end function

function bundle ev_switchreg (string spec "Equation, e.g. y c y(-1)", list vars "Series used (e.g. dataset)",
                              bool quiet[0])
    # all coefficients and the error variance switch between two Markov regimes
    bundle d = ev__xspec(spec, vars, "evm")
    matrix y = d.y
    matrix X = d.X
    scalar k = cols(X)
    matrix b0 = mols(y, X)
    matrix e0 = y - X * b0
    scalar s0 = sdc(e0)
    # start: regimes above / below the OLS fit
    matrix sh = 0.5 * s0 * (seq(1, k)' .= 1)
    matrix th = (b0 + sh) | (b0 - sh) | log(s0) | log(s0) | 2 | 2
    set max_verbose off
    set bfgs_richardson on
    # BFGS; if the final gradient check fails, restart once from the last point (EViews also
    # reports a warning and the estimates when convergence is not achieved)
    scalar conv = 1
    catch scalar lnl = BFGSmax(&th, "ev__mswobj(th, y, X, k)")
    if $error
        catch lnl = BFGSmax(&th, "ev__mswobj(th, y, X, k)")
        if $error
            conv = 0
            printf "Warning: convergence not achieved (gradient check)\n"
            lnl = ev__mswobj(th, y, X, k)
        endif
    endif
    matrix H = numhess(th, "ev__mswobj(th, y, X, k)")
    set bfgs_richardson off
    catch matrix V = -inv(H)
    if $error
        matrix V = mshape(NA, rows(th), rows(th))
    endif
    matrix R = ev__msw(th, y, X, k)
    bundle b
    b.kind = "switchreg"
    b.method = "Markov Switching Regression (BFGS / Marquardt steps)"
    b.depvar = d.depvar
    b.spec = spec
    strings lab = array(0)
    loop r = 1..2
        loop i = 1..k
            lab += sprintf("%s (regime %d)", d.labels[i], r)
        endloop
    endloop
    lab += "LOG(SIGMA) (regime 1)"
    lab += "LOG(SIGMA) (regime 2)"
    lab += "P11-C (logit)"
    lab += "P22-C (logit)"
    b.labels = lab
    b.coeff = th
    b.vcv = V
    b.T = rows(y)
    b.tobs = d.tobs
    b.lnl = lnl
    b.p11 = 1 / (1 + exp(-th[2*k+3]))
    b.p22 = 1 / (1 + exp(-th[2*k+4]))
    b.filtered = R[, 2]
    ev__finish(&b, 1)
    if !quiet
        ev_coefprint(&b)
        printf "Transition probabilities: P(1|1) = %.4f, P(2|2) = %.4f\n", b.p11, b.p22
        printf "Expected durations: regime 1 %.2f, regime 2 %.2f\nLog likelihood %.6f\n", 1 / (1 - b.p11), 1 / (1 - b.p22), lnl
    endif
    return b
end function

# --- threshold regression and Bai-Perron multiple breaks (global SSR minimisation)

function bundle ev_threshold (string spec "Equation, e.g. y c y(-1)", string thvar "Threshold variable",
                              list vars "Series used (e.g. dataset)", scalar trim[0.15], bool quiet[0])
    # one threshold: all coefficients differ below and above the threshold value (grid search)
    bundle d = ev__xspec(spec ~ " " ~ thvar, vars, "evth")
    matrix y = d.y
    scalar kx = cols(d.X) - 1
    matrix X = d.X[, 1:kx]
    matrix q = d.X[, kx + 1]
    scalar n = rows(y)
    matrix qs = sort(q)
    scalar lo = ceil(trim * n)
    scalar hi = floor((1 - trim) * n)
    scalar best = 1e300
    scalar gam = NA
    loop i = lo..hi
        scalar g = qs[i]
        matrix m1 = q .<= g
        if sumc(m1) > kx && sumc(!m1) > kx
            bundle a1 = ev__olsr(selifr(y, m1), selifr(X, m1))
            bundle a2 = ev__olsr(selifr(y, !m1), selifr(X, !m1))
            if a1.ssr + a2.ssr < best
                best = a1.ssr + a2.ssr
                gam = g
            endif
        endif
    endloop
    matrix m1 = q .<= gam
    matrix Z = (X .* m1) ~ (X .* !m1)
    bundle a = ev__olsr(y, Z)
    bundle b
    b.kind = "threshold"
    b.method = sprintf("Threshold Regression (threshold variable %s)", toupper(thvar))
    b.depvar = d.depvar
    strings lab = array(0)
    loop i = 1..kx
        lab += sprintf("%s (%s < %.6g)", d.labels[i], toupper(thvar), gam)
    endloop
    loop i = 1..kx
        lab += sprintf("%s (%s >= %.6g)", d.labels[i], toupper(thvar), gam)
    endloop
    b.labels = lab
    b.threshold = gam
    b.coeff = a.coeff
    b.vcv = (a.ssr / (n - cols(Z))) * inv(Z'Z)
    b.T = n
    b.tobs = d.tobs
    b.ssr = a.ssr
    ev__finish(&b, 0)
    if !quiet
        ev_coefprint(&b)
        printf "Threshold value: %g   Sum squared resid: %.6f\n", gam, a.ssr
    endif
    return b
end function

function bundle ev_breakls (string spec "Equation, e.g. y c x", list vars "Series used (e.g. dataset)",
                            int maxbreaks[0::5], scalar trim[0.15], string crit[null] "bic (default) or lwz",
                            bool quiet[0])
    # Bai-Perron global minimisation of the SSR (dynamic programming) for 0..maxbreaks breaks;
    # the number of breaks is chosen by an information criterion
    string cr = exists(crit) ? tolower(crit) : "bic"
    bundle d = ev__xspec(spec, vars, "evb")
    matrix y = d.y
    matrix X = d.X
    scalar n = rows(y)
    scalar q = cols(X)
    scalar h = max(q + 1, ceil(trim * n))
    # SSR of every admissible segment [i, j]
    matrix S = mshape(NA, n, n)
    loop i = 1..n - h + 1
        loop j = i + h - 1..n
            matrix e = {}
            matrix bb = mols(y[i:j], X[i:j,], &e)
            S[i, j] = e'e
        endloop
    endloop
    # dynamic programming: best SSR with m breaks for observations 1..j
    matrix best = mshape(NA, maxbreaks + 1, n)
    matrix arg = zeros(maxbreaks + 1, n)
    loop j = h..n
        best[1, j] = S[1, j]
    endloop
    loop m = 1..maxbreaks
        loop j = (m + 1) * h..n
            scalar bv = 1e300
            loop t = m * h..j - h
                if ok(best[m, t]) && ok(S[t + 1, j])
                    scalar v = best[m, t] + S[t + 1, j]
                    if v < bv
                        bv = v
                        arg[m + 1, j] = t
                    endif
                endif
            endloop
            best[m + 1, j] = bv < 1e300 ? bv : NA
        endloop
    endloop
    matrix ic = mshape(NA, maxbreaks + 1, 1)
    loop m = 0..maxbreaks
        scalar ssr = best[m + 1, n]
        if ok(ssr)
            scalar npar = (m + 1) * q + m
            ic[m + 1] = cr == "lwz" ? log(ssr / (n - npar)) + npar * 0.299 * log(n)^2.1 / n : log(ssr / n) + npar * log(n) / n
        endif
    endloop
    matrix icx = ic
    loop i = 1..rows(icx)
        if !ok(icx[i])
            icx[i] = 1e300
        endif
    endloop
    scalar mopt = iminc(icx) - 1
    # break dates by backtracking
    matrix bd = zeros(1, mopt)
    scalar j = n
    scalar mm = mopt
    loop while mm >= 1
        scalar t = arg[mm + 1, j]
        bd[mm] = t
        j = t
        mm--
    endloop
    # regime-specific coefficients
    matrix cuts = 0 ~ bd ~ n
    matrix Z = {}
    strings lab = array(0)
    loop r = 1..mopt + 1
        matrix ind = (seq(1, n)' .> cuts[r]) .* (seq(1, n)' .<= cuts[r + 1])
        Z ~= X .* ind
        loop i = 1..q
            lab += sprintf("%s (%s - %s)", d.labels[i], obslabel(d.tobs[cuts[r] + 1]), obslabel(d.tobs[cuts[r + 1]]))
        endloop
    endloop
    bundle a = ev__olsr(y, Z)
    bundle b
    b.kind = "breakls"
    b.method = sprintf("Least Squares with Breaks (Bai-Perron global, %s)", toupper(cr))
    b.depvar = d.depvar
    b.labels = lab
    b.coeff = a.coeff
    b.vcv = (a.ssr / (n - cols(Z))) * inv(Z'Z)
    b.T = n
    b.tobs = d.tobs
    b.nbreaks = mopt
    strings bdl = array(0)
    loop i = 1..mopt
        bdl += obslabel(d.tobs[bd[i] + 1])
    endloop
    b.breaks = bdl
    b.breakobs = mopt > 0 ? d.tobs[bd + 1]' : {}
    b.ic = ic
    b.ssr_m = best[, n]
    # sup-F type statistics for m breaks against none (no p-values: Bai-Perron tables)
    matrix Fm = zeros(maxbreaks, 1)
    loop m = 1..maxbreaks
        Fm[m] = ok(best[m + 1, n]) ? ((best[1, n] - best[m + 1, n]) / (m * q)) / (best[m + 1, n] / (n - (m + 1) * q - m)) : NA
    endloop
    b.supF = Fm
    ev__finish(&b, 0)
    if !quiet
        printf "\nBreak selection: %s; trimming %g; maximum breaks %d\n", toupper(cr), trim, maxbreaks
        printf "%8s%16s%14s%14s\n", "Breaks", "SSR", "Criterion", "sup F(m|0)"
        loop m = 0..maxbreaks
            printf "%8d%16.6f%14.6f%14s\n", m, best[m + 1, n], ic[m + 1], m == 0 ? "" : sprintf("%.4f", Fm[m])
        endloop
        printf "Selected breaks: %d", mopt
        loop i = 1..mopt
            printf "  %s", bdl[i]
        endloop
        printf "\n"
        ev_coefprint(&b)
    endif
    return b
end function

# --- MIDAS with a high-frequency series from another page

function matrix ev_midaslags (const matrix S "ev_pagecol() of the high-frequency series", int K[1::12] "Number of lags")
    # for each observation of the current (low-frequency) page: the last K high-frequency values
    # of its period, most recent first
    set skip_missing off
    series d = ev__epochdays()
    matrix D = {d}
    scalar T = rows(D)
    matrix Dn = D[2:T] | (2 * D[T] - D[T - 1])
    matrix L = mshape(NA, T, K)
    loop t = 1..T
        matrix in = S[, 1] .< Dn[t]
        if sumc(in) >= K
            scalar last = 0
            loop i = 1..rows(S)
                if in[i]
                    last = i
                endif
            endloop
            loop j = 1..K
                L[t, j] = S[last - j + 1, 2]
            endloop
        endif
    endloop
    return L
end function

function scalar ev__midssr (const matrix th, const matrix y, const matrix X, const matrix L)
    # normalised beta weights (theta1, theta2 > 0) times slope
    scalar K = cols(L)
    scalar k = cols(X)
    scalar a = exp(th[k + 2])
    scalar bb = exp(th[k + 3])
    matrix x = (seq(1, K)' - 1) / (K - 1) * (1 - 2e-6) + 1e-6
    matrix w = x.^(a - 1) .* (1 - x).^(bb - 1)
    w = w / sumc(w)
    matrix e = y - X * th[1:k] - th[k + 1] * (L * w)
    scalar r = e'e
    return ok(r) ? -r : -1e100
end function

function bundle ev_midas (string spec "Low-frequency part, e.g. y c y(-1)", list vars "Series used (e.g. dataset)",
                          const matrix L "High-frequency lags (ev_midaslags)",
                          string poly[null] "almon (default), beta, step or umidas", int deg[1::3] "PDL degree / step length",
                          bool quiet[0])
    string pm = exists(poly) ? tolower(poly) : "almon"
    bundle d = ev__xspec(spec, vars, "evmi")
    # align the high-frequency lags with the estimation rows
    matrix Lr = mshape(NA, rows(d.y), cols(L))
    scalar o1 = $t1
    loop i = 1..rows(d.y)
        Lr[i,] = L[d.tobs[i] - o1 + 1,]
    endloop
    matrix okr = sumr(!ok(Lr)) .= 0
    matrix y = selifr(d.y, okr)
    matrix X = selifr(d.X, okr)
    Lr = selifr(Lr, okr)
    matrix tob = selifr(d.tobs, okr)
    scalar K = cols(Lr)
    scalar n = rows(y)
    strings lab = d.labels
    bundle b
    if pm == "beta"
        matrix th = mols(y, X) | 0.1 | 0 | log(5)
        set max_verbose off
        scalar v = BFGSmax(&th, "ev__midssr(th, y, X, Lr)")
        matrix H = numhess(th, "ev__midssr(th, y, X, Lr)")
        scalar ssr = -v
        matrix V = -inv(H) * 2 * ssr / (n - rows(th))     # NLS covariance from the Hessian of -SSR
        b.coeff = th
        b.vcv = V
        lab += "SLOPE"
        lab += "LOG THETA1"
        lab += "LOG THETA2"
        b.ssr = ssr
    else
        matrix W = {}
        if pm == "umidas"
            W = I(K)
            loop j = 1..K
                lab += sprintf("HF LAG %d", j - 1)
            endloop
        elif pm == "step"
            scalar ns = ceil(K / deg)
            W = zeros(K, ns)
            loop j = 1..K
                W[j, ceil(j / deg)] = 1
            endloop
            loop j = 1..ns
                lab += sprintf("STEP %d", j)
            endloop
        else
            # Almon / PDL: weights are a polynomial of degree deg in the lag
            W = zeros(K, deg + 1)
            loop j = 1..K
                loop p = 0..deg
                    W[j, p + 1] = (j - 1)^p
                endloop
            endloop
            loop p = 0..deg
                lab += sprintf("PDL%02d", p + 1)
            endloop
        endif
        matrix Z = X ~ Lr * W
        bundle a = ev__olsr(y, Z)
        b.coeff = a.coeff
        b.vcv = (a.ssr / (n - cols(Z))) * inv(Z'Z)
        b.ssr = a.ssr
        b.lagweights = W * a.coeff[cols(X) + 1:]
    endif
    b.kind = "midas"
    b.method = sprintf("MIDAS (%s weighting, %d high-frequency lags)", pm, K)
    b.depvar = d.depvar
    b.labels = lab
    b.T = n
    b.tobs = tob
    ev__finish(&b, 0)
    if !quiet
        ev_coefprint(&b)
        printf "Sum squared resid %.6f\n", b.ssr
    endif
    return b
end function

# --- generalized linear models (IRLS)

function bundle ev_glm (string spec "Equation, e.g. y c x", list vars "Series used (e.g. dataset)",
                        string family[null] "normal, poisson, binomial or gamma", string link[null] "identity, log, logit, probit or inverse",
                        bool quiet[0])
    string fam = exists(family) ? tolower(family) : "normal"
    string lk = exists(link) ? tolower(link) : (fam == "poisson" ? "log" : (fam == "binomial" ? "logit" : (fam == "gamma" ? "inverse" : "identity")))
    errorif(!instring(" normal poisson binomial gamma ", " " ~ fam ~ " "), "family must be normal, poisson, binomial or gamma")
    errorif(!instring(" identity log logit probit inverse ", " " ~ lk ~ " "), "link must be identity, log, logit, probit or inverse")
    bundle d = ev__xspec(spec, vars, "evgl")
    matrix y = d.y
    matrix X = d.X
    scalar n = rows(y)
    matrix mu = fam == "binomial" ? (y + 0.5) / 2 : (fam == "normal" ? y : y + 0.1)
    matrix eta = lk == "identity" ? mu : (lk == "log" ? log(mu) : (lk == "logit" ? log(mu ./ (1 - mu)) : (lk == "probit" ? invcdf(z, mu) : 1 ./ mu)))
    matrix b = {}
    loop it = 1..100
        # d mu / d eta
        matrix dm = lk == "identity" ? ones(n, 1) : (lk == "log" ? exp(eta) : (lk == "logit" ? exp(eta) ./ (1 + exp(eta)).^2 : (lk == "probit" ? dnorm(eta) : -1 ./ eta.^2)))
        matrix vr = fam == "normal" ? ones(n, 1) : (fam == "poisson" ? mu : (fam == "binomial" ? mu .* (1 - mu) : mu.^2))
        matrix z = eta + (y - mu) ./ dm
        matrix w = dm.^2 ./ vr
        matrix bn = mols(z .* sqrt(w), X .* sqrt(w))
        eta = X * bn
        mu = lk == "identity" ? eta : (lk == "log" ? exp(eta) : (lk == "logit" ? 1 ./ (1 + exp(-eta)) : (lk == "probit" ? cnorm(eta) : 1 ./ eta)))
        scalar conv = rows(b) ? maxc(abs(bn - b) ./ (1 + abs(b))) : 1
        b = bn
        if conv < 1e-11
            break
        endif
    endloop
    matrix dm = lk == "identity" ? ones(n, 1) : (lk == "log" ? exp(eta) : (lk == "logit" ? exp(eta) ./ (1 + exp(eta)).^2 : (lk == "probit" ? dnorm(eta) : -1 ./ eta.^2)))
    matrix vr = fam == "normal" ? ones(n, 1) : (fam == "poisson" ? mu : (fam == "binomial" ? mu .* (1 - mu) : mu.^2))
    matrix w = dm.^2 ./ vr
    scalar k = cols(X)
    scalar pearson = sumc((y - mu).^2 ./ vr)
    scalar disp = fam == "poisson" || fam == "binomial" ? 1 : pearson / (n - k)
    bundle r
    r.kind = "glm"
    r.method = sprintf("Generalized Linear Model (IRLS), family %s, link %s", fam, lk)
    r.depvar = d.depvar
    r.spec = spec
    r.labels = d.labels
    r.coeff = b
    r.vcv = disp * inv(X' * (X .* w))
    r.T = n
    r.tobs = d.tobs
    r.y = y
    r.yhat = mu
    r.uhat = y - mu
    r.dispersion = disp
    r.pearson = pearson
    ev__finish(&r, fam != "normal")
    if !quiet
        ev_coefprint(&r)
        printf "Dispersion: %.6f   Pearson SSR: %.6f\n", disp, pearson
    endif
    return r
end function

# --- elastic net / lasso / ridge (gretl regls package)

function bundle ev_enet (string spec "Equation, e.g. y c x1 x2 x3", list vars "Series used (e.g. dataset)",
                         scalar alpha[0:1:1] "1 = lasso, 0 = ridge, in between = elastic net",
                         scalar lfrac[NA] "Penalty as a fraction of lambda-max (NA: cross-validation)",
                         bool quiet[0])
    include regls.gfn
    strings tok = strsplit(spec)
    series evn_y = ev_gen(tok[1], vars)
    list X = null
    strings lab = array(0)
    loop i = 2..nelem(tok)
        if tolower(tok[i]) != "c"           # regls always includes an intercept
            string v = sprintf("evn_x%d", i)
            series @v = ev_gen(tok[i], vars)
            list X += @v
            lab += toupper(tok[i])
        endif
    endloop
    bundle p = _(verbosity = 0, stdize = 1)
    if alpha == 0
        p.ridge = 1
    elif alpha < 1
        p.alpha = alpha
    endif
    if ok(lfrac)
        p.lfrac = lfrac
    else
        p.xvalidate = 1
        p.nlambda = 25
        p.nfolds = 10
    endif
    bundle rb = regls(evn_y, X, p)
    bundle b
    b.kind = "enet"
    b.method = alpha == 1 ? "Lasso" : (alpha == 0 ? "Ridge" : sprintf("Elastic Net (alpha = %g)", alpha))
    b.depvar = toupper(tok[1])
    # single penalty: B is the coefficient vector; cross-validation: b holds the optimal column
    matrix B = inbundle(rb, "b") ? rb.b : rb.B
    if cols(B) > 1
        B = B[, inbundle(rb, "idxmin") ? rb.idxmin : 1]
    endif
    b.coeff = B
    strings lb = defarray("C")
    loop i = 1..nelem(lab)
        lb += lab[i]
    endloop
    b.labels = lb
    b.lfrac = inbundle(rb, "lfmin") ? rb.lfmin : (ok(lfrac) ? lfrac : NA)
    if !quiet
        printf "\nDependent Variable: %s\nMethod: %s\nPenalty (fraction of lambda-max): %g%s\n\n", b.depvar, b.method, b.lfrac, \
          ok(lfrac) ? "" : " (chosen by 10-fold cross-validation)"
        ev__line(48)
        printf "%-26s%16s\n", "Variable", "Coefficient"
        ev__line(48)
        loop i = 1..rows(b.coeff)
            printf "%-26s%16.6f\n", b.labels[i], b.coeff[i]
        endloop
        ev__line(48)
    endif
    return b
end function

# --- panel instrumental variables (fixed effects / G2SLS) and two-way random effects

function bundle ev_paneliv (string spec "Equation @ instruments, e.g. y c x @ c z", list vars "Series used (e.g. dataset)",
                            string cx[null] "fixed (default) or random", bool quiet[0])
    errorif($datatype != 3, "Panel IV needs a panel page")
    include ivpanel.gfn
    string ce = exists(cx) ? tolower(cx) : "fixed"
    strings parts = strsplit(spec, "@")
    strings t1 = strsplit(strstrip(parts[1]))
    strings t2 = strsplit(strstrip(parts[2]))
    series evp_y = ev_gen(t1[1], vars)
    list X = null
    list Z = null
    strings lab = array(0)
    loop i = 2..nelem(t1)
        if tolower(t1[i]) == "c"
            list X += const
            lab += "C"
        else
            string v = sprintf("evp_x%d", i)
            series @v = ev_gen(t1[i], vars)
            list X += @v
            lab += toupper(t1[i])
        endif
    endloop
    loop i = 1..nelem(t2)
        if tolower(t2[i]) == "c"
            list Z += const
        else
            string v = sprintf("evp_z%d", i)
            series @v = ev_gen(t2[i], vars)
            list Z += @v
        endif
    endloop
    bundle ib = ivpanel(evp_y, X, Z, ce == "random" ? 3 : 1, 1)
    bundle b
    b.kind = "paneliv"
    b.method = ce == "random" ? "Panel Two-Stage EGLS (Cross-section random effects, G2SLS)" : "Panel Two-Stage Least Squares (Cross-section fixed effects)"
    b.depvar = toupper(t1[1])
    b.coeff = ib.coeff
    b.vcv = ib.vcv
    b.stderr = sqrt(diag(ib.vcv))
    # ivpanel drops the constant under fixed effects: keep matching labels
    if rows(b.coeff) < nelem(lab)
        strings l2 = array(0)
        loop i = 1..nelem(lab)
            if lab[i] != "C"
                l2 += lab[i]
            endif
        endloop
        lab = l2
    endif
    b.labels = lab
    b.k = rows(b.coeff)
    b.T = ib.nobs
    b.tstat = b.coeff ./ b.stderr
    b.pval = 2 * cnorm(-abs(b.tstat))
    if !quiet
        ev_coefprint(&b)
    endif
    return b
end function

function bundle ev_panelre2 (string spec "Equation, e.g. y c x", list vars "Series used (e.g. dataset)",
                             bool period[1] "Two-way (1) or cross-section only (0)", bool quiet[0])
    # Swamy-Arora random effects for a balanced panel: cross-section (and period) components
    errorif($datatype != 3, "Random effects need a panel page")
    bundle d = ev__xspec(spec, vars, "evre")
    # units in the estimation rows (lags drop the first periods of every unit)
    set skip_missing off
    series evr_u = $unit
    matrix um = {evr_u}
    scalar o1 = $t1
    matrix ur = zeros(rows(d.tobs), 1)
    loop i = 1..rows(d.tobs)
        ur[i] = um[d.tobs[i] - o1 + 1]
    endloop
    matrix uv = values(ur)
    scalar N = rows(uv)
    scalar n = rows(d.y)
    scalar Tp = n / N
    loop i = 1..N
        errorif(sumc(ur .= uv[i]) != Tp, "Random effects here need a balanced panel")
    endloop
    matrix y = d.y
    matrix X = d.X
    # columns of X without the constant
    matrix vx = sdc(X)' .> 0
    matrix Xs = selifc(X, vx')
    scalar k = cols(Xs)
    # unit, period and overall mean operators (data stacked by unit)
    matrix Pu = (I(N) ** ones(Tp, Tp)) / Tp    # unit means
    matrix Pt = (ones(N, N) ** I(Tp)) / N      # period means
    matrix Pa = ones(n, n) / n
    matrix Qw = period ? I(n) - Pu - Pt + Pa : I(n) - Pu
    # within residuals -> sigma_e^2
    matrix yw = Qw * y
    matrix Xw = Qw * Xs
    matrix ew = yw - Xw * mols(yw, Xw)
    scalar s2e = (ew'ew) / (period ? (N - 1) * (Tp - 1) - k : n - N - k)
    # between-unit regression -> sigma_1^2 = Tp s2u + s2e
    matrix Bu = (I(N) ** ones(1, Tp)) / Tp
    matrix yb = Bu * y
    matrix Xb = Bu * X
    matrix eb = yb - Xb * mols(yb, Xb)
    scalar s21 = Tp * (eb'eb) / (N - cols(X))
    scalar s2u = max(0, (s21 - s2e) / Tp)
    scalar s2l = 0
    scalar s22 = s2e
    if period
        matrix Bt = (ones(1, N) ** I(Tp)) / N
        matrix ytb = Bt * y
        matrix Xtb = Bt * X
        matrix et = ytb - Xtb * mols(ytb, Xtb)
        s22 = N * (et'et) / (Tp - cols(X))
        s2l = max(0, (s22 - s2e) / N)
    endif
    # GLS transformation: Omega^(-1/2) sigma_e
    scalar a1 = sqrt(s2e / (s2e + Tp * s2u))
    scalar a2 = sqrt(s2e / (s2e + N * s2l))
    scalar a3 = sqrt(s2e / (s2e + Tp * s2u + N * s2l))
    matrix Om = I(n) - (1 - a1) * Pu - (period ? (1 - a2) * Pt : 0) + (period ? (1 - a1 - a2 + a3) * Pa : 0)
    matrix ys = Om * y
    matrix Xg = Om * X
    matrix eg = {}
    matrix bg = mols(ys, Xg, &eg)
    bundle b
    b.kind = "panelre2"
    b.method = period ? "Panel EGLS (Two-way random effects, Swamy-Arora)" : "Panel EGLS (Cross-section random effects, Swamy-Arora)"
    b.depvar = d.depvar
    b.labels = d.labels
    b.coeff = bg
    b.vcv = (eg'eg / (n - cols(X))) * inv(Xg'Xg)
    b.T = n
    b.tobs = d.tobs
    b.sigma_u = sqrt(s2u)
    b.sigma_l = sqrt(s2l)
    b.sigma_e = sqrt(s2e)
    ev__finish(&b, 0)
    if !quiet
        ev_coefprint(&b)
        printf "Effects Specification\n%-26s%14s%10s\n", "", "S.D.", "Rho"
        scalar tot = s2u + s2l + s2e
        printf "%-26s%14.6f%10.4f\n", "Cross-section random", sqrt(s2u), s2u / tot
        if period
            printf "%-26s%14.6f%10.4f\n", "Period random", sqrt(s2l), s2l / tot
        endif
        printf "%-26s%14.6f%10.4f\n", "Idiosyncratic random", sqrt(s2e), s2e / tot
    endif
    return b
end function

# -------------------------------------------------------------------
# Phase 3 views and tests
# -------------------------------------------------------------------

function matrix ev_influence (bundle b "ev_ls result", bool quiet[0])
    # RStudent, DFFITS, COVRATIO, hat values and DFBETAS (EViews Influence Statistics)
    errorif(!inbundle(b, "X"), "Influence statistics need a least squares equation (ev_ls)")
    matrix X = b.X
    matrix e = b.uhat
    scalar n = rows(X)
    scalar k = cols(X)
    matrix XXi = inv(X'X)
    matrix h = sumr((X * XXi) .* X)
    scalar s2 = e'e / (n - k)
    matrix s2i = ((n - k) * s2 - e.^2 ./ (1 - h)) / (n - k - 1)     # variance without observation i
    matrix rst = e ./ sqrt(s2i .* (1 - h))
    matrix dff = rst .* sqrt(h ./ (1 - h))
    matrix cvr = (s2i / s2).^k ./ (1 - h)
    matrix DB = zeros(n, k)
    matrix C = X * XXi
    loop i = 1..n
        DB[i,] = C[i,] * e[i] / (1 - h[i]) ./ sqrt(s2i[i] * diag(XXi)')
    endloop
    matrix R = rst ~ dff ~ cvr ~ h ~ DB
    strings cn = defarray("RStudent", "DFFITS", "COVRATIO", "Hat Matrix")
    loop j = 1..k
        cn += "DFBETAS " ~ b.labels[j]
    endloop
    cnameset(R, cn)
    if !quiet
        printf "\nInfluence Statistics\nEquation: %s\n\n", b.spec
        printf "%-10s%12s%12s%12s%12s\n", "obs", "RStudent", "DFFITS", "COVRATIO", "Hat"
        loop i = 1..n
            printf "%-10s%12.6f%12.6f%12.6f%12.6f\n", obslabel(b.tobs[i]), rst[i], dff[i], cvr[i], h[i]
        endloop
    endif
    return R
end function

function matrix ev_ellipse (bundle b "Estimated equation", int i[1::1], int j[1::2], scalar level[0.95],
                            string out[null] "Graph file (default: display; none: no graph)")
    # boundary of the joint confidence region of coefficients i and j (F-based, as EViews)
    matrix c = b.coeff[i] | b.coeff[j]
    matrix V = b.vcv[{i, j}, {i, j}]
    scalar df2 = inbundle(b, "T") ? b.T - b.k : 1e6
    scalar r2 = 2 * critical(F, 2, df2, 1 - level)
    matrix L = cholesky(V)
    matrix ang = seq(0, 200)' * 2 * $pi / 200
    matrix P = (L * (cos(ang) ~ sin(ang))' * sqrt(r2))' .+ c'
    cnameset(P, defarray(b.labels[i], b.labels[j]))
    string o = exists(out) ? out : "display"
    if o != "none"
        gnuplot 2 1 --matrix=P --with-lines --output="@o"
    endif
    return P
end function

function void ev_covprint (bundle b "Estimated equation")
    # EViews View > Covariance Matrix
    printf "\nCoefficient Covariance Matrix\n%14s", ""
    strings lb = inbundle(b, "labels") ? b.labels : b.clabels
    loop j = 1..b.k
        printf "%14s", lb[j]
    endloop
    printf "\n"
    loop i = 1..b.k
        printf "%-14s", lb[i]
        loop j = 1..b.k
            printf "%14.6g", b.vcv[i, j]
        endloop
        printf "\n"
    endloop
end function

function matrix ev_gradients (bundle b "ev_ls result", bool quiet[0])
    # gradients of the sum of squares at the estimates (-2 X'e): zero at an interior optimum
    errorif(!inbundle(b, "X"), "Gradients need a least squares equation (ev_ls)")
    matrix g = -2 * b.X' * b.uhat
    if !quiet
        printf "\nGradients of the objective function at the estimates\n"
        loop i = 1..rows(g)
            printf "%-26s%16.6g\n", b.labels[i], g[i]
        endloop
    endif
    return g
end function

# --- Breitung panel unit root test

function bundle ev_breitung (series x "Series of a balanced panel page", int lag[0::0] "Prewhitening lags",
                             bool quiet[0])
    errorif($datatype != 3, "The Breitung test needs a panel page")
    set skip_missing off
    matrix M = ev_unstack(x)
    scalar N = cols(M)
    matrix dys = {}
    matrix yls = {}
    loop i = 1..N
        matrix y = M[, i]
        y = selifr(y, ok(y))
        scalar T = rows(y)
        matrix dy = y[2:T] - y[1:T-1]
        matrix yl = y[1:T-1]
        # prewhitening: remove the lagged differences, scale by the residual s.d.
        scalar s = sdc(dy)
        if lag > 0
            matrix Z = {}
            loop j = 1..lag
                Z ~= mlag(dy, j, NA)
            endloop
            matrix ok1 = sumr(!ok(Z)) .= 0
            matrix d1 = selifr(dy, ok1)
            matrix l1 = selifr(yl, ok1)
            matrix Zs = selifr(Z, ok1)
            matrix e1 = d1 - Zs * mols(d1, Zs)
            matrix e2 = l1 - Zs * mols(l1, Zs)
            s = sdc(d1 - (l1 ~ Zs) * mols(d1, l1 ~ Zs))
            dy = e1
            yl = e2
        endif
        dy = dy / s
        yl = yl / s
        scalar Tn = rows(dy)
        # forward orthogonal deviations of the differences; levels relative to the first value
        matrix dst = zeros(Tn - 1, 1)
        matrix lst = zeros(Tn - 1, 1)
        loop t = 1..Tn - 1
            scalar m = meanc(dy[t + 1:Tn])
            scalar st = sqrt((Tn - t) / (Tn - t + 1))
            dst[t] = st * (dy[t] - m)
            lst[t] = yl[t] - yl[1]          # levels relative to the initial value
        endloop
        dys |= dst
        yls |= lst
    endloop
    scalar rho = (yls'dys) / (yls'yls)
    matrix e = dys - rho * yls
    scalar se = sqrt((e'e / rows(e)) / (yls'yls))
    bundle r
    r.stat = rho / se
    r.p = cnorm(r.stat)
    if !quiet
        printf "\nBreitung Panel Unit Root Test\nNull Hypothesis: Unit root (common unit root process)\nCross-sections: %d\n\n", N
        printf "%-30s%14s%10s\n", "Method", "Statistic", "Prob.**"
        printf "%-30s%14.6f%10.4f\n", "Breitung t-stat", r.stat, r.p
        printf "** Probability from the standard normal distribution (left tail)\n"
    endif
    return r
end function

# --- ETS exponential smoothing (state space, additive errors, ML / AIC selection)

function matrix ev__etsrun (const matrix th, const matrix y, string mdl, scalar s)
    # mdl: ANN, AAN, AAdN, ANA, AAA; th = [alpha, beta, gamma, phi, l0, b0, s0 (s-1)] on logit scales where bounded
    scalar T = rows(y)
    scalar a = 1 / (1 + exp(-th[1]))
    scalar bt = 1 / (1 + exp(-th[2])) * a
    scalar g = 1 / (1 + exp(-th[3])) * (1 - a)
    scalar ph = 0.8 + 0.18 / (1 + exp(-th[4]))
    scalar trend = instring(mdl, "AA")
    scalar damped = mdl == "AAdN"
    scalar seas = substr(mdl, strlen(mdl), strlen(mdl)) == "A" && mdl != "AAN"
    scalar l = th[5]
    scalar b = trend ? th[6] : 0
    matrix S = zeros(s, 1)
    if seas
        S[1:s-1] = th[7:5 + s]
        S[s] = -sumc(S[1:s-1])
    endif
    matrix F = zeros(T, 1)
    loop t = 1..T
        scalar k = (t - 1) % s + 1
        scalar phb = damped ? ph * b : b
        scalar f = l + (trend ? phb : 0) + (seas ? S[k] : 0)
        F[t] = f
        scalar e = y[t] - f
        scalar lold = l
        l = l + (trend ? phb : 0) + a * e
        if trend
            b = phb + bt * e
        endif
        if seas
            S[k] = S[k] + g * e
        endif
    endloop
    return F
end function

function scalar ev__etsll (const matrix th, const matrix y, string mdl, scalar s)
    matrix F = ev__etsrun(th, y, mdl, s)
    scalar T = rows(y)
    scalar sse = sumc((y - F).^2)
    scalar r = -T / 2 * (1 + log(2 * $pi) + log(sse / T))
    return ok(r) ? r : -1e100
end function

function bundle ev_ets (series x "Series", string model[null] "ANN, AAN, AAdN, ANA, AAA or auto (AIC)",
                        bool quiet[0])
    set skip_missing off
    matrix y = {x}
    errorif(sumc(!ok(y)) > 0, "The series has missing values in the sample")
    scalar s = $pd
    string req = exists(model) ? toupper(model) : "AUTO"
    strings cand = defarray(req)
    if req == "AUTO"
        cand = s > 1 ? defarray("ANN", "AAN", "AAdN", "ANA", "AAA") : defarray("ANN", "AAN", "AAdN")
    endif
    scalar best = 1e300
    bundle r
    loop i = 1..nelem(cand)
        string mdl = cand[i]
        matrix th = {0; -1; -1; 0; y[1]; (y[min(rows(y), s + 1)] - y[1]) / s}
        if s > 1
            th |= zeros(s - 1, 1)
        else
            th |= 0
        endif
        set max_verbose off
        catch scalar ll = BFGSmax(&th, "ev__etsll(th, y, mdl, s)")
        if $error
            ll = ev__etsll(th, y, mdl, s)
        endif
        # parameters: smoothing (alpha, beta, gamma, phi) + initial states
        scalar np = 1 + instring(mdl, "AA") + (mdl == "AAdN") + (mdl == "ANA" || mdl == "AAA") + 1 + instring(mdl, "AA") + ((mdl == "ANA" || mdl == "AAA") ? s - 1 : 0)
        scalar aic = -2 * ll + 2 * (np + 1)
        if aic < best
            best = aic
            matrix F = ev__etsrun(th, y, mdl, s)
            r.model = mdl
            r.lnl = ll
            r.aic = aic
            r.alpha = 1 / (1 + exp(-th[1]))
            r.beta = 1 / (1 + exp(-th[2])) * r.alpha
            r.gamma = 1 / (1 + exp(-th[3])) * (1 - r.alpha)
            r.phi = 0.8 + 0.18 / (1 + exp(-th[4]))
            r.fitted = F
            r.sse = sumc((y - F).^2)
        endif
        if !quiet
            printf "ETS(%s): log likelihood %.4f, AIC %.4f\n", mdl, ll, aic
        endif
    endloop
    if !quiet
        printf "\nSelected model: ETS(%s)   alpha %.4f%s%s%s\n", r.model, r.alpha, \
          instring(r.model, "AA") ? sprintf("   beta %.4f", r.beta) : "", r.model == "AAdN" ? sprintf("   phi %.4f", r.phi) : "", \
          (r.model == "ANA" || r.model == "AAA") ? sprintf("   gamma %.4f", r.gamma) : ""
        printf "Sum squared one-step errors %.6f\n", r.sse
    endif
    return r
end function

# --- equality tests across the series of a group; variance ratio; BDS; spectrum; cross-correlations

function bundle ev_testequal (string names "Series, e.g. x1 x2 x3", list vars "Series used (e.g. dataset)", bool quiet[0])
    # equality of means (ANOVA F), medians (Kruskal-Wallis) and variances (Bartlett, Levene) across series
    strings tok = strsplit(names)
    scalar g = nelem(tok)
    matrix V = {}
    matrix G = {}
    set skip_missing off
    loop i = 1..g
        series evq_x = ev_gen(tok[i], vars)
        matrix v = {evq_x}
        v = selifr(v, ok(v))
        V |= v
        G |= i * ones(rows(v), 1)
    endloop
    scalar n = rows(V)
    scalar gm = meanc(V)
    scalar ssb = 0
    scalar ssw = 0
    scalar sp = 0
    scalar bart = 0
    matrix ni = zeros(g, 1)
    matrix vi = zeros(g, 1)
    loop i = 1..g
        matrix v = selifr(V, G .= i)
        ni[i] = rows(v)
        vi[i] = sdc(v)^2 * ni[i] / (ni[i] - 1)
        ssb += ni[i] * (meanc(v) - gm)^2
        ssw += sumc((v - meanc(v)).^2)
    endloop
    bundle r
    r.F = (ssb / (g - 1)) / (ssw / (n - g))
    r.Fp = pvalue(F, g - 1, n - g, r.F)
    # Kruskal-Wallis on ranks
    matrix rk = ranking(V)
    scalar H = 0
    loop i = 1..g
        H += sumc(selifr(rk, G .= i))^2 / ni[i]
    endloop
    r.KW = 12 / (n * (n + 1)) * H - 3 * (n + 1)
    r.KWp = pvalue(c, g - 1, r.KW)
    # Bartlett
    scalar s2p = sumc((ni - 1) .* vi) / (n - g)
    scalar num = (n - g) * log(s2p) - sumc((ni - 1) .* log(vi))
    scalar den = 1 + (sumc(1 ./ (ni - 1)) - 1 / (n - g)) / (3 * (g - 1))
    r.bartlett = num / den
    r.bartlettp = pvalue(c, g - 1, r.bartlett)
    # Levene (absolute deviations from the group means)
    matrix z = zeros(n, 1)
    loop t = 1..n
        scalar gi = G[t]
        z[t] = abs(V[t] - meanc(selifr(V, G .= gi)))
    endloop
    scalar zm = meanc(z)
    scalar zb = 0
    scalar zw = 0
    loop i = 1..g
        matrix zi = selifr(z, G .= i)
        zb += ni[i] * (meanc(zi) - zm)^2
        zw += sumc((zi - meanc(zi)).^2)
    endloop
    r.levene = (zb / (g - 1)) / (zw / (n - g))
    r.levenep = pvalue(F, g - 1, n - g, r.levene)
    if !quiet
        printf "\nTest for Equality of Means, Medians and Variances Between Series\nIncluded observations: %d\n\n", n
        printf "%-28s%8s%14s%10s\n", "Method", "df", "Value", "Prob."
        printf "%-28s%8s%14.6f%10.4f\n", "Anova F-test (means)", sprintf("(%d, %d)", g - 1, n - g), r.F, r.Fp
        printf "%-28s%8d%14.6f%10.4f\n", "Kruskal-Wallis (medians)", g - 1, r.KW, r.KWp
        printf "%-28s%8d%14.6f%10.4f\n", "Bartlett (variances)", g - 1, r.bartlett, r.bartlettp
        printf "%-28s%8s%14.6f%10.4f\n", "Levene (variances)", sprintf("(%d, %d)", g - 1, n - g), r.levene, r.levenep
    endif
    return r
end function

function matrix ev_vratio (series x "Series (levels, e.g. log prices)", string periods[null] "Periods, e.g. 2 4 8 16",
                           bool quiet[0])
    # Lo-MacKinlay variance ratio test of a random walk: homoskedastic and heteroskedasticity-robust z
    set skip_missing off
    matrix p = {x}
    p = selifr(p, ok(p))
    matrix r = p[2:] - p[1:rows(p)-1]
    scalar n = rows(r)
    scalar mu = meanc(r)
    scalar s1 = sumc((r - mu).^2) / (n - 1)
    strings pt = strsplit(exists(periods) ? periods : "2 4 8 16")
    matrix R = {}
    loop i = 1..nelem(pt)
        scalar q = atof(pt[i])
        matrix rq = p[q + 1:] - p[1:rows(p) - q]
        scalar m = q * (n - q + 1) * (1 - q / n)
        scalar sq = sumc((rq - q * mu).^2) / m
        scalar vr = sq / s1
        scalar zh = (vr - 1) / sqrt(2 * (2 * q - 1) * (q - 1) / (3 * q * n))
        scalar th = 0
        matrix d = (r - mu).^2
        loop j = 1..q - 1
            scalar dl = (d[j+1:n]'d[1:n-j]) / (d'd)^2 * n
            th += (2 * (q - j) / q)^2 * dl
        endloop
        scalar zr = (vr - 1) / sqrt(th)
        R |= {q, vr, zh, 2 * cnorm(-abs(zh)), zr, 2 * cnorm(-abs(zr))}
    endloop
    cnameset(R, defarray("Period", "Var. Ratio", "z (homosk.)", "Prob.", "z (heterosk.)", "Prob."))
    if !quiet
        printf "\nVariance Ratio Test (Lo-MacKinlay)\nNull Hypothesis: the series is a random walk\nObservations: %d\n\n", n + 1
        printf "%8s%12s%14s%10s%16s%10s\n", "Period", "Var. Ratio", "z (homosk.)", "Prob.", "z (heterosk.)", "Prob."
        loop i = 1..rows(R)
            printf "%8d%12.6f%14.6f%10.4f%16.6f%10.4f\n", R[i, 1], R[i, 2], R[i, 3], R[i, 4], R[i, 5], R[i, 6]
        endloop
    endif
    return R
end function

function matrix ev_xcorr (series x, series y, int k[1::12] "Lags and leads", bool quiet[0])
    # correlations of x(t) with y(t-j), j = -k..k (EViews cross correlogram: lag and lead columns)
    set skip_missing off
    matrix D = {x} ~ {y}
    D = selifr(D, sumr(!ok(D)) .= 0)
    scalar n = rows(D)
    matrix a = D[, 1] - meanc(D[, 1])
    matrix b = D[, 2] - meanc(D[, 2])
    scalar den = sqrt((a'a) * (b'b))
    matrix R = zeros(k + 1, 3)
    loop j = 0..k
        R[j + 1, 1] = j
        R[j + 1, 2] = (a[j+1:n]'b[1:n-j]) / den     # x(t), y(t-j): lag
        R[j + 1, 3] = (b[j+1:n]'a[1:n-j]) / den     # x(t), y(t+j): lead
    endloop
    cnameset(R, defarray("i", "lag", "lead"))
    if !quiet
        printf "\nCross Correlogram\nIncluded observations: %d\nCorrelations are asymptotically consistent approximations\n\n", n
        printf "%6s%14s%14s\n", "i", "x,y(-i) lag", "x,y(+i) lead"
        loop j = 1..k + 1
            printf "%6d%14.4f%14.4f\n", R[j, 1], R[j, 2], R[j, 3]
        endloop
    endif
    return R
end function

function matrix ev_spectrum (series x, int window[0::0] "Bartlett window size (0: raw periodogram)",
                             string out[null] "Graph file (default: display; none: no graph)")
    matrix P = {}
    if window > 0
        P = pergm(x, window)
    else
        P = pergm(x)
    endif
    cnameset(P, defarray("Frequency", "Spectral density"))
    string o = exists(out) ? out : "display"
    if o != "none"
        gnuplot 2 1 --matrix=P --with-lines --output="@o"
    endif
    return P
end function

# --- VAR historical decomposition

function bundle ev_varhist (bundle v "ev_varest result", bool quiet[0])
    # contribution of each Cholesky shock to each variable; the rest is the base projection
    matrix U = v.sys.uhat
    scalar T = rows(U)
    scalar n = cols(U)
    matrix P = cholesky(v.sys.sigma)
    matrix E = U * inv(P')                     # structural shocks
    matrix A = v.sys.A
    scalar np = rows(A)
    matrix J = I(n) ~ zeros(n, np - n)
    matrices Th = array(T)
    matrix Ap = I(np)
    loop h = 1..T
        Th[h] = J * Ap * J' * P
        Ap = Ap * A
    endloop
    matrix C = zeros(T, n * n)                 # column (s-1)*n + i: shock s on variable i
    loop t = 1..T
        loop jj = 1..t
            matrix th = Th[t - jj + 1]
            C[t,] = C[t,] + vec(th .* E[jj,])'
        endloop
    endloop
    matrix Y = v.sys.Y
    matrix base = Y
    loop i = 1..n
        loop s = 1..n
            base[, i] = base[, i] - C[, (s - 1) * n + i]
        endloop
    endloop
    bundle r
    r.contrib = C
    r.base = base
    r.actual = Y
    r.tobs = seq(v.sys.t1, v.sys.t2)'
    if !quiet
        printf "\nHistorical decomposition (Cholesky shocks), %s\n", v.sample
        printf "Last observation, contributions of each shock:\n%-16s%14s", "Variable", "Base"
        loop s = 1..n
            printf "%14s", "Shock " ~ v.ylab[s]
        endloop
        printf "\n"
        loop i = 1..n
            printf "%-16s%14.6f", v.ylab[i], base[T, i]
            loop s = 1..n
                printf "%14.6f", C[T, (s - 1) * n + i]
            endloop
            printf "\n"
        endloop
    endif
    return r
end function

# --- system residual tests and model fit tables

function bundle ev_sysrestests (bundle s "ev_system result", bool quiet[0])
    # residual correlation matrix and Cholesky-orthogonalised normality test (as VAR)
    matrix U = s.uhat
    matrix C = mcorr(U)
    bundle v = _(sys = _(uhat = U))
    bundle nm = ev_varnorm(v, 1)
    bundle r
    r.corr = C
    r.jb = nm.jb_joint
    r.jbp = nm.jb_p
    if !quiet
        printf "\nSystem Residual Correlation Matrix\n"
        print C
        printf "System Residual Normality Test (Cholesky): Jarque-Bera %.6f (df %d), Prob. %.4f\n", r.jb, 2 * cols(U), r.jbp
    endif
    return r
end function

function matrix ev_modelfit (bundle ms "ev_modelsolve result", bool quiet[0])
    # RMSE, MAE, MAPE and Theil U of the solution against the actual values
    matrix S = ms.sol
    matrix A = ms.actual
    scalar m = cols(S)
    matrix R = zeros(m, 4)
    loop k = 1..m
        matrix ok1 = ok(S[, k]) .* ok(A[, k])
        matrix s = selifr(S[, k], ok1)
        matrix a = selifr(A[, k], ok1)
        matrix e = a - s
        R[k, 1] = sqrt(meanc(e.^2))
        R[k, 2] = meanc(abs(e))
        R[k, 3] = 100 * meanc(abs(e ./ a))
        R[k, 4] = sqrt(meanc(e.^2)) / (sqrt(meanc(a.^2)) + sqrt(meanc(s.^2)))
    endloop
    cnameset(R, defarray("RMSE", "MAE", "MAPE", "Theil U"))
    if !quiet
        printf "\nModel solution fit (%s)\n%-16s%14s%14s%14s%14s\n", ms.sample, "Variable", "RMSE", "MAE", "MAPE", "Theil U"
        loop k = 1..m
            printf "%-16s%14.6f%14.6f%14.4f%14.6f\n", ms.names[k], R[k, 1], R[k, 2], R[k, 3], R[k, 4]
        endloop
    endif
    return R
end function

# -------------------------------------------------------------------
# Panel least squares on a panel page: ls(cx=f|r, per=f)
# -------------------------------------------------------------------

function bundle ev_panel (string spec "Equation, e.g. y c x",
                          list vars "Series used (e.g. dataset)",
                          string cx[null] "Cross-section effects: none, fixed or random",
                          bool perfe[0] "Period fixed effects",
                          bool quiet[0])
    errorif($datatype != 3, "The current page is not a panel (use pagestruct first)")
    string ce = exists(cx) && cx != "" ? tolower(cx) : "none"
    ce = ce == "f" ? "fixed" : (ce == "r" ? "random" : ce)
    errorif(!instring(" none fixed random ", " " ~ ce ~ " "), "cx must be none, fixed or random")
    strings tok = strsplit(spec)
    series evp_y = ev_gen(tok[1], vars)
    list X = null
    strings xlab = array(0)
    loop i = 2..nelem(tok)
        if tolower(tok[i]) == "c"
            list X += const
            xlab += "C"
        else
            string v = sprintf("evp_x%d", i)
            series @v = ev_gen(tok[i], vars)
            list X += @v
            xlab += toupper(tok[i])
        endif
    endloop
    errorif(ce != "none" && !inlist(X, "const"), "fixed and random effects need a constant (c)")
    if ce == "fixed"
        if perfe
            panel evp_y X --fixed-effects --time-dummies --quiet
        else
            panel evp_y X --fixed-effects --quiet
        endif
    elif ce == "random"
        if perfe
            panel evp_y X --random-effects --time-dummies --quiet
        else
            panel evp_y X --random-effects --quiet
        endif
    else
        if perfe
            panel evp_y X --pooled --time-dummies --quiet
        else
            panel evp_y X --pooled --quiet
        endif
    endif
    scalar k = nelem(X)
    bundle b
    b.kind = "panel"
    b.spec = spec
    b.depvar = toupper(tok[1])
    b.effects = ce
    b.perfe = perfe
    b.method = ce == "random" ? "Panel EGLS (Cross-section random effects)" : "Panel Least Squares"
    b.xlab = xlab
    b.coeff = $coeff[1:k]
    b.stderr = $stderr[1:k]
    b.vcv = $vcv[1:k, 1:k]
    b.k = k
    b.ktot = $ncoeff
    b.T = $T
    # some statistics are not defined for every estimator (random effects): NA then
    scalar df = $df
    catch scalar r2 = $rsq
    if $error
        r2 = NA
    endif
    catch scalar ssr = $ess
    if $error
        ssr = NA
    endif
    catch scalar se = $sigma
    if $error
        se = NA
    endif
    catch scalar lnl = $lnl
    if $error
        lnl = NA
    endif
    b.df = df
    series evp_u = $uhat
    series evp_f = $yhat
    series evp_o = obs
    list LL = evp_u evp_f evp_o
    matrix D = {LL}
    b.uhat = D[, 1]
    b.yhat = D[, 2]
    b.tobs = D[, 3]
    matrix yy = D[, 1] + D[, 2]
    if !ok(ssr)
        ssr = sumc(D[, 1].^2)
        se = sqrt(ssr / df)
    endif
    if !ok(r2)
        r2 = corr(yy, D[, 2])^2
    endif
    b.y = yy
    b.r2 = r2
    b.ssr = ssr
    b.se = se
    b.lnl = lnl
    b.r2adj = 1 - (1 - r2) * (b.T - 1) / df
    b.ymean = meanc(D[, 1] + D[, 2])
    b.ysd = sdc(D[, 1] + D[, 2])
    matrix u = D[, 1]
    b.dw = sumc((u[2:] - u[1:rows(u)-1]).^2) / sumc(u.^2)    # across the stacked rows
    # panel dimensions in the estimation sample
    series evp_un = $unit
    series evp_tt = $obsminor
    list L2 = evp_y X evp_un evp_tt
    matrix Z = {L2}
    b.ncross = rows(values(Z[, cols(Z) - 1]))
    b.nper = rows(values(Z[, cols(Z)]))
    b.balanced = b.T == b.ncross * b.nper
    b.tstat = b.coeff ./ b.stderr
    matrix pv = zeros(k, 1)
    loop i = 1..k
        pv[i] = 2 * pvalue(t, b.df, abs(b.tstat[i]))
    endloop
    b.pval = pv
    b.aic = -2 * b.lnl / b.T + 2 * b.ktot / b.T
    b.sc = -2 * b.lnl / b.T + b.ktot * log(b.T) / b.T
    b.estdate = strftime($now[1], "%m/%d/%y   Time: %H:%M")
    if !quiet
        ev_panelprint(&b)
    endif
    return b
end function

function void ev_panelprint (bundle *b)
    printf "\nDependent Variable: %s\nMethod: %s\nDate: %s\n", b.depvar, b.method, b.estdate
    printf "Periods included: %d\nCross-sections included: %d\n", b.nper, b.ncross
    printf "Total panel (%s) observations: %d\n\n", b.balanced ? "balanced" : "unbalanced", b.T
    ev__line(78)
    printf "%-26s%13s%13s%14s%12s\n", "Variable", "Coefficient", "Std. Error", "t-Statistic", "Prob."
    ev__line(78)
    loop i = 1..b.k
        printf "%-26s%13.6f%13.6f%14.6f%12.4f\n", b.xlab[i], b.coeff[i], b.stderr[i], b.tstat[i], b.pval[i]
    endloop
    ev__line(78)
    if b.effects != "none" || b.perfe
        printf "%38s\n", "Effects Specification"
        ev__line(78)
        if b.effects == "fixed"
            printf "Cross-section fixed (dummy variables)\n"
        elif b.effects == "random"
            printf "Cross-section random\n"
        endif
        if b.perfe
            printf "Period fixed (dummy variables)\n"
        endif
        ev__line(78)
    endif
    printf "%-22s%14.6f    %-24s%14.6f\n", "R-squared", b.r2, "Mean dependent var", b.ymean
    printf "%-22s%14.6f    %-24s%14.6f\n", "Adjusted R-squared", b.r2adj, "S.D. dependent var", b.ysd
    printf "%-22s%14.6f    %-24s%14.6f\n", "S.E. of regression", b.se, "Akaike info criterion", b.aic
    printf "%-22s%14.6f    %-24s%14.6f\n", "Sum squared resid", b.ssr, "Schwarz criterion", b.sc
    printf "%-22s%14.6f    %-24s%14.6f\n", "Log likelihood", b.lnl, "Durbin-Watson stat", b.dw
    ev__line(78)
end function

# -------------------------------------------------------------------
# pagestack: pool series x_? (one per unit) -> one stacked panel series
# -------------------------------------------------------------------

function strings ev_stackids (string pattern "Pool series name, e.g. gdp_?", list vars "Series (e.g. dataset)")
    # identifiers ? of the series that match the pattern, in workfile order
    errorif(!instring(pattern, "?"), "The pattern needs a ? for the identifier")
    strings p2 = strsplit(pattern, "?")
    string lead = nelem(p2) > 0 ? p2[1] : ""
    string tail = nelem(p2) > 1 ? p2[2] : ""
    scalar la = strlen(lead)
    scalar lt = strlen(tail)
    strings nm = varnames(vars)
    strings ids = array(0)
    loop i = 1..nelem(nm)
        string x = toupper(nm[i])
        scalar n = strlen(x)
        if n > la + lt
            if substr(x, 1, la) == toupper(lead) || la == 0
                if lt == 0 || substr(x, n - lt + 1, n) == toupper(tail)
                    ids += substr(nm[i], la + 1, n - lt)
                endif
            endif
        endif
    endloop
    errorif(nelem(ids) == 0, "No series match " ~ pattern)
    return ids
end function

function matrix ev_stack (string pattern "Pool series name, e.g. gdp_?", list vars "Series (e.g. dataset)",
                          strings ids[null] "Identifiers (default: those of ev_stackids)")
    # T x N matrix: column j holds the series for identifier j (NA where missing)
    strings u = exists(ids) ? ids : ev_stackids(pattern, vars)
    strings nm = varnames(vars)
    set skip_missing off
    matrix M = mshape(NA, $nobs, nelem(u))
    loop j = 1..nelem(u)
        string want = toupper(strsub(pattern, "?", u[j]))
        loop i = 1..nelem(nm)
            if toupper(nm[i]) == want
                series evs_x = vars[i]
                M[, j] = {evs_x}
                break
            endif
        endloop
    endloop
    return M
end function

# -------------------------------------------------------------------
# Panel helpers (pageunstack)
# -------------------------------------------------------------------

function matrix ev_unstack (series x "Series of a balanced panel")
    # T x N matrix: one column per cross-section unit
    errorif($datatype != 3, "The current page is not a panel (use pagestruct first)")
    scalar T = $pd
    scalar N = $nobs / T
    errorif(N != int(N), "The panel must be balanced")
    set skip_missing off
    return mshape({x}, T, N)
end function

function matrix ev_panelids (series id "Cross-section identifier")
    # value of the identifier for each unit, in panel order
    errorif($datatype != 3, "The current page is not a panel")
    set skip_missing off
    matrix v = {id}
    return v[seq(1, rows(v), $pd)]
end function

# -------------------------------------------------------------------
# GUI entry (Model menu) and bundle roles
# -------------------------------------------------------------------

# gretl's dialog limits each string field to 31 characters, so the
# equation can be split over three fields that are joined with spaces.
function bundle ev_ls_gui (string spec "Equation (EViews syntax)",
                           string spec2[null] "  ...continued (optional)",
                           string spec3[null] "  ...continued (optional)",
                           list vars "Series used in the equation",
                           int cov[1:3:1] "Coefficient covariance" {"Ordinary", "White", "HAC (Newey-West)"})
    # optional parts may arrive empty or as the literal text "null"
    string s = spec
    if exists(spec2) && strstrip(spec2) != "" && strstrip(spec2) != "null"
        s ~= " " ~ spec2
    endif
    if exists(spec3) && strstrip(spec3) != "" && strstrip(spec3) != "null"
        s ~= " " ~ spec3
    endif
    strings cv = defarray("ordinary", "white", "hac")
    bundle b = ev_ls(s, vars, cv[cov])    # prints the table into the result window
    return b
end function
