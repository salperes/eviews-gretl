# Phase 1: VAR AR roots, residual LM and normality tests, VAR forecasts
set verbose off
include gig.gfn
include ../EViewsCompat.inp
open ../../data/usmacro.gdt --quiet

function void check (string what, scalar a, scalar b, scalar tol[1e-6])
    if abs(a - b) > tol * (1 + abs(b)) || !ok(a)
        printf "FAIL  %-52s %.10g vs %.10g\n", what, a, b
    else
        printf "ok    %s\n", what
    endif
end function

series dc = ldiff(CONS)
series dg = ldiff(GDP)
smpl 1985:1 2015:4
bundle v = ev_varest("1 2 dc dg FFR", dataset, 1)
var 2 dc dg FFR --quiet
matrix ev = eigen($compan)
matrix md = sqrt(Re(ev).^2 + Im(ev).^2)
matrix R = ev_varroots(v)
check("V9 largest root modulus = gretl companion eigenvalue", R[1, 3], maxc(md))
check("V9 roots sorted by modulus", R[1, 3] >= R[rows(R), 3], 1)
matrix L = ev_varlm(v, 4)
check("V8 LM tests: 4 lags x 2 forms", rows(L), 8)
check("V8 LM df = n^2 for one lag", L[1, 4], 9)
bundle N = ev_varnorm(v)
check("V8 normality: joint JB = sum of components", N.jb_joint, sumc(N.jb))
# one-variable VAR: the Cholesky JB equals the univariate Jarque-Bera of the residuals
bundle v1 = ev_varest("1 2 dg", dataset, 1)
bundle N1 = ev_varnorm(v1, 1)
series r1 = ev_varresid(v1, 1)
normtest r1 --jbera --quiet
check("V8 univariate case = gretl normtest --jbera", N1.jb_joint, $test)
# one-variable VAR: the LM test is the Breusch-Godfrey T*R^2
matrix L1 = ev_varlm(v1, 1, 1)
ols dg const dg(-1) dg(-2) --quiet
series u = $uhat
series ul = misszero(u(-1))
ols u const dg(-1) dg(-2) ul --quiet
check("V8 one-variable LM = T*R2 of the BG regression", L1[1, 3], $T * $rsq, 1e-6)
# --- V10 forecasts against gretl fcast
smpl 1985:1 2015:4
var 2 dc dg FFR --quiet
fcast 2016:1 2019:4 --dynamic --quiet
matrix G = $fcast
matrix GS = $fcse
smpl 2016:1 2019:4
bundle f = ev_varfcast(v, dataset, 1, 1)
check("V10 dynamic forecast, variable 1, step 16 = gretl fcast", f.fcast[16, 1], G[16, 1])
check("V10 dynamic forecast, variable 3, step 4 = gretl fcast", f.fcast[4, 3], G[4, 3])
check("V10 forecast S.E., variable 2, step 8 = gretl fcast", f.se[8, 2], GS[8, 2], 1e-4)
bundle fs = ev_varfcast(v, dataset, 0, 1)
check("V10 static forecast step 1 = dynamic step 1", fs.fcast[1, 2], f.fcast[1, 2])
series dcf = ev_varfseries(f, 1)
check("V10 forecast series", dcf[2019:4], f.fcast[16, 1])
ev_varfcast(v, dataset)
