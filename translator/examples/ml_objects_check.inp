# Runs the translated ml_objects program and checks it against gretl's own estimators
set verbose off
run ml_objects.inp
function void check (string what, scalar a, scalar b, scalar tol[1e-6])
    if abs(a - b) > tol * (1 + abs(b)) || !ok(a)
        printf "FAIL  %-52s %.10g vs %.10g\n", what, a, b
    else
        printf "ok    %s\n", what
    endif
end function
ols DC const DG --quiet
check("logl: slope = OLS", LL1.coeff[2], $coeff[2], 1e-5)
check("logl: sigma = sqrt(SSR/T)", LL1.coeff[3], sqrt($ess / $T), 1e-4)
# independent signal and state errors (EViews default). Log GDP has a positive MA(1) in
# differences, which a local level cannot produce: the signal variance goes to zero and the
# model is a random walk, so its likelihood is that of ARIMA(0,1,0)
arima 0 1 0 ; LY --nc --quiet
check("sspace local level: likelihood = random walk (boundary)", SS1.lnl, $lnl, 1e-4)
check("sspace local level: signal variance at the boundary", exp(SS1.coeff[1]) < 1e-6, 1)
# the formatted graph (ml_objects_graph.png) is checked by looking at it
