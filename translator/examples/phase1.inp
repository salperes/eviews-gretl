# Translated from EViews by evprg2hansl.py
# Requires the EViewsCompat gretl package
set verbose off
include EViewsCompat.gfn
# workfile pages are kept as .gdtb files in gretl's dot directory (ev_pagedir)

# EViews program: Phase 1 of the gap analysis (docs/GAP_ANALIZI.md)
# TSLS, logit/probit, ARDL with bounds test, equation tests
open "../../data/usmacro.gdt"
scalar ev_N = $nobs
smpl full
smpl 1970:1 2019:4

# E6: two-stage least squares
bundle EIV = ev_tsls("dlog(CONS) c dlog(GDP) @ c FFR(-1) dlog(GDP(-1)) dlog(CONS(-1))", dataset)
ev_print(&EIV)

# E8: logit and probit of a growth indicator
series UP = ldiff(GDP) > 0.0075
bundle ELOG = ev_binary("UP c FFR dlog(CONS)", dataset, "logit")
bundle EPRO = ev_binary("UP c FFR dlog(CONS)", dataset, "probit")
ev_binaryprint(&ELOG)

# E15: ARDL with automatic lag selection and the bounds test
smpl full
smpl 1960:1 2019:4
bundle EARDL = ev_ardl("log(CONS) log(GDP)", dataset, 4, 4, "aic", "const")
ev_ardlprint(&EARDL)

# T4-T9: tests on a least squares equation
smpl full
smpl 1970:1 2019:4
bundle E1 = ev_ls("dlog(CONS) c dlog(GDP) FFR", dataset)
bundle E1_het = ev_hettest(E1, "bpg", 1)
bundle E1_het = ev_hettest(E1, "arch", 2)
bundle E1_het = ev_hettest(E1, "white", 1)
bundle E1_reset = ev_reset(E1, 1)
bundle E1_chow = ev_chow(E1, "1990:1", 0)
bundle E1_chow = ev_chow(E1, "2015:1", 1)
bundle E1_test = ev_testadd(E1, dataset, "dlog(CONS(-1))")
bundle E1_test = ev_testdrop(E1, "FFR")
bundle E1_rls = ev_rls(E1)
ev_rlsplot(E1_rls, "c")

# S4, G6, S10: Phillips-Perron, Engle-Granger, moving-average seasonal adjustment
smpl full
smpl 1960:1 2019:4
series LGDP = log(GDP)
series LCONS = log(CONS)
bundle LGDP_pp = ev_pp("LGDP", dataset, "ct", -1, 0)
list GC = LCONS LGDP
bundle GC_coint = ev_cointeg("LCONS LGDP", dataset, "eg", "c", -1, -1)
bundle GC_coint = ev_cointeg("LCONS LGDP", dataset, "po", "c", -1, -1)
smpl full
series CONS_SF = NA
series CONS_SA = ev_seasadj(CONS, "m", &CONS_SF)

# V8-V10: VAR stability, residual tests and forecasts
series DC = ldiff(CONS)
series DG = ldiff(GDP)
smpl full
smpl 1985:1 2015:4
bundle V1 = ev_varest("1 2 DC DG FFR @ c", dataset, 0, "dc dg ffr")
matrix V1_roots = ev_varroots(V1)
matrix V1_lm = ev_varlm(V1, 4)
bundle V1_norm = ev_varnorm(V1)
smpl full
smpl 2016:1 2019:4
bundle V1_fc = ev_varfcast(V1, dataset, 1)
series DC_f = ev_varfseries(V1_fc, 1)
series DG_f = ev_varfseries(V1_fc, 2)
series FFR_f = ev_varfseries(V1_fc, 3)

# W7, W8: an annual page with series converted from the quarterly page
string ev_pagedir = $dotdir
smpl full
store "@ev_pagedir/usmacro.gdtb"
nulldata 30 --preserve
setobs 1 1990 --time-series
scalar ev_N = $nobs
string ev_pagedir = $dotdir
scalar ev_s1 = $t1
scalar ev_s2 = $t2
smpl full
store "@ev_pagedir/annual.gdtb"
open "@ev_pagedir/usmacro.gdtb" --quiet --preserve
matrix ev_cv = ev_pagecol(GDP)
open "@ev_pagedir/annual.gdtb" --quiet --preserve
series GDP_AVG = ev_freqconv(ev_cv, "a")
smpl ev_s1 ev_s2
scalar ev_N = $nobs
string ev_pagedir = $dotdir
scalar ev_s1 = $t1
scalar ev_s2 = $t2
smpl full
store "@ev_pagedir/annual.gdtb"
open "@ev_pagedir/usmacro.gdtb" --quiet --preserve
matrix ev_cv = ev_pagecol(GDP)
open "@ev_pagedir/annual.gdtb" --quiet --preserve
series GDP_SUM = ev_freqconv(ev_cv, "s")
smpl ev_s1 ev_s2
scalar ev_N = $nobs
print GDP_AVG
print GDP_SUM
string ev_pagedir = $dotdir
smpl full
store "@ev_pagedir/annual.gdtb"
open "@ev_pagedir/usmacro.gdtb" --quiet --preserve
scalar ev_N = $nobs
list GC = LCONS LGDP
series GDP_COPY = GDP

# F4-F8: distributions, strings, logical helpers
scalar pv = 1 - cdf(t, 1000, 1.96)
string name = "gdp"
string label = toupper(name) ~ "_" ~ sprintf("%g", 2020)
series POS = ((ldiff(GDP) > 0) ? (1) : (0))
print pv

# O3, P8: a table object and exitloop
bundle TAB = ev_table(3, 2)
ev_tset(&TAB, 1, 1, "Variable")
ev_tset(&TAB, 1, 2, "Mean")
ev_tset(&TAB, 2, 1, label)
ev_tsetnum(&TAB, 2, 2, ev_mean(GDP))
ev_twidth(&TAB, 1, 14)
ev_tsave(TAB, "phase1_table.csv", "csv")
ev_tprint(TAB)
scalar n = 0
loop i = 1..10
    if i > 3
        break
    endif
    scalar n = n + 1
endloop
print n

